<local:OverlayPanelWindow x:Class="WaffleMeter.App.Wpf.CooldownOverlayPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="po"
        Title="스킬 쿨타임"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Width="Auto" Left="60" Top="300" FontFamily="Segoe UI">
    <!-- Square icons + a sweeping pie, deliberately unlike the buff overlay's circles + outline ring: the two
         windows sit side by side and answer different questions ("active on me" vs "ready to press").
         ResizeMode=NoResize keeps us clear of the SizeToContent trap entirely — WPF turns SizeToContent off the
         moment a resize STARTS, in any direction, so a resizable auto-sized window cannot keep its height. -->
    <local:OverlayPanelWindow.Resources>
        <!-- 슬롯 장식띠. 창 리소스라 30개 슬롯이 브러시 인스턴스 하나를 공유하고, po:Freeze 로 렌더 스레드가
             잠금 없이 읽는다 — 슬롯마다 브러시를 만들면 250ms 마다 그 개수만큼 다시 만들어진다.
             바깥 링은 배경과의 분리선, 안쪽 띠는 좌상단이 밝고 우하단이 어두운 사선 그라디언트라 아이콘이
             살짝 눌린 금속판처럼 읽힌다(게임 액션바 관례). 색을 알파로만 쓰므로 어떤 게임 화면 위에서도
             아이콘 색을 물들이지 않는다. -->
        <SolidColorBrush x:Key="CdRimOuter" Color="#B3000000" po:Freeze="True"/>
        <LinearGradientBrush x:Key="CdRimSheen" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
            <GradientStop Color="#66FFFFFF" Offset="0"/>
            <GradientStop Color="#1AFFFFFF" Offset="0.42"/>
            <GradientStop Color="#0DFFFFFF" Offset="0.58"/>
            <GradientStop Color="#59000000" Offset="1"/>
        </LinearGradientBrush>
    </local:OverlayPanelWindow.Resources>
    <Border Background="{Binding PanelBackground}" BorderBrush="{Binding PanelBorderBrush}"
            BorderThickness="{Binding PanelBorderThickness}" CornerRadius="8" MouseLeftButtonDown="OnDragHandle" Padding="2">
      <Grid Background="Transparent" MinWidth="60" MinHeight="20">
        <TextBlock Text="스킬 쿨타임 (캐릭터 인식 후 표시됩니다 · 드래그해서 이동)" Foreground="#CCFFFFFF" FontSize="11"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,4"
                   Visibility="{Binding EmptyVisibility}">
            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
                <!-- WrapPanel 은 창의 MaxWidth 가 있어야만 줄을 바꾼다(App.ReflowOverlay 가 '한 줄 최대 개수'
                     설정에서 매긴다). 상한이 없으면 SizeToContent 가 무한 폭으로 측정해 절대 줄바꿈하지 않고,
                     그러면 WPF 가 작업영역 폭에서 측정을 잘라 넘친 슬롯을 줄바꿈도 스크롤도 없이 버린다 —
                     로그에 흔적이 안 남는 무음 소실이다. 이 창은 슬롯이 20~30개까지 가므로 버프 오버레이보다
                     훨씬 낮은 배율에서 그 함정에 닿는다. MaxWidth 와 WrapPanel 은 반드시 짝으로 간다. -->
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ToolTip="{Binding Name}">
                        <Grid.LayoutTransform>
                            <!-- 슬롯 전체(아이콘·파이·글씨)에 걸리는 균일 배율. 간격도 이 안쪽 Margin 이라 함께
                                 따라간다 — 바깥에 주면 200%에서 아이콘만 커지고 간격은 그대로라 붙어 보인다. -->
                            <ScaleTransform ScaleX="{Binding DataContext.IconScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            ScaleY="{Binding DataContext.IconScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </Grid.LayoutTransform>
                        <!-- 셀 46 + 좌우 여백 1 = 슬롯 피치 48. ⚠️ App.ReflowCooldownOverlay 의 폭 상한
                             계산이 이 숫자를 그대로 쓴다 — 어긋나면 WrapPanel 이 창보다 넓게 재서 넘친 슬롯이
                             줄바꿈도 스크롤도 없이 사라진다. -->
                        <Grid Width="46" Height="46" Margin="1,1">
                            <!-- 아이콘 + 파이를 하나의 사각형으로 잘라 낸다. 꼭지점만 살짝(2px)
                                 둥글려 버프 오버레이의 원형 아이콘과 한눈에 갈린다. 파이 반지름은 모서리 너머까지
                                 뻗어 있고(대각 반지름 29.7 < 31), ClipToBounds 가 그걸 다시 이 모양으로 깎는다 —
                                 그래야 네 모서리가 밝게 남지 않는다. -->
                            <Border Width="42" Height="42" CornerRadius="2" ClipToBounds="True"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,42,42" RadiusX="2" RadiusY="2"/>
                                </Border.Clip>
                                <Grid>
                                    <!-- 원본 에셋이 48x48 이라 200%(84 DIP)에서는 확대가 된다 — 다른 오버레이와
                                         같이 보간을 HighQuality(Fant)로 지정한다. -->
                                    <Image Source="{Binding IconSource}" Stretch="Fill" Opacity="{Binding ReadyOpacity}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- 쿨 잔여 파이. 12시에서 시계방향으로, 남은 비율만큼 덮었다가 사라진다.
                                         색은 VM 이 고른다: 진함 = 못 누름, 옅음 = 충전형이 1회 이상 남은 채 재충전 중. -->
                                    <Path Data="{Binding Wipe}" Fill="{Binding WipeFill}" Width="42" Height="42" Stretch="None"/>
                                </Grid>
                            </Border>
                            <!-- 장식띠 2겹. 파이보다 위, 남은시간 글씨보다 아래. 바깥 링은 아이콘 밖 1px 에
                                 앉아 배경과 갈라 주고, 안쪽 띠는 아이콘 가장자리에 겹쳐 사선 광택을 준다. -->
                            <Border Width="44" Height="44" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{StaticResource CdRimOuter}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Width="42" Height="42" CornerRadius="2" BorderThickness="1"
                                    BorderBrush="{StaticResource CdRimSheen}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- 남은 시간. ⚠️ 파이보다 z-order 가 반드시 위다 — 반대로 두면 어두운 쐐기가 숫자를
                                 가로질러 읽을 수 없다(버프 오버레이가 링/배지에서 같은 실수를 한 적이 있다).
                                 DropShadowEffect 대신 알약 배경을 쓰는 이유는 비용이다: 슬롯당 그림자 효과는
                                 실측으로 프레임레이트를 16슬롯에서 24%, 32슬롯에서 17% 깎는다. -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#A6000000" CornerRadius="7" Padding="4,0" MinWidth="18"
                                    Visibility="{Binding TextVisibility}">
                                <TextBlock Text="{Binding RemainingText}"
                                           Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </Border>
                            <!-- 충전 횟수(충전형 스킬만). 아이콘 우하단 안쪽 — 가운데 남은 시간 알약과 겹치지 않는 자리다.
                                 맨 위 z-order 라 파이·장식띠에 가려지지 않는다. 그림자 효과 대신 알약 배경을 쓰는 이유는
                                 위 남은 시간과 같다(슬롯당 DropShadowEffect = 프레임레이트 비용). -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                                    Background="#A6000000" CornerRadius="3" Padding="3,0" MinWidth="11"
                                    Visibility="{Binding ChargeVisibility}">
                                <TextBlock Text="{Binding ChargeText}"
                                           Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
</local:OverlayPanelWindow>
