<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WaffleMeter.App.Wpf">
    <!--
        미터 루트 크롬. 본체 창과 분리모드의 두 창이 **같은 껍데기**를 쓰게 하려고 뽑았다.

        🔑 여기 있는 넷을 복제하지 않으면 분리 창만 다른 폰트·다른 배율·다른 배경으로 뜬다.
           ① 폰트   TextElement.FontFamily — 사용자 지정 글꼴이 자식 전부에 상속된다
           ② 배율   LayoutTransform ScaleTransform — 미터 크기(%) 설정
           ③ 배경   Skin.OverlayBgColor + MeterOpacity, 또는 계기판의 라디얼 스크림
           ④ 여백   레이아웃별 PanelPadding

        ⚠️ 투명도를 Window.Opacity 로 구현하지 마라. 0 에서 창이 클릭 불가가 되고 글자까지 사라진다 —
           MeterOpacity 는 **배경 브러시에만** 걸린다(OverlayWindow 주석의 오래된 경고).

        ⚠️ 배경 기본값을 Border.Background 속성으로 직접 쓰면 로컬 값이라 아래 트리거가 절대 못 이긴다.
           기본값도 Setter 로 내려야 한다(이 프로젝트에서 세 번 밟은 함정).
    -->
    <local:FontFamilyConverter x:Key="Chrome.FontConv"/>
    <local:PercentToScaleConverter x:Key="Chrome.PercentScale"/>

    <Style x:Key="MeterRootChrome" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="{Binding Layout.PanelPadding}"/>
        <Setter Property="TextElement.FontFamily"
                Value="{Binding Settings.FontFamily, Converter={StaticResource Chrome.FontConv}}"/>
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource Skin.OverlayBgColor}" Opacity="{Binding Settings.MeterOpacity}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="{Binding ScalePercent, Converter={StaticResource Chrome.PercentScale}}"
                                ScaleY="{Binding ScalePercent, Converter={StaticResource Chrome.PercentScale}}"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- 계기판: 불투명 판때기 대신 라디얼 스크림. 바깥이 완전히 투명해져 창 모양 자체가 사라진다. -->
            <DataTrigger Binding="{Binding Layout.ScrimPanel}" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <RadialGradientBrush Center="0.24,0.46" GradientOrigin="0.24,0.46"
                                             RadiusX="0.72" RadiusY="1.25"
                                             Opacity="{Binding Settings.MeterOpacity}">
                            <GradientStop Color="{DynamicResource Skin.ScrimCore}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Skin.ScrimEdge}" Offset="0.6"/>
                            <GradientStop Color="Transparent" Offset="0.86"/>
                        </RadialGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Layout.ShowPanelBackground}" Value="False"/>
                    <Condition Binding="{Binding Layout.ScrimPanel}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="Transparent"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        분리모드 보스칸의 컨트롤 버튼. 헤더의 HeaderIconButton 과 같은 모양이되, 계기판에서만 색을 올린다.
        계기판은 불투명 판 대신 라디얼 스크림이라 회색 글리프가 게임 화면에 그대로 묻힌다 — 판이 있는
        전장·무대는 지금 색으로도 읽히므로 건드리지 않는다.
        ⚠️ Foreground 를 Button 에 로컬 값으로 주면 이 트리거가 절대 못 이긴다. 기본값도 Setter 로 내린다.
    -->
    <Style x:Key="SplitHeaderButton" TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Layout.ScrimPanel}" Value="True">
                <Setter Property="Foreground" Value="#FFD400"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        브랜드 마크 — 앱 아이콘(와플)의 단색 선화. 물결 테두리 + 위아래로 엮인 대각 격자를 한 굵기·둥근 끝으로 그린다.
        인식 전 미터 본문(MeterRowsView 의 RecognitionWaitBlock)과, 직업을 아직 모를 때의 대기 카드(BossBarView 의
        직업 문장 자리, 같은 44 Viewbox)가 쓴다.
        🔑 100×100 캔버스 좌표다. 쓰는 쪽이 Viewbox(44×44) > Canvas 100×100 > Path 로 크기를 정한다 —
           Path.Stretch 로 키우면 굵기는 안 따라오고 기준 틀이 도형 외곽으로 바뀐다.
        🔑 굵기 5.5 는 44 DIP 에서 2.42px — 1x 에서 끊김(엇갈림 틈)이 뭉개지지 않는 하한이다. 끊긴 끝점은 교차점에서
           축마다 (8,8) 떨어져 있어 보이는 틈 = 11.3 − 굵기. 굵기와 끝점은 한 쌍이라 한쪽만 바꾸지 마라.
           40 DIP 이하로 줄여 쓸 거면 굵기를 6 으로 올려야 같은 선명도가 나온다.
        ⚠️ Fill 금지(열린 도형). Stroke 는 Skin.Fg — MutedFg 는 알파 68% 라 2px 틈의 대비를 깎는다.
        ⚠️ 돌리거나 움직이지 마라. 4방향 회전대칭이라 돌면 로딩 스피너로 읽히고, 유휴 CPU 도 0 이 아니게 된다.
    -->
    <Geometry x:Key="WaffleMark">M87.5,69 A16.5,16.5 0 0 1 69,87.5 A24.5,24.5 0 0 1 31,87.5 A16.5,16.5 0 0 1 12.5,69 A24.5,24.5 0 0 1 12.5,31 A16.5,16.5 0 0 1 31,12.5 A24.5,24.5 0 0 1 69,12.5 A16.5,16.5 0 0 1 87.5,31 A24.5,24.5 0 0 1 87.5,69 Z M87.5,69 L58,39.5 M42,23.5 L31,12.5 M31,87.5 L60.5,58 M76.5,42 L87.5,31 M12.5,31 L42,60.5 M58,76.5 L69,87.5 M69,12.5 L39.5,42 M23.5,58 L12.5,69</Geometry>
    <Style x:Key="WaffleMarkPath" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource WaffleMark}"/>
        <Setter Property="Stroke" Value="{DynamicResource Skin.Fg}"/>
        <Setter Property="StrokeThickness" Value="5.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
</ResourceDictionary>
