<Window x:Class="WaffleMeter.App.Wpf.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
        Title="상세내역"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResize"
        Width="1140" Height="640" MinWidth="860" MinHeight="360" Left="340" Top="40" FontFamily="Segoe UI">
    <Window.Resources>
        <local:RatioToStarConverter x:Key="RatioToStar"/>
        <local:FontFamilyConverter x:Key="FontConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Value accents (fixed across skins — they carry meaning, not chrome): cyan reads "output",
             magenta marks 강타. Mirrors the stats site's table so the two read the same at a glance. -->
        <SolidColorBrush x:Key="ValueCyan" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="ValueMagenta" Color="#F472B6"/>

        <!-- Damage-share fill behind a skill row. It fades to nothing rather than ending on an edge, so it reads
             as a heat cue instead of a selection box — the site spends a whole column on 비중 instead. -->
        <LinearGradientBrush x:Key="ShareFill" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#802DD4BF" Offset="0"/>
            <GradientStop Color="#4D2DD4BF" Offset="0.5"/>
            <GradientStop Color="#002DD4BF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gauge gloss: a soft top-light + bottom shade over the fill, so the bar reads as a lit surface
             instead of a flat painted rectangle. -->
        <LinearGradientBrush x:Key="BarGloss" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4DFFFFFF" Offset="0"/>
            <GradientStop Color="#12FFFFFF" Offset="0.5"/>
            <GradientStop Color="#1A000000" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Stat" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Skin.Fg}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- Table header cell -->
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Table numeric cell: right-aligned like the stats site, so digits line up column-wise. -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Skin.Fg}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellBold" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SumLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="SumValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Skin.Fg}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15.5"/>
        </Style>
        <Style x:Key="SumTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Skin.RowBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="11,8"/>
        </Style>

        <!-- Tab strip: pill buttons instead of the classic tab headers (stats-site look). -->
        <Style x:Key="PillTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pill" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="p" CornerRadius="6" Margin="0,0,7,0" Padding="13,7"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter x:Name="c" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource Skin.MutedFg}"
                                              TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="p" Property="Background" Value="{DynamicResource Skin.RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="p" Property="Background" Value="{DynamicResource Skin.TabSelectedBg}"/>
                                <Setter TargetName="p" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                <Setter TargetName="c" Property="TextElement.Foreground" Value="{DynamicResource Skin.Fg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Skill-chain expand toggle: bordered +/- box (control-bg, accent glyph). -->
        <Style x:Key="ChainToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="4" Background="{DynamicResource Skin.ControlBg}"
                                BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1">
                            <TextBlock x:Name="g" Text="+" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Skin.Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="g" Property="Text" Value="&#x2212;"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.RowHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 표 위의 표시 옵션 체크박스. 이 창은 설정창과 달리 Skin.Controls.xaml 을 일부러 병합하지 않으므로
             (SkinManager.cs: 오버레이/상세/색선택기는 각자의 손그림 룩을 유지한다는 결정) 여기서 직접 그린다.
             ⚠️ "정리" 삼아 Skin.Controls.xaml 병합으로 바꾸지 말 것 — 그건 문서화된 결정을 뒤집는 일이다. -->
        <Style x:Key="DetailCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="b" Width="15" Height="15" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource Skin.ControlBg}"
                                    BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1">
                                <TextBlock x:Name="g" Text="&#x2713;" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Skin.Accent}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter x:Name="c" Margin="7,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="g" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                <Setter TargetName="c" Property="TextElement.Foreground" Value="{DynamicResource Skin.Fg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.RowHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 특화 (specialization) pips: five dots per skill, active slots lit. Bound to a list of SpecPipVM. -->
        <ItemsPanelTemplate x:Key="SpecPipPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="SpecPipTemplate">
            <Ellipse Width="7" Height="7" Margin="1.5,0" Fill="{Binding Fill}"/>
        </DataTemplate>

        <!-- 직접/지속 badge -->
        <Style x:Key="TypeBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Buff/debuff uptime table. Bound to a flat list of BuffRowVM; each row carries its section
             ("내 버프" / "그 외") as a subtitle — or, for a 「남이 준 버프」 row, that buff's caster. -->
        <DataTemplate x:Key="UptimeTable">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Border Background="{DynamicResource Skin.TableHeadBg}" CornerRadius="5" Margin="0,0,0,5">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="이름" Style="{StaticResource Head}" TextAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="가동률" Style="{StaticResource Head}"/>
                    </Grid>
                </Border>
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="10,6" Margin="0,1" Background="{DynamicResource Skin.RowBg}"
                                        ToolTip="{Binding Description}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding IconSource}" Width="24" Height="24" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Skin.Fg}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <!-- 시전자의 스킬 레벨. 시너지 버프는 효과량이 레벨 선형이라
                                                         가동률만으로는 기여를 읽을 수 없어 함께 보여준다. -->
                                                    <Border Visibility="{Binding LevelVisibility}" Margin="6,0,0,0" Padding="4,0"
                                                            CornerRadius="3" VerticalAlignment="Center"
                                                            Background="{DynamicResource Skin.StatBg}"
                                                            BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1">
                                                        <TextBlock Text="{Binding LevelText}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Skin.MutedFg}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" Visibility="{Binding SubtitleVisibility}"
                                                           Foreground="{DynamicResource Skin.MutedFg}" FontSize="10.5" Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Inset track + gradient fill under a gloss, so the gauge reads as a lit bar. -->
                                        <Grid Grid.Column="1" Height="11" VerticalAlignment="Center" Margin="12,0">
                                            <Border Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                                    BorderThickness="1" CornerRadius="5.5"/>
                                            <Grid Margin="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarRatio, Converter={StaticResource RatioToStar}}"/>
                                                    <ColumnDefinition Width="{Binding BarRest, Converter={StaticResource RatioToStar}}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{Binding BarBrush}" CornerRadius="4.5">
                                                    <Border CornerRadius="4.5" Background="{StaticResource BarGloss}"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding RateText}" Style="{StaticResource CellBold}" Foreground="{Binding RateBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
              </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource Skin.PanelBg}" CornerRadius="8" Padding="12"
            TextElement.FontFamily="{Binding FontFamily, Converter={StaticResource FontConv}}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" MouseLeftButtonDown="OnDragHandle" Background="Transparent" Margin="0,0,0,10">
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Skin.Fg}" FontWeight="Bold" FontSize="14"/>
                <Button Content="&#xE8BB;" Click="OnClose" HorizontalAlignment="Right" Style="{StaticResource HeaderCloseButton}"/>
            </Grid>

            <!-- Stat tiles: label above value. 7 per row since nDPS/rDPS joined — 13 tiles in 6 columns would
                 spill a single tile onto a third row. -->
            <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,10">
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="총 피해" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding TotalDamageText}" Style="{StaticResource SumValue}" Foreground="{Binding AmountBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="DPS" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding DpsText}" Style="{StaticResource SumValue}" Foreground="{StaticResource ValueCyan}"/></StackPanel></Border>
                <!-- nDPS/rDPS: 계산이 안 된 전투에서는 값이 "-" 로 떨어진다(0을 그리면 "버프를 하나도 못 받았다"로
                     읽힌다). 타일 자체는 자리를 지켜 레이아웃이 튀지 않게 둔다. -->
                <Border Style="{StaticResource SumTile}" ToolTip="남이 걸어준 버프 몫을 걷어낸 초당 피해량. 내가 스스로 건 버프는 그대로 남습니다.">
                    <StackPanel><TextBlock Text="nDPS" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding NdpsText}" Style="{StaticResource SumValue}" Foreground="{StaticResource ValueCyan}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}" ToolTip="nDPS + 내가 파티에 얹어준 몫(버프 배수 + 흡혈의 검·대지의 축복처럼 실제로 남의 미터에 들어간 피해).">
                    <StackPanel><TextBlock Text="rDPS" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding RdpsText}" Style="{StaticResource SumValue}" Foreground="{StaticResource ValueCyan}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="기여도" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding ContributionText}" Style="{StaticResource SumValue}" Foreground="{Binding ContributionBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="타수" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding HitsText}" Style="{StaticResource SumValue}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="전투시간" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding CombatTimeText}" Style="{StaticResource SumValue}" Foreground="{Binding DetailCombatTimeBrush}"/></StackPanel></Border>

                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="치명" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding CritText}" Style="{StaticResource SumValue}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="강타" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding StrongText}" Style="{StaticResource SumValue}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="완벽" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding PerfectText}" Style="{StaticResource SumValue}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="후방" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding BackText}" Style="{StaticResource SumValue}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="전방" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding FrontText}" Style="{StaticResource SumValue}"/></StackPanel></Border>
                <Border Style="{StaticResource SumTile}"><StackPanel><TextBlock Text="막기" Style="{StaticResource SumLabel}"/><TextBlock Text="{Binding ParryText}" Style="{StaticResource SumValue}"/></StackPanel></Border>

                <!-- 티어 타일. 13개였던 격자의 빈 14번째 칸을 채우므로 레이아웃이 흔들리지 않는다.
                     🔑 이 타일의 존재 이유는 세 번째 줄(비교 기준)이다 — 미터 행은 폭 490px 에 두 번째 줄을
                     놓을 자리가 없어 파티원의 "상위 X.X%" 가 전체 기준인지 그 사람의 전투력 구간 기준인지가
                     툴팁에만 있다. 각 행은 자기 전투력으로 밴드가 매겨지므로 파티원은 나와 다른 풀과 비교될
                     수 있고, 그러면 같은 백분위가 다른 뜻이 된다.
                     등급과 백분위를 한 줄로 합치지 않는 것도 폭 때문이다: 최소 창폭 860 에서 타일 실사용
                     폭이 ~95px 이라 "챌린저 · 상위 0.7%" 는 실측으로 잘린다. SumValue(15.5 Bold)도 같은 이유로
                     쓰지 않는다. -->
                <Border Style="{StaticResource SumTile}" Visibility="{Binding TierVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding TierLabelText}" Style="{StaticResource SumLabel}"/>
                        <TextBlock Text="{Binding TierRankText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Skin.Fg}"/>
                        <TextBlock Text="{Binding TierPercentText}" Visibility="{Binding TierPercentVisibility}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ValueCyan}"/>
                        <TextBlock Text="{Binding TierBasisText}" Visibility="{Binding TierBasisVisibility}"
                                   FontSize="9.5" Opacity="0.75" Margin="0,1,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Skin.Fg}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 버프 주고받은 몫 한 줄 요약. rDPS 타일이 "얼마"라면 이 줄은 "어디서 왔나"다. -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding BuffContributionText}" Visibility="{Binding BuffContributionVisibility}"
                       Foreground="{DynamicResource Skin.MutedFg}" FontSize="11.5" Margin="2,0,0,10" TextWrapping="Wrap"/>

            <Grid>
                <TextBlock Text="이 전투에는 표시할 데이터가 없어요." Visibility="{Binding NoDataVisibility}"
                           Foreground="{DynamicResource Skin.MutedFg}" FontSize="13" Panel.ZIndex="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

                <TabControl x:Name="Tabs" Style="{StaticResource PillTabs}">
                    <!-- ══════════════ 스킬 ══════════════ -->
                    <TabItem Style="{StaticResource Pill}">
                        <TabItem.Header>스킬</TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                          <StackPanel>
                            <Border Background="{DynamicResource Skin.TableHeadBg}" CornerRadius="5" Margin="0,0,0,5">
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="스킬" Style="{StaticResource Head}" TextAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="유형" Style="{StaticResource Head}" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="타수" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="3" Text="치명" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="4" Text="강타" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="5" Text="완벽" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="6" Text="후방" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="7" Text="전방" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="8" Text="패리" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="9" Text="특화" Style="{StaticResource Head}" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="10" Text="DPS" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="11" Text="평균" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="12" Text="누적" Style="{StaticResource Head}"/>
                                    <TextBlock Grid.Column="13" Text="비중" Style="{StaticResource Head}"/>
                                </Grid>
                            </Border>
                                <ItemsControl ItemsSource="{Binding Skills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,1">
                                                <!-- The row's damage share is a faint fill behind it, so ranking reads
                                                     without spending a column on a bar (as the stats site does). -->
                                                <Border CornerRadius="5" Background="{DynamicResource Skin.RowBg}" ClipToBounds="True">
                                                    <Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Merged.BarRatio, Converter={StaticResource RatioToStar}}"/>
                                                                <ColumnDefinition Width="{Binding Merged.BarRest, Converter={StaticResource RatioToStar}}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{StaticResource ShareFill}"/>
                                                        </Grid>
                                                        <Grid Margin="10,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="52"/>
                                                                <ColumnDefinition Width="58"/>
                                                                <ColumnDefinition Width="58"/>
                                                                <ColumnDefinition Width="58"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="54"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="66"/>
                                                                <ColumnDefinition Width="66"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="58"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Grid Width="22" Margin="0,0,4,0">
                                                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                  Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                                                                  Style="{StaticResource ChainToggle}"/>
                                                                </Grid>
                                                                <Image Source="{Binding Merged.IconSource}" Width="24" Height="24" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Merged.Name}" Foreground="{DynamicResource Skin.Fg}" FontSize="13" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <!-- 남이 만들어 준 피해(흡혈의 검 착취 / 대지의 축복 추가 피해)에 시전자 이름표.
                                                                     없으면 "내가 안 배운 직업 스킬이 내 목록에 있다"로 읽힌다. -->
                                                                <Border Visibility="{Binding Merged.GrantedByVisibility}" Margin="6,0,0,0" Padding="5,0"
                                                                        CornerRadius="3" VerticalAlignment="Center"
                                                                        Background="{DynamicResource Skin.StatBg}"
                                                                        BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1">
                                                                    <TextBlock Text="{Binding Merged.GrantedByText}" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{DynamicResource Skin.MutedFg}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Style="{StaticResource TypeBadge}">
                                                                <TextBlock Text="{Binding Merged.TypeText}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10.5"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Merged.HitsText}" Style="{StaticResource Cell}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Merged.CritText}" Style="{StaticResource CellBold}" Foreground="{StaticResource ValueCyan}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Merged.StrongText}" Style="{StaticResource CellBold}" Foreground="{StaticResource ValueMagenta}"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding Merged.PerfectText}" Style="{StaticResource Cell}"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding Merged.BackText}" Style="{StaticResource Cell}"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding Merged.FrontText}" Style="{StaticResource Cell}"/>
                                                            <TextBlock Grid.Column="8" Text="{Binding Merged.ParryText}" Style="{StaticResource Cell}"/>
                                                            <Grid Grid.Column="9">
                                                                <ItemsControl ItemsSource="{Binding Merged.Spec}" Visibility="{Binding Merged.SpecVisibility}"
                                                                              ItemsPanel="{StaticResource SpecPipPanel}" ItemTemplate="{StaticResource SpecPipTemplate}"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Text="-" Style="{StaticResource Cell}" TextAlignment="Center" Visibility="{Binding Merged.NoSpecVisibility}"/>
                                                            </Grid>
                                                            <TextBlock Grid.Column="10" Text="{Binding Merged.DpsText}" Style="{StaticResource Cell}"/>
                                                            <TextBlock Grid.Column="11" Text="{Binding Merged.AvgText}" Style="{StaticResource Cell}"/>
                                                            <TextBlock Grid.Column="12" Text="{Binding Merged.DamageText}" Style="{StaticResource CellBold}" Foreground="{StaticResource ValueCyan}"/>
                                                            <TextBlock Grid.Column="13" Text="{Binding Merged.PercentText}" Style="{StaticResource CellBold}" Foreground="{StaticResource ValueCyan}"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <!-- chain children: indented, accent left rail -->
                                                <ItemsControl ItemsSource="{Binding Children}" Margin="0,1,0,0"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="5" Padding="10,4" Margin="26,1,0,0" BorderThickness="2,0,0,0"
                                                                    BorderBrush="{DynamicResource Skin.Accent}" Background="{DynamicResource Skin.RowHover}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" MinWidth="124"/>
                                                                        <ColumnDefinition Width="56"/>
                                                                        <ColumnDefinition Width="52"/>
                                                                        <ColumnDefinition Width="58"/>
                                                                        <ColumnDefinition Width="58"/>
                                                                        <ColumnDefinition Width="58"/>
                                                                        <ColumnDefinition Width="56"/>
                                                                        <ColumnDefinition Width="56"/>
                                                                        <ColumnDefinition Width="54"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="66"/>
                                                                        <ColumnDefinition Width="66"/>
                                                                        <ColumnDefinition Width="72"/>
                                                                        <ColumnDefinition Width="58"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Image Source="{Binding IconSource}" Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="12.5"
                                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1" Style="{StaticResource TypeBadge}">
                                                                        <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Text="{Binding HitsText}" Style="{StaticResource Cell}" FontSize="12"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding CritText}" Style="{StaticResource Cell}" FontSize="12" Foreground="{StaticResource ValueCyan}"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding StrongText}" Style="{StaticResource Cell}" FontSize="12" Foreground="{StaticResource ValueMagenta}"/>
                                                                    <TextBlock Grid.Column="5" Text="{Binding PerfectText}" Style="{StaticResource Cell}" FontSize="12"/>
                                                                    <TextBlock Grid.Column="6" Text="{Binding BackText}" Style="{StaticResource Cell}" FontSize="12"/>
                                                                    <TextBlock Grid.Column="7" Text="{Binding FrontText}" Style="{StaticResource Cell}" FontSize="12"/>
                                                                    <TextBlock Grid.Column="8" Text="{Binding ParryText}" Style="{StaticResource Cell}" FontSize="12"/>
                                                                    <Grid Grid.Column="9">
                                                                        <ItemsControl ItemsSource="{Binding Spec}" Visibility="{Binding SpecVisibility}"
                                                                                      ItemsPanel="{StaticResource SpecPipPanel}" ItemTemplate="{StaticResource SpecPipTemplate}"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="-" Style="{StaticResource Cell}" FontSize="12" TextAlignment="Center" Visibility="{Binding NoSpecVisibility}"/>
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="10" Text="{Binding DpsText}" Style="{StaticResource Cell}" FontSize="12"/>
                                                                    <TextBlock Grid.Column="11" Text="{Binding AvgText}" Style="{StaticResource Cell}" FontSize="12"/>
                                                                    <TextBlock Grid.Column="12" Text="{Binding DamageText}" Style="{StaticResource Cell}" FontSize="12" Foreground="{StaticResource ValueCyan}"/>
                                                                    <TextBlock Grid.Column="13" Text="{Binding PercentText}" Style="{StaticResource Cell}" FontSize="12" Foreground="{StaticResource ValueCyan}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                          </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══════════════ 버프 업타임 ══════════════ -->
                    <TabItem Style="{StaticResource Pill}" IsEnabled="{Binding HasBuffs}">
                        <TabItem.Header>버프 업타임</TabItem.Header>
                        <DockPanel>
                            <!-- 남이 걸어 준 버프는 기본적으로 접혀 있다. 이 체크박스가 그 섹션을 표 맨 뒤에
                                 붙였다 뗐다 한다(설정에 저장돼 다음에 연 상세창에도 이어진다).
                                 남이 준 버프가 하나도 없는 전투(솔로)에서는 통째로 감춘다. -->
                            <CheckBox DockPanel.Dock="Top" Style="{StaticResource DetailCheck}"
                                      Margin="2,0,0,8" Content="남이 준 버프도 보기"
                                      IsChecked="{Binding ShowPartyBuffs, Mode=TwoWay}"
                                      Visibility="{Binding HasPartyBuffs, Converter={StaticResource BoolToVis}}"/>
                            <ContentControl Content="{Binding Buffs}" ContentTemplate="{StaticResource UptimeTable}"/>
                        </DockPanel>
                    </TabItem>

                    <!-- ══════════════ 디버프 업타임 ══════════════ -->
                    <TabItem Style="{StaticResource Pill}" IsEnabled="{Binding HasDebuffs}">
                        <TabItem.Header>디버프 업타임</TabItem.Header>
                        <ContentControl Content="{Binding Debuffs}" ContentTemplate="{StaticResource UptimeTable}"/>
                    </TabItem>

                    <!-- ══════════════ DPS 그래프 ══════════════ -->
                    <TabItem Style="{StaticResource Pill}" IsEnabled="{Binding HasGraph}">
                        <TabItem.Header>DPS 그래프</TabItem.Header>
                        <DockPanel>
                            <!-- Legend: color chip + icon + name for each buff lane, so the coloured bands below
                                 are identifiable (matches the lane order/color drawn on the Canvas). -->
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Graph.Buffs}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,8,4" Padding="5,2" CornerRadius="4"
                                                Background="{DynamicResource Skin.RowBg}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="10" Height="10" CornerRadius="2"
                                                        Background="{Binding LaneBrush}" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Icon}" Width="15" Height="15"
                                                       Margin="5,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Skin.Fg}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Hand-drawn on a plain Canvas (software render, no external chart lib) — the
                                 ReplayWindow map is the approved precedent. Children built in code-behind. -->
                            <Border Background="{DynamicResource Skin.StatBg}" CornerRadius="6" MinHeight="210"
                                    BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1" ClipToBounds="True">
                                <Canvas x:Name="GraphCanvas" Background="Transparent" ClipToBounds="True"/>
                            </Border>
                        </DockPanel>
                    </TabItem>


                    <!-- ══════════════ 스킬 타임라인 ══════════════ -->
                    <TabItem Style="{StaticResource Pill}" IsEnabled="{Binding HasTimeline}">
                        <TabItem.Header>스킬 타임라인</TabItem.Header>
                        <DockPanel>
                            <!-- 같은 스킬의 연속 사용 간격이 이 탭의 본론이다. 위의 전역 수치는 입력 밀도이지
                                 "얼마나 자주 눌렀나"가 아니다 — 연계 스킬이 같은 ms 에 함께 나가기 때문이다. -->
                            <TextBlock DockPanel.Dock="Top" Text="{Binding TimelineSummaryText}"
                                       Foreground="{DynamicResource Skin.MutedFg}" FontSize="11.5"
                                       Margin="2,0,0,5" TextWrapping="Wrap"/>

                            <!-- 점이 무엇인지 그 자리에서 말해 준다. 표식만 있고 설명이 없으면 읽을 수 없다. -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,8">
                                <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                         Fill="{StaticResource ValueMagenta}"/>
                                <TextBlock Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Skin.MutedFg}"
                                           Text="= 쿨타임을 돌린 발동 (확실히 나간 시전). 점이 없다고 안 나간 건 아닙니다 — 쿨타임이 없는 스킬은 돌릴 쿨이 없습니다."/>
                                <!-- 일부 스킬은 활성화 1회에 프레임을 둘 낸다(시전→적중으로 보이는 350ms 짝).
                                     그걸 시간으로 접으면 임의의 임계값이 필요하고, 그 값이 매크로 케이던스를
                                     지운다. 대신 서버가 준 사실 하나로 거르는 렌즈를 준다. -->
                                <CheckBox Style="{StaticResource DetailCheck}" Margin="14,0,0,0"
                                          Content="쿨 시작만 보기"
                                          IsChecked="{Binding TimelineCooldownOnly, Mode=TwoWay}"
                                          Visibility="{Binding HasCooldownStarts, Converter={StaticResource BoolToVis}}"
                                          ToolTip="쿨타임을 돌린 발동만 남깁니다. 한 번 눌렀는데 프레임이 둘 오는 스킬을 걸러내는 데 씁니다. ⚠️ 쿨타임이 없는 스킬(속사·저격 등)은 통째로 사라집니다."/>
                            </StackPanel>
                            <Grid>
                                <!-- 오른쪽(시전 순서)은 고정폭, 왼쪽(집계)이 남는 폭을 다 가져간다.
                                     창을 좁혀도 왼쪽의 최소/최대 칸이 잘리지 않을 만큼만 남긴다. -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="462"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="344"/>
                                </Grid.ColumnDefinitions>

                                <!-- 왼쪽: 스킬별 사용 간격 집계 -->
                                <DockPanel Grid.Column="0">
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource Skin.TableHeadBg}"
                                            CornerRadius="5" Margin="0,0,0,5">
                                        <Grid Margin="10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="110"/>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="64"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="스킬" Style="{StaticResource Head}" TextAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="횟수" Style="{StaticResource Head}"/>
                                            <TextBlock Grid.Column="2" Text="쿨" Style="{StaticResource Head}"
                                                       ToolTip="그중 쿨타임을 실제로 돌린 발동 수. 서버가 보낸 사실이라 &quot;확실히 나갔다&quot;로 읽어도 됩니다. 쿨타임이 없는 스킬은 돌릴 쿨이 없어 &quot;-&quot; 로 남습니다."/>
                                            <TextBlock Grid.Column="3" Text="평균" Style="{StaticResource Head}"/>
                                            <TextBlock Grid.Column="4" Text="중앙값" Style="{StaticResource Head}"/>
                                            <TextBlock Grid.Column="5" Text="최소" Style="{StaticResource Head}"/>
                                            <TextBlock Grid.Column="6" Text="최대" Style="{StaticResource Head}"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding TimelineSkills}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="5" Padding="10,6" Margin="0,1"
                                                            Background="{DynamicResource Skin.RowBg}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="110"/>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="64"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image Source="{Binding IconSource}" Width="22" Height="22"
                                                                       Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Skin.Fg}"
                                                                           FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Cell}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding CooldownCountText}" Style="{StaticResource CellBold}"
                                                                       Foreground="{StaticResource ValueMagenta}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding MeanText}" Style="{StaticResource CellBold}"
                                                                       Foreground="{StaticResource ValueCyan}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding MedianText}" Style="{StaticResource Cell}"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding MinText}" Style="{StaticResource Cell}"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding MaxText}" Style="{StaticResource Cell}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>

                                <!-- 오른쪽: 시전 순서와 그 사이 간격. 긴 전투는 수천 줄이라 가상화한다. -->
                                <DockPanel Grid.Column="2">
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource Skin.TableHeadBg}"
                                            CornerRadius="5" Margin="0,0,0,5">
                                        <Grid Margin="10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*" MinWidth="110"/>
                                                <ColumnDefinition Width="78"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="시각" Style="{StaticResource Head}" TextAlignment="Left"/>
                                            <TextBlock Grid.Column="2" Text="스킬" Style="{StaticResource Head}" TextAlignment="Left"/>
                                            <TextBlock Grid.Column="3" Text="직전 간격" Style="{StaticResource Head}"/>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding TimelineCasts}"
                                                  VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="5" Padding="10,4" Margin="0,1"
                                                        Background="{DynamicResource Skin.RowBg}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="14"/>
                                                            <ColumnDefinition Width="56"/>
                                                            <ColumnDefinition Width="*" MinWidth="110"/>
                                                            <ColumnDefinition Width="78"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 쿨타임을 돌린 발동에만 붙는 점. 서버가 보낸 사실이지 우리 판정이 아니다. -->
                                                        <Ellipse Grid.Column="0" Width="5" Height="5" VerticalAlignment="Center"
                                                                 HorizontalAlignment="Left" Fill="{StaticResource ValueMagenta}"
                                                                 Visibility="{Binding CooldownMarkVisibility}"
                                                                 ToolTip="이 발동이 쿨타임을 돌렸습니다 (확실히 나간 시전)"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource Cell}"
                                                                   TextAlignment="Left" FontSize="12"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="{Binding IconSource}" Width="18" Height="18"
                                                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Skin.Fg}"
                                                                       FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding GapText}" Style="{StaticResource Cell}"
                                                                   FontSize="12"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                </TabControl>
            </Grid>
        </DockPanel>
    </Border>
</Window>
