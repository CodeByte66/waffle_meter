<Window x:Class="WaffleMeter.App.Wpf.FieldBossPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="필드보스 알림 선택" Width="640" Height="620" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{DynamicResource Skin.WindowBg}" Foreground="{DynamicResource Skin.Fg}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WaffleMeter.App.Wpf;component/Themes/Skin.Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
                <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Skin.Fg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Region tab strip: pill headers, matching the detail window's look. -->
            <Style x:Key="PillTabs" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Pill" TargetType="TabItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="p" CornerRadius="6" Margin="0,0,7,0" Padding="12,6"
                                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter x:Name="c" ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource Skin.MutedFg}"
                                                  TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="p" Property="Background" Value="{DynamicResource Skin.RowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="p" Property="Background" Value="{DynamicResource Skin.TabSelectedBg}"/>
                                    <Setter TargetName="p" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                    <Setter TargetName="c" Property="TextElement.Foreground" Value="{DynamicResource Skin.Fg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16,14">
        <TextBlock DockPanel.Dock="Top" Text="알림을 받을 필드보스를 선택하세요."
                   Foreground="{DynamicResource Skin.Fg}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource Skin.MutedFg}" FontSize="11"
                   Text="체크된 보스만 리스폰 알림을 표시합니다. 리젠 시간은 지금 있는 지역의 월드맵(M)을 열 때 인식되므로, 알림도 그 지역에 있을 때 울립니다. 수·토 아티쟁 보스는 그 서버의 아티쟁 시각을 알고 있으면, 정령왕 아그로는 고정 출현 시각에 맞춰 지역과 무관하게 울립니다."/>

        <Button DockPanel.Dock="Bottom" Content="닫기" HorizontalAlignment="Right" MinWidth="82" Margin="0,12,0,0"
                Click="OnClose"/>

        <TabControl ItemsSource="{Binding Groups}" Style="{StaticResource PillTabs}"
                    ItemContainerStyle="{StaticResource Pill}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                            <Button Content="전체 켜기" Style="{StaticResource ChipButton}" Tag="{Binding}" Click="OnEnableAll"/>
                            <Button Content="전체 끄기" Style="{StaticResource ChipButton}" Tag="{Binding}" Click="OnDisableAll"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Alerted, Mode=TwoWay}" Margin="2,5,10,5" Padding="0"
                                                  Foreground="{DynamicResource Skin.Fg}" FontSize="12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="8"
                                                        Background="{DynamicResource Skin.StatBg}"
                                                        Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Schedule}" FontSize="10"
                                                               Foreground="{DynamicResource Skin.MutedFg}"/>
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
