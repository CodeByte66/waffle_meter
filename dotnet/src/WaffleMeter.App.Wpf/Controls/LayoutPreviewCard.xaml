<UserControl x:Class="WaffleMeter.App.Wpf.Controls.LayoutPreviewCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaffleMeter.App.Wpf.Controls">
    <!--
        레이아웃 미리보기. DataContext 는 SettingsViewModel.LayoutPreview (preview 모드 OverlayViewModel).

        🔑 **진짜 컨트롤**을 쓴다 — BossBarView·MeterRowsView·CombatTimerBar 그대로. 설정창용으로 따로
           그린 그림은 레이아웃 수치를 손볼 때마다 실물과 어긋나는데, 어긋난 걸 알아챌 방법이 없다.
           여기 붙은 세 컨트롤이 곧 미터 본체가 붙이는 세 컨트롤이라 드리프트가 구조적으로 불가능하다.

        🔑 Viewbox 로 감싸는 이유가 둘이다.
           ① 미터 크기(%) 설정이 MeterRootChrome 의 LayoutTransform 으로 들어와 있어서, 150% 를 쓰는
              사용자는 미리보기가 상자를 뚫고 나간다. Viewbox 가 그걸 도로 담아낸다.
           ② 폭을 460 으로 고정해 세 레이아웃을 **같은 조건**에서 비교하게 한다. 사용자의 실제 미터 폭을
              따라가면 좁은 폭에서 잘린 모습이 레이아웃 탓으로 읽힌다.

        ⚠️ 바깥 Border 에 Background 를 로컬 값으로 주지 마라 — MeterRootChrome 의 Setter(와 계기판
           스크림 트리거)를 로컬 값이 무조건 이겨서 판때기가 통째로 사라진다.
    -->
    <Border CornerRadius="6" Padding="10" SnapsToDevicePixels="True"
            Background="{DynamicResource Skin.TableHeadBg}"
            BorderBrush="{DynamicResource Skin.Border}" BorderThickness="1">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" MaxHeight="200">
            <Border Width="460" Style="{StaticResource MeterRootChrome}">
                <StackPanel>
                    <controls:BossBarView/>
                    <controls:MeterRowsView/>
                    <controls:CombatTimerBar/>
                </StackPanel>
            </Border>
        </Viewbox>
    </Border>
</UserControl>
