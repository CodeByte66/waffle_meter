<UserControl x:Class="WaffleMeter.App.Wpf.Controls.BossBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaffleMeter.App.Wpf">
    <!--
        보스칸. 두 상태를 한 자리에서 그린다:
          전투 중 — 레이아웃마다 HP 표현이 다르다.
              전장(Band)     이름 줄 아래 20px 독립 게이지 띠 + 25% 눈금. 남은 HP 가 길이로 읽힌다.
              계기판(Readout) 판때기를 지우고 HP% 를 26px 주인공으로, 게이지는 3px 레일.
              무대(Canvas)    게이지가 카드 배경 전체를 채운다.
          대기 중 — 인식된 본인 캐릭터 카드(직업 아이콘·닉네임·서버·전투력). 예전엔 빈 판이었다.

        ⚠️ 기존 fill/bar 게이지 경로를 제거하지 않는다. '게이지 형태'(barStyle) 설정은 레이아웃과
        다른 축이고 계속 유효해야 한다.

        ⚠️ 보스칸에는 GaugeFxLayer 도 GaugeSkinId 도 없다 — 게이지 스킨 장식은 행에만 붙는다.
        여기 게이지를 어떻게 바꾸든 후원자·랭커 연출과는 물리적으로 무관하다.

        ⚠️ 루트 Border 는 고정 높이 + ClipToBounds 다. 높이가 모자라면 글자가 잘린 채 조용히
        렌더된다(계기판 52px 에서 실제로 겪었다). 내용을 더하면 3종 + 대기까지 전부 확인할 것.
    -->
    <UserControl.Resources>
        <local:RatioToStarConverter x:Key="RatioToStar"/>
        <local:OffsetConverter x:Key="Offset"/>
    </UserControl.Resources>

    <Border CornerRadius="6" Padding="8,0" Margin="0,0,0,6" ClipToBounds="True"
            Visibility="{Binding BossSlotVisibility}">
        <Border.Style>
            <Style TargetType="Border">
                <!-- ⚠️ 기본값을 Border 속성으로 직접 쓰면 로컬 값이라 아래 트리거가 절대 못 이긴다.
                     계기판이 투명해지지 않았던 원인이 정확히 이것이었다. -->
                <Setter Property="Background" Value="{DynamicResource Skin.RowBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="{Binding Layout.BossHeight}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Layout.BossReadoutVisibility}" Value="Visible">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Padding" Value="4,0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Layout.BossCanvasVisibility}" Value="Visible">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="Padding" Value="11,0"/>
                    </DataTrigger>
                    <!-- 대기 카드는 전투 구성보다 낮다. 전장의 84px 를 그대로 쓰면 카드가 허공에 뜬다. -->
                    <DataTrigger Binding="{Binding IdleCardVisibility}" Value="Visible">
                        <Setter Property="Height" Value="46"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <!-- ═══ 전투 중 ═══ -->
            <Grid Visibility="{Binding TargetInfoVisibility}">
                <!-- 무대: 게이지가 카드 배경 전체. Padding 밖까지 깔리도록 Margin 으로 되민다. -->
                <Grid Visibility="{Binding Layout.BossCanvasVisibility}" Margin="-11,0,-11,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                        <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding BossBarBrush}" Opacity="0.55"/>
                </Grid>

                <!-- "fill" HP gauge (게이지 형태 = fill): 글자 뒤 낮은 불투명도 채움.
                     ⚠️ 전장은 20px 띠가 이미 HP 를 말하므로 여기 채움이 겹치면 이중으로 깔린다 —
                     띠를 쓰는 레이아웃에서는 이 경로를 끈다(barStyle 설정 자체는 계속 유효하다). -->
                <Grid Visibility="{Binding TargetBarFillVisibility}"
                      IsHitTestVisible="False">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Layout.BossBandVisibility}" Value="Visible">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                        <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding BossBarBrush}" Opacity="0.3" CornerRadius="4"/>
                </Grid>
                <!-- "bar" HP gauge: 하단 얇은 바. "none" 이면 둘 다 숨는다. -->
                <Grid VerticalAlignment="Bottom" Height="2" Visibility="{Binding TargetBottomBarVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                        <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding BossBarBrush}"/>
                </Grid>

                <!-- ── 전장: 3단(이름줄 / 20px 띠 / HP숫자·처치까지·큰 HP%) ── -->
                <Grid Visibility="{Binding Layout.BossBandVisibility}" Margin="2,0,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1줄: [난이도] 이름 -->
                    <Grid Grid.Row="0" Margin="0,8,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 난이도·단계 칩. 예전엔 이름 뒤 괄호에 묻혀 있었다 — EncounterCatalog.DisplayParts 가
                             이름과 라벨을 갈라 준다. 미등록 보스는 라벨이 없어 칩이 접힌다. -->
                        <Border Grid.Column="0" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="{DynamicResource Skin.BossChipBg}" BorderThickness="1"
                                BorderBrush="{DynamicResource Skin.BossChipRing}"
                                Visibility="{Binding TargetVariantVisibility}">
                            <TextBlock Text="{Binding TargetVariantText}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Skin.BossChipFg}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding TargetName}" Foreground="{DynamicResource Skin.Fg}"
                                   FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- 2줄: 20px 게이지 띠 + 25% 눈금. 남은 HP 가 색이 아니라 길이로 읽힌다. -->
                    <Border Grid.Row="1" Height="20" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource Skin.GaugeTrack}"
                            BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                                <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Border Background="{Binding BossBarBrush}"/>
                                <!-- 상단 1px 하이라이트 — 띠에 두께감을 준다. -->
                                <Border Height="1" VerticalAlignment="Top" Background="#57FFFFFF"/>
                            </Grid>
                            <UniformGrid Grid.ColumnSpan="2" Rows="1" Columns="4" IsHitTestVisible="False">
                                <Border BorderBrush="#2BFFFFFF" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#2BFFFFFF" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#2BFFFFFF" BorderThickness="0,0,1,0"/>
                                <Border/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- 3줄: HP숫자 · 처치까지 ……… 큰 HP% -->
                    <Grid Grid.Row="2" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TargetHpAmountText}" FontSize="12.5"
                                   Foreground="{DynamicResource Skin.MutedFg}" VerticalAlignment="Bottom"
                                   Typography.NumeralAlignment="Tabular"/>
                        <!-- 처치까지 = 남은 HP ÷ 지금 파티 DPS. 미터만 낼 수 있는 숫자다. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                    Visibility="{Binding TargetEtaVisibility}">
                            <TextBlock Text="처치까지 " FontSize="10.5" Foreground="{DynamicResource Skin.MutedFg}"/>
                            <TextBlock Text="{Binding TargetEtaText}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Skin.Accent}" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding TargetHpPercentText}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource Skin.BossPercentFg}" VerticalAlignment="Bottom"
                                   Typography.NumeralAlignment="Tabular" Visibility="{Binding TargetHpVisibility}"/>
                    </Grid>
                </Grid>

                <!-- ── 무대: 아이콘 박스 + 이름/서브라인 + 큰 HP% + 하단 레일 ── -->
                <Grid Visibility="{Binding Layout.BossInlineVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7" Margin="0,0,11,0"
                            VerticalAlignment="Center" Background="{DynamicResource Skin.StatBg}"
                            BorderThickness="1" BorderBrush="{DynamicResource Skin.IconRing}">
                        <Image Source="{Binding BossIcon}" Stretch="Uniform" Margin="4"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TargetName}" Foreground="{DynamicResource Skin.Fg}"
                                   FontWeight="SemiBold" FontSize="15.5" TextTrimming="CharacterEllipsis"/>
                        <!-- "던전 · 난이도". 페이즈는 미터에 데이터가 없어 넣지 않는다. -->
                        <TextBlock Text="{Binding TargetSubtitle}" Foreground="{DynamicResource Skin.MutedFg}"
                                   FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding TargetSubtitleVisibility}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Visibility="{Binding TargetHpVisibility}">
                        <TextBlock Text="{Binding TargetHpPercentText}" Foreground="{DynamicResource Skin.Fg}"
                                   FontWeight="Bold" FontSize="23" TextAlignment="Right"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding TargetHpAmountText}" Foreground="{DynamicResource Skin.MutedFg}"
                                   FontSize="10.5" Margin="0,3,0,0" TextAlignment="Right"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Grid>

                <!-- 무대 하단 4px HP 레일 — 게이지 형태 설정과 무관하게 항상 있다(카드 배경 채움은
                     방향만 말하고 정확한 값은 이 레일이 말한다). Padding 밖까지 되민다. -->
                <Grid VerticalAlignment="Bottom" Height="4" Margin="-11,0,-11,0"
                      Visibility="{Binding Layout.BossCanvasVisibility}">
                    <Border Background="{DynamicResource Skin.GaugeTrack}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                            <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Skin.BossRail}"/>
                    </Grid>
                </Grid>

                <!-- ── 계기판: HP% 가 주인공 ── -->
                <Grid Visibility="{Binding Layout.BossReadoutVisibility}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <!-- 판때기가 없으니 그림자가 가독성의 전부다. 칸 전체에 한 번만 건다. -->
                                <DataTrigger Binding="{Binding Layout.EtchText}" Value="True">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.95" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding TargetName}" Foreground="{DynamicResource Skin.MutedFg}"
                               FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TargetHpPercentText}" Foreground="{DynamicResource Skin.Fg}"
                                   FontWeight="Bold" FontSize="26" VerticalAlignment="Center" MinWidth="96"
                                   Typography.NumeralAlignment="Tabular"/>
                        <Border Grid.Column="1" Height="3" CornerRadius="2" VerticalAlignment="Center" Margin="10,0"
                                Background="#24FFFFFF" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                                    <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding BossBarBrush}"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding TargetHpText}" Foreground="{Binding CombatTimeBrush}" FontSize="10.5"
                                   VerticalAlignment="Center" Visibility="{Binding TargetHpVisibility}"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ═══ 대기 중: 본인 캐릭터 카드 ═══
                 전투가 없을 때 이 자리는 지금까지 "전투 대기 중" 한 줄만 있는 빈 판이었다.
                 인식된 캐릭터를 보여주면 미터가 전투 전에도 "지금 누구를 보고 있는지"를 말해 준다. -->
            <Grid Visibility="{Binding IdleCardVisibility}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Layout.EtchText}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.95" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,7,8,7" Background="{Binding SelfJobBrush}"/>
                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Margin="0,0,9,0" VerticalAlignment="Center"
                        Background="{DynamicResource Skin.StatBg}" BorderThickness="1.5" BorderBrush="{Binding SelfJobBrush}">
                    <Image Source="{Binding SelfJobIcon}" Stretch="Uniform" Margin="2"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelfNicknameText}" Foreground="{DynamicResource Skin.Fg}" FontWeight="SemiBold"
                               FontSize="15" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SelfMetaText}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10.5" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Visibility="{Binding SelfPowerVisibility}">
                    <TextBlock Text="{Binding SelfPowerText}" Foreground="{Binding SelfJobBrush}" FontWeight="Bold"
                               FontSize="19" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="전투력" Foreground="{DynamicResource Skin.MutedFg}" FontSize="9.5"
                               TextAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
