<UserControl x:Class="WaffleMeter.App.Wpf.Controls.BossBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaffleMeter.App.Wpf">
    <!--
        보스칸. 두 상태를 한 자리에서 그린다:
          전투 중 — 레이아웃마다 HP 표현이 다르다.
              전장(Band)     이름 줄 아래 20px 독립 게이지 띠 + 25% 눈금. 남은 HP 가 길이로 읽힌다.
              계기판(Readout) 판때기를 지우고 HP% 를 26px 주인공으로, 게이지는 3px 레일.
              무대(Canvas)    게이지가 카드 배경 전체를 채운다.
          대기 중 — 인식된 본인 캐릭터 카드(직업 아이콘·닉네임·서버·전투력). 예전엔 빈 판이었다.

        ⚠️ 기존 fill/bar 게이지 경로를 제거하지 않는다. '게이지 형태'(barStyle) 설정은 레이아웃과
        다른 축이고 계속 유효해야 한다.

        ⚠️ 보스칸에는 GaugeFxLayer 도 GaugeSkinId 도 없다 — 게이지 스킨 장식은 행에만 붙는다.
        여기 게이지를 어떻게 바꾸든 후원자·랭커 연출과는 물리적으로 무관하다.

        ⚠️ 루트 Border 는 고정 높이 + ClipToBounds 다. 높이가 모자라면 글자가 잘린 채 조용히
        렌더된다(계기판 52px 에서 실제로 겪었다). 내용을 더하면 3종 + 대기까지 전부 확인할 것.

        🔑 칸 높이는 사용자 배율(설정 › 표시 › 보스칸 높이, 70~150%)을 탄다. 그래서 칸 안의 **세로 치수와
        글자 크기는 전부** `Layout.BossScale` 을 곱한다(BossScaleConverter — 파라미터가 100% 기준값).
        칸과 내용이 같은 수를 곱하므로 어느 배율에서도 100% 와 여백 비율이 같다. 새 요소를 더하면서 이
        곱을 빼먹으면 축소 배율에서 그 요소만 제자리에 남아 칸을 넘치고, ClipToBounds 라 잘린 채
        조용히 렌더된다.
        ⚠️ 가로 여백(카드 좌우 Padding, 무대의 -11 되밀기, 칩·아이콘 오른쪽 간격)은 곱하지 않는다 —
        보스칸의 좌우 정렬선은 아래 행들과 공유하는 축이라 배율을 따라 움직이면 보스 이름과 행 이름의
        왼쪽 끝이 어긋난다.
    -->
    <UserControl.Resources>
        <local:RatioToStarConverter x:Key="RatioToStar"/>
        <local:OffsetConverter x:Key="Offset"/>
        <!-- 칸 높이에 맞춰 칸 안 치수를 같이 움직이는 배율. 파라미터가 100% 기준값이다. -->
        <local:BossScaleConverter x:Key="BossScale"/>
    </UserControl.Resources>

    <Border Margin="{Binding Layout.SectionGapBelow}" ClipToBounds="True"
            Visibility="{Binding BossSlotVisibility}">
        <Border.Style>
            <Style TargetType="Border">
                <!-- ⚠️ 기본값을 Border 속성으로 직접 쓰면 로컬 값이라 아래 트리거가 절대 못 이긴다.
                     계기판이 투명해지지 않았던 원인이 정확히 이것이었다. -->
                <Setter Property="Background" Value="{DynamicResource Skin.RowBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <!-- ⚠️ 이 둘도 반드시 Setter 다. 속성으로 쓰면 로컬 값이라 아래 무대 트리거의
                     CornerRadius·Padding 이 **절대 못 이긴다** — v3.0.0 이 정확히 그래서 무대 카드가
                     둥근 모서리에 8px 패딩으로 나갔고(설계는 각진 모서리 + 11px), 배경 게이지의
                     -11 되밀기만 11 을 가정한 채 어긋나 있었다. -->
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="Height" Value="{Binding Layout.BossHeight}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Layout.BossReadoutVisibility}" Value="Visible">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <!-- 계기판은 좌우 여백을 **다른 레이아웃과 같은 8** 로 둔다. 원래 여기 4,0 이
                             적혀 있었지만 위 로컬 값에 막혀 한 번도 적용된 적이 없고, 실제로 적용해 보니
                             보스 글자만 행 텍스트(카드 패딩 8)보다 4px 더 왼쪽으로 튀어나왔다. -->
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Layout.BossCanvasVisibility}" Value="Visible">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="Padding" Value="11,0"/>
                    </DataTrigger>
                    <!-- 대기 카드는 전투 구성보다 낮다. 전장의 84px 를 그대로 쓰면 카드가 허공에 뜬다. -->
                    <!-- 대기 카드는 고정 높이를 풀고 남은 공간을 채운다(행 영역이 비어 있다).
                         MinHeight 로 하한만 잡아 창을 아주 낮게 줄여도 카드가 뭉개지지 않게 한다. -->
                    <DataTrigger Binding="{Binding IdleCardVisibility}" Value="Visible">
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="MinHeight" Value="46"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <!-- TrailingInset: 분리모드 보스칸 창이 우상단 컨트롤 자리를 여기로 알린다.
             🔑 여백을 **카드 안쪽**에 둬야 한다. 바깥에서 칸을 줄이면(Grid 열로 밀면) 무대처럼 카드가
                창 끝까지 차는 레이아웃에서 카드가 버튼 앞에서 끊겨 회색 이음매가 생긴다. -->
        <Grid Margin="{Binding TrailingInset, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
            <!-- ═══ 전투 중 ═══ -->
            <Grid Visibility="{Binding TargetInfoVisibility}">
                <!-- 무대: 게이지가 카드 배경 전체. Padding 밖까지 깔리도록 Margin 으로 되민다. -->
                <Grid Visibility="{Binding Layout.BossCanvasVisibility}" Margin="-11,0,-11,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                        <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding BossBarBrush}" Opacity="0.55"/>
                </Grid>

                <!-- 옛 보스 게이지 경로(barStyle fill/bar)는 걷어냈다.
                     이제 레이아웃마다 보스 HP 를 제 방식으로 그린다 — 전장은 20px 띠, 계기판은 3px 레일,
                     무대는 카드 배경 + 하단 레일. 그 위에 옛 경로가 한 겹 더 깔리면서 **보스칸 전체가
                     붉게 칠해졌다**(HP 칸만 줄어야 하는데 카드가 통째로 물들었다).
                     ⚠️ 트리거로 가리려 했다가 실패했다: Visibility 가 로컬 값이면 Style 트리거가 절대
                     못 이긴다. 가리는 게 아니라 경로를 없애는 게 맞다.
                     `게이지 형태`(barStyle) 설정은 **행**에 대해 계속 유효하다. -->

                <!-- ── 전장: 3단(이름줄 / 20px 띠 / HP숫자·처치까지·큰 HP%) ── -->
                <Grid Visibility="{Binding Layout.BossBandVisibility}" Margin="2,0,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1줄: [난이도] 이름 -->
                    <Grid Grid.Row="0" Margin="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter='0,8,0,7'}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 난이도·단계 칩. 예전엔 이름 뒤 괄호에 묻혀 있었다 — EncounterCatalog.DisplayParts 가
                             이름과 라벨을 갈라 준다. 미등록 보스는 라벨이 없어 칩이 접힌다. -->
                        <Border Grid.Column="0" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="{DynamicResource Skin.BossChipBg}" BorderThickness="1"
                                BorderBrush="{DynamicResource Skin.BossChipRing}"
                                Visibility="{Binding TargetVariantVisibility}">
                            <TextBlock Text="{Binding TargetVariantText}" FontWeight="Bold"
                                       FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=10.5}"
                                       Foreground="{DynamicResource Skin.BossChipFg}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding TargetName}" Foreground="{DynamicResource Skin.Fg}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=16}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- 2줄: 20px 게이지 띠 + 25% 눈금. 남은 HP 가 색이 아니라 길이로 읽힌다. -->
                    <Border Grid.Row="1" ClipToBounds="True"
                            Height="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=20}"
                            CornerRadius="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=4}"
                            Background="{DynamicResource Skin.GaugeTrack}"
                            BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                                <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                            </Grid.ColumnDefinitions>
                            <!-- ⚠️ 채움에도 반경을 준다. 트랙 Border 의 ClipToBounds 는 **사각형**으로만
                                 자르기 때문에 둥근 모서리를 따라가지 않는다 — 각진 채움을 넣으면 트랙의
                                 둥근 꼭지점 밖으로 모서리가 삐져나온다. 3 은 트랙 4 보다 1 작아 안쪽에
                                 자연스럽게 앉는다. -->
                            <Border Grid.Column="0" ClipToBounds="True"
                                    CornerRadius="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=3}"
                                    Background="{Binding BossBarBrush}">
                                <!-- 상단 1px 하이라이트 — 띠에 두께감을 준다. -->
                                <Border Height="1" VerticalAlignment="Top" Margin="2,0" Background="#57FFFFFF"/>
                            </Border>
                            <UniformGrid Grid.ColumnSpan="2" Rows="1" Columns="4" IsHitTestVisible="False">
                                <Border BorderBrush="#2BFFFFFF" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#2BFFFFFF" BorderThickness="0,0,1,0"/>
                                <Border BorderBrush="#2BFFFFFF" BorderThickness="0,0,1,0"/>
                                <Border/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- 3줄: HP숫자 · 처치까지 ……… 큰 HP% -->
                    <Grid Grid.Row="2" Margin="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter='0,7,0,0'}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TargetHpAmountText}"
                                   FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=12.5}"
                                   Foreground="{DynamicResource Skin.MutedFg}" VerticalAlignment="Bottom"
                                   Typography.NumeralAlignment="Tabular"/>
                        <!-- 처치까지 = 남은 HP ÷ 지금 파티 DPS. 미터만 낼 수 있는 숫자다. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                    Visibility="{Binding TargetEtaVisibility}">
                            <TextBlock Text="처치까지 " Foreground="{DynamicResource Skin.MutedFg}"
                                       FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=10.5}"/>
                            <TextBlock Text="{Binding TargetEtaText}" FontWeight="SemiBold"
                                       FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=10.5}"
                                       Foreground="{DynamicResource Skin.Accent}" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding TargetHpPercentText}" FontWeight="Bold"
                                   FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=22}"
                                   Foreground="{DynamicResource Skin.BossPercentFg}" VerticalAlignment="Bottom"
                                   Typography.NumeralAlignment="Tabular" Visibility="{Binding TargetHpVisibility}"/>
                    </Grid>
                </Grid>

                <!-- ── 무대: 아이콘 박스 + 이름/서브라인 + 큰 HP% + 하단 레일 ── -->
                <Grid Visibility="{Binding Layout.BossInlineVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Margin 의 오른쪽 11 은 가로 간격이라 배율을 안 탄다(위 주석 참고). -->
                    <Border Grid.Column="0" Margin="0,0,11,0"
                            Width="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=30}"
                            Height="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=30}"
                            CornerRadius="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=7}"
                            VerticalAlignment="Center" Background="{DynamicResource Skin.StatBg}"
                            BorderThickness="1" BorderBrush="{DynamicResource Skin.IconRing}">
                        <Image Source="{Binding BossIcon}" Stretch="Uniform"
                               Margin="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=4}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TargetName}" Foreground="{DynamicResource Skin.Fg}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=15.5}"/>
                        <!-- "던전 · 난이도". 페이즈는 미터에 데이터가 없어 넣지 않는다. -->
                        <TextBlock Text="{Binding TargetSubtitle}" Foreground="{DynamicResource Skin.MutedFg}"
                                   FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=10.5}"
                                   Margin="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter='0,2,0,0'}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding TargetSubtitleVisibility}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Visibility="{Binding TargetHpVisibility}">
                        <TextBlock Text="{Binding TargetHpPercentText}" Foreground="{DynamicResource Skin.Fg}"
                                   FontWeight="Bold" TextAlignment="Right"
                                   FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=23}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding TargetHpAmountText}" Foreground="{DynamicResource Skin.MutedFg}"
                                   FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=10.5}"
                                   Margin="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter='0,3,0,0'}"
                                   TextAlignment="Right"
                                   Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Grid>

                <!-- 무대 하단 4px HP 레일 — 게이지 형태 설정과 무관하게 항상 있다(카드 배경 채움은
                     방향만 말하고 정확한 값은 이 레일이 말한다). Padding 밖까지 되민다. -->
                <Grid VerticalAlignment="Bottom" Margin="-11,0,-11,0"
                      Height="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=4}"
                      Visibility="{Binding Layout.BossCanvasVisibility}">
                    <Border Background="{DynamicResource Skin.GaugeTrack}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                            <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Skin.BossRail}"/>
                    </Grid>
                </Grid>

                <!-- ── 계기판: HP% 가 주인공 ── -->
                <Grid Visibility="{Binding Layout.BossReadoutVisibility}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <!-- 판때기가 없으니 그림자가 가독성의 전부다. 칸 전체에 한 번만 건다. -->
                                <DataTrigger Binding="{Binding Layout.EtchText}" Value="True">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.95" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding TargetName}" Foreground="{DynamicResource Skin.MutedFg}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=11.5}"
                               Margin="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter='0,2,0,0'}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- MinWidth 96 은 자릿수 고정폭이라 글자와 **같이** 커져야 레일 시작점이 안 흔들린다. -->
                        <TextBlock Grid.Column="0" Text="{Binding TargetHpPercentText}" Foreground="{DynamicResource Skin.Fg}"
                                   FontWeight="Bold" VerticalAlignment="Center"
                                   FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=26}"
                                   MinWidth="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=96}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                                Height="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=3}"
                                CornerRadius="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=2}"
                                Background="#24FFFFFF" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding TargetHpRatio, Converter={StaticResource RatioToStar}}"/>
                                    <ColumnDefinition Width="{Binding TargetHpRest, Converter={StaticResource RatioToStar}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding BossBarBrush}"/>
                            </Grid>
                        </Border>
                        <!-- ⚠️ TargetHpText 를 쓰지 마라 — 그건 '수치 + 퍼센트' 합본이라 바로 왼쪽의 26px
                             퍼센트와 같은 값을 한 줄에 두 번 말하게 된다. TargetHpAmountText 는 퍼센트를 뺀
                             수치만이고, '퍼센트만' 표시 형식에서는 빈 문자열이라 이 칸이 알아서 접힌다. -->
                        <TextBlock Grid.Column="2" Text="{Binding TargetHpAmountText}" Foreground="{Binding CombatTimeBrush}"
                                   FontSize="{Binding Layout.BossScale, Converter={StaticResource BossScale}, ConverterParameter=10.5}"
                                   VerticalAlignment="Center" Visibility="{Binding TargetHpVisibility}"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ═══ 대기 중: 본인 캐릭터 카드 ═══
                 전투가 없을 때 이 자리는 지금까지 "전투 대기 중" 한 줄만 있는 빈 판이었다.
                 인식된 캐릭터를 보여주면 미터가 전투 전에도 "지금 누구를 보고 있는지"를 말해 준다. -->
            <Grid Visibility="{Binding IdleCardVisibility}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Layout.EtchText}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.95" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,5,8,5" Background="{Binding SelfJobBrush}"/>
                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{DynamicResource Skin.StatBg}" BorderThickness="1.5" BorderBrush="{Binding SelfJobBrush}">
                    <Image Source="{Binding SelfJobIcon}" Stretch="Uniform" Margin="2"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelfNicknameText}" Foreground="{DynamicResource Skin.Fg}" FontWeight="SemiBold"
                                   FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <!-- 직전 전투에서 산출된 티어. 티어는 DPS 로 매겨지므로 전투를 한 번도 안 했으면
                             보여줄 근거가 없다 — 그때는 조용히 접힌다(없는 값을 지어내지 않는다). -->
                        <Border CornerRadius="4" Padding="5,0" Margin="7,0,0,0" VerticalAlignment="Center"
                                BorderThickness="1" SnapsToDevicePixels="True"
                                Background="{Binding SelfTierChipBg}" BorderBrush="{Binding SelfTierChipRing}"
                                ToolTip="{Binding SelfTierChipToolTip}"
                                Visibility="{Binding SelfTierChipVisibility}">
                            <TextBlock Text="{Binding SelfTierChipText}" Foreground="{Binding SelfTierChipFg}"
                                       FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelfMetaText}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Visibility="{Binding SelfPowerVisibility}">
                    <TextBlock Text="{Binding SelfPowerText}" Foreground="{Binding SelfJobBrush}" FontWeight="Bold"
                               FontSize="17" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="전투력" Foreground="{DynamicResource Skin.MutedFg}" FontSize="9"
                               TextAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
