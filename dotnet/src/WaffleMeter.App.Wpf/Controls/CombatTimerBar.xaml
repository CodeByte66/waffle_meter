<UserControl x:Class="WaffleMeter.App.Wpf.Controls.CombatTimerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        전투 타이머 띠. 본체 미터의 푸터 위 한 줄이자, UI 분리모드에서는 미터 행 창의 유일한 상태 표시다.
        두 곳이 **같은 마크업**을 쓰게 하려고 뽑았다 — 분리모드용으로 따로 적었더니 이번 전투 상위 X.X%
        칩이 조용히 빠졌고, 레이아웃별 seamless 변형도 같이 사라졌다.

        DataContext 는 양쪽 다 같은 OverlayViewModel 이라 평범한 {Binding} 이 그대로 닿는다
        (MeterRowsView 가 RelativeSource 를 쓰는 건 ItemsControl 안이라 항목이 DataContext 를 가리기 때문이고,
        여기는 그 사정이 없다).
    -->
    <Border Visibility="{Binding CombatTimerVisibility}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Margin" Value="{Binding Layout.SectionGapAbove}"/>
                <Setter Property="Background" Value="{DynamicResource Skin.RowBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <!-- 계기판: 행에 카드가 없으면 이 띠에도 없어야 한다. 여기만 알약으로 남으면 판때기를
                         지운 레이아웃에 카드 하나가 떠 있는 꼴이 된다(시안은 글자만 얹혀 있다). -->
                    <DataTrigger Binding="{Binding Layout.HasCardChrome}" Value="False">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4,3"/>
                    </DataTrigger>
                    <!-- 한 덩어리: 알약이 아니라 판에 이어 붙는 띠가 된다. -->
                    <DataTrigger Binding="{Binding Layout.SeamlessSections}" Value="True">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="Padding" Value="11,5"/>
                        <Setter Property="Background" Value="{DynamicResource Skin.TableHeadBg}"/>
                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                    </DataTrigger>
                    <!-- 분리모드의 행 창에서 이 띠는 **행 위**에 붙는다(무대). 그때 구분선은 아래쪽이다 —
                         위에 그으면 창 맨 윗변에 의미 없는 선이 하나 남는다. -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Layout.SeamlessSections}" Value="True"/>
                            <Condition Binding="{Binding DockedTop, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding CombatStatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding CombatStatusText}" Foreground="{Binding CombatStatusBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <!-- 이번 전투 상위 X.X% (self only). It lives HERE and not on the row because the row's
                 420px default width is already fully spent on name/server/power — a chip there gets
                 clipped at the column boundary. This is also the honest place for it: it is one
                 number about one fight, not a per-player column. -->
            <Border Grid.Column="2" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                    BorderThickness="1" CornerRadius="4" Padding="6,0" SnapsToDevicePixels="True"
                    Background="{Binding SelfTierChipBg}" BorderBrush="{Binding SelfTierChipRing}"
                    Visibility="{Binding SelfTierChipVisibility}" ToolTip="{Binding SelfTierChipToolTip}">
                <!-- FontSize 10 + zero vertical padding keeps the first line inside the timer row's
                     existing line height. -->
                <StackPanel>
                    <TextBlock Text="{Binding SelfTierChipText}" Foreground="{Binding SelfTierChipFg}"
                               FontSize="10" FontWeight="SemiBold"/>
                    <!-- 무엇과 비교한 값인지. 인라인으로 붙는다 — 툴팁에만 두면 전체 구간으로 폴백된
                         사람이 그 사실을 모른 채 지나간다. 서버가 전투력 구간 분포를 아직 안 내보내면
                         "전체 전투력 기준"이 뜨고, 내보내기 시작하면 같은 자리 문구만 바뀐다.
                         LineHeight를 글자 크기에 맞춰 눌러 두 번째 줄이 더하는 높이를 최소로 잡는다. -->
                    <TextBlock Text="{Binding SelfTierChipBasis}" Foreground="{Binding SelfTierChipFg}"
                               Visibility="{Binding SelfTierChipBasisVisibility}"
                               FontSize="9" Opacity="0.75" LineHeight="10" LineStackingStrategy="BlockLineHeight"
                               Margin="0,-1,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{Binding CombatTimeBrush}" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
