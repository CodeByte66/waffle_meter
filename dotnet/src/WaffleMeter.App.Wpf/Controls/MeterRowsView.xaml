<UserControl x:Class="WaffleMeter.App.Wpf.Controls.MeterRowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:controls="clr-namespace:WaffleMeter.App.Wpf.Controls">
    <!--
        미터 행 목록. OverlayWindow.xaml 에서 **수치를 한 글자도 바꾸지 않고** 옮겨 왔다 — 분리모드에서
        같은 UserControl 을 별도 창에 그대로 얹기 위해서다(두 창이 같은 ViewModel 을 공유한다).

        컨버터는 여기서 다시 선언한다: DataTemplate 안의 StaticResource 는 런타임 비주얼 트리가 아니라
        **선언된 사전의 파싱 스코프**에서 해석되므로, OverlayWindow 의 Window.Resources 로는 안 풀린다.
    -->
    <UserControl.Resources>
        <local:RatioToStarConverter x:Key="RatioToStar"/>
        <local:RowHeightToFontSizeConverter x:Key="FontSize"/>
        <local:RightGapConverter x:Key="RightGap"/>
    </UserControl.Resources>
            <!-- 행 목록. 이 ScrollViewer는 v2.8.0 마크업을 그대로 되돌린 것이고, 실측상 관측 가능한 역할이 없다:
                 자동 맞춤(SizeToContent="Height")에서는 VerticalScrollBarVisibility="Disabled"가 세로 제약을
                 그대로 통과시켜 있으나 없으나 창 높이가 같고(1/5/10/24행 모두 동일), 높이를 고정한 상태에서도
                 넘치는 행은 WPF 레이아웃 클립이 이미 잘라내 렌더 결과가 픽셀 단위로 같다.
                 ※ v2.8.1은 이걸 "높이가 안 늘어나는 원인"으로 지목해 제거했으나 오진이었다. 진짜 원인은 WPF가
                    크기 조절 시작 시점에 SizeToContent를 꺼버리는 것 — WindowResizePolicy 참조. -->
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <!--
                전투 전 빈 상태. 본체에서는 바로 위 보스칸에 대기 카드가 떠 있으면 같은 말이 두 번 나오므로
                접지만, UI 분리모드의 행 창은 **대기 카드가 아예 다른 창에 있다** — 접어 버리면 텅 빈 띠
                하나만 남아 "여기가 뭐 하는 칸인지" 알 수 없다. 그래서 그 창은 IdleCardElsewhere 로 알린다.
            -->
            <StackPanel Margin="0,6,0,4">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="{Binding PlaceholderVisibility}"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IdleCardVisibility}" Value="Visible"/>
                                    <Condition Binding="{Binding IdleCardElsewhere, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="전투 대기 중" Foreground="{DynamicResource Skin.MutedFg}"
                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="전투가 시작되면 여기에 딜 순위가 표시됩니다" Foreground="{DynamicResource Skin.MutedFg}"
                           HorizontalAlignment="Center" FontSize="10.5" Opacity="0.75" Margin="0,2,0,0"/>

                <!-- 들어설 행의 '자리'를 그대로 보여 준다. 글보다 이게 빠르게 읽히고, 레이아웃 기하를
                     그대로 쓰므로 세 레이아웃에서 각자 맞는 모양이 나온다. -->
                <ItemsControl Margin="0,7,0,0" IsHitTestVisible="False">
                    <ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type sys:Double}">
                            <sys:Double>0.62</sys:Double>
                            <sys:Double>0.40</sys:Double>
                            <sys:Double>0.24</sys:Double>
                        </x:Array>
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="{Binding DataContext.Layout.CardRadius, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    Margin="{Binding DataContext.Layout.CardMargin, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    MinHeight="{Binding DataContext.Layout.RowMinHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    Background="Transparent" BorderThickness="1" Opacity="0.5"
                                    BorderBrush="{DynamicResource Skin.SoftBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource RatioToStar}}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource Skin.GaugeTrack}" Opacity="0.7"
                                            CornerRadius="{Binding DataContext.Layout.GaugeCorner, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 🔑 레이아웃이 '컨테이너 없음'이어도 이 Border 를 **지우지 않는다**. MinHeight 가
                             GaugeFxLayer 의 유일한 높이 공급원이고(레이어의 MeasureOverride 는 0), 크롬만 0 으로
                             만든다. 아래 트리거의 Background 도 반드시 Transparent 여야 한다 — {x:Null} 이면
                             히트테스트가 죽어 행 클릭(상세창)과 hover 가 함께 조용히 사라진다. -->
                        <Border CornerRadius="{Binding DataContext.Layout.CardRadius, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Padding="{Binding DataContext.Layout.CardPadding, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                Margin="{Binding DataContext.Layout.CardMargin, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Cursor="Hand" BorderThickness="{Binding DataContext.Layout.CardBorder, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                ClipToBounds="True" MouseLeftButtonUp="OnRowClick" MinHeight="{Binding DataContext.Layout.RowMinHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                Typography.NumeralAlignment="Tabular">
                            <Border.Style>
                                <!-- Resting card fill + soft border (matches React .meter-row); hover lightens.
                                     A tiered row carries its tier colour on the OUTLINE as well — the rings on
                                     two 20px badges alone were easy to miss at a glance. The untiered path is
                                     unchanged, hover included, so the feature-off render stays pixel-identical. -->
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Skin.RowBg}"/>
                                    <Setter Property="BorderBrush" Value="{Binding Tier.RowBorder}"/>
                                    <Style.Triggers>
                                        <!-- 죽어 있는 동안 행 전체를 흐리게. 판정은 fail-open 이라(살아서 딜하면
                                             즉시 풀린다) 이 상태가 오래 남을 수 없고, 그래서 숨기지 않고 흐리게만
                                             한다 — 행이 사라지면 그 자리의 순위가 흔들려 읽던 눈이 미끄러진다. -->
                                        <DataTrigger Binding="{Binding IsDead}" Value="True">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                        <!-- 티어 색을 행 테두리에 입히지 않는 레이아웃. 카드가 없거나
                                             헤어라인뿐인 곳에서는 색 테두리가 행 사이를 벌려 보이게 하고
                                             의미 없는 선을 남긴다 — 티어는 칩으로만 말한다. -->
                                        <DataTrigger Binding="{Binding DataContext.Layout.TierRowOutline, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                                        </DataTrigger>
                                        <!-- 계기판: 판때기를 지운다. Transparent 여야 클릭·hover 가 산다. -->
                                        <DataTrigger Binding="{Binding DataContext.Layout.HasCardChrome, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tier.IsNone}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Skin.RowHover}"/>
                                        </Trigger>
                                        <!-- hover on an untiered row still lightens the outline, exactly as before -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Tier.IsNone}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Skin.Border}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <!-- thick "fill" gauge behind the content (barStyle=fill): a proportional
                                         FillBrush panel at low opacity so the row text stays readable on top. -->
                                    <!-- 색 채움은 그대로. 그 위에 장식 레이어만 얹는다 — 채움을 도형으로
                                         갈아치웠던 판(23ca728)은 딜 숫자의 바탕을 그림으로 만들어 되돌렸다.
                                         ContentExclusionLeft 는 rail+순위칩+직업아이콘 구간으로, 반투명
                                         테마에서 입자가 아이콘 뒤로 비쳐 배지를 물들이지 않게 한다.
                                         GaugeFxLayer 는 MeasureOverride 가 0 이라 행 기하에 관여하지 않는다.
                                         내부 구조는 controls:RowGaugeCell 이 소유한다 — 설정창 미리보기와
                                         **같은 컨트롤**이라 시안과 실물이 다시 어긋날 수 없다. -->
                                    <controls:RowGaugeCell Visibility="{Binding BarFillVisibility}"
                                                           Margin="{Binding DataContext.Layout.GaugeBleed, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                           GaugeCorner="{Binding DataContext.Layout.GaugeCorner, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                           GaugeRadius="{Binding DataContext.Layout.GaugeRadius, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                           ContentExclusionLeft="{Binding DataContext.Layout.GaugeExclusionLeft, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                           MinBandHeight="{Binding DataContext.Layout.FxBandHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                        <controls:RowGaugeCell.Style>
                                            <Style TargetType="controls:RowGaugeCell">
                                                <Setter Property="EdgeHighlightVisibility"
                                                        Value="{Binding DataContext.Layout.EdgeHighlightVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                                <Style.Triggers>
                                                    <!-- 스킨 행은 팔레트가 자기 하이라이트를 갖고 있어 종단선이 이중으로 겹친다. -->
                                                    <DataTrigger Binding="{Binding GaugeFxEnabled}" Value="True">
                                                        <Setter Property="EdgeHighlightVisibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:RowGaugeCell.Style>
                                    </controls:RowGaugeCell>
                                  <Grid>
                                    <!-- 판때기가 없는 레이아웃(계기판)은 글자가 게임 화면 위에 바로 얹히므로
                                         그림자가 가독성의 전부다. ⚠️효과는 **행당 하나**만 건다 — 글자마다
                                         걸면 10행 × 4개 = 40개가 되고, 이 오버레이는 소프트웨어 렌더를
                                         강제하고 있어 그 비용이 그대로 프레임에 실린다. 게이지 채움은
                                         이 Grid 의 형제라 흐려지지 않는다. -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.Layout.EtchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.95" Color="Black"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- left accent rail -->
                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,8,2" VerticalAlignment="Stretch"
                                            Background="{Binding FillBrush}" Opacity="{Binding AccentOpacity}"
                                            Visibility="{Binding DataContext.Layout.AccentRailVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                    <!-- rank — 던전 티어 tints the fill/ring/number. Every dimension (MinWidth,
                                         Height, Padding, Margin, BorderThickness, CornerRadius) is UNCHANGED:
                                         the window is SizeToContent="Height" and growing a badge by a pixel
                                         re-opens the auto-height regression that bit v2.7.5 and v2.8.1.
                                         Tier.IsNone restores the skin's own brushes so an untiered row (or the
                                         feature switched off) is pixel-identical to before across all 4 skins. -->
                                    <!-- 무대: 카드 테두리가 없는 대신 큰 흐린 숫자가 행의 시작점을 만든다. -->
                                    <TextBlock Grid.Column="1" Text="{Binding Rank}" VerticalAlignment="Center"
                                               Margin="{Binding DataContext.Layout.BareRankGap, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource RightGap}}"
                                               Foreground="{DynamicResource Skin.Fg}"
                                               FontWeight="{Binding DataContext.Layout.BareRankWeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               TextAlignment="{Binding DataContext.Layout.BareRankAlignment, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               Opacity="{Binding DataContext.Layout.BareRankOpacity, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               Width="{Binding DataContext.Layout.BareRankWidth, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               FontSize="{Binding DataContext.Layout.BareRankFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               Visibility="{Binding DataContext.Layout.BareRankVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                    <Border Grid.Column="1" BorderThickness="1" SnapsToDevicePixels="True"
                                            CornerRadius="4" MinWidth="22" Height="20" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Visibility="{Binding DataContext.Layout.RankChipVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            ToolTip="{Binding TierInfo.ToolTip}" ToolTipService.IsEnabled="{Binding TierInfo.HasToolTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding Tier.RankBg}"/>
                                                <Setter Property="BorderBrush" Value="{Binding Tier.RankRing}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tier.IsNone}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.32:9'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding Tier.RankFg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tier.IsNone}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <!-- job icon — the tier ring replaces Skin.IconRing; the second ring for the
                                         top three tiers is a size-less Grid child, so it contributes nothing to
                                         DesiredSize and the badge keeps its exact dimensions. -->
                                    <!-- 7px 직업색 점. 지금은 세 레이아웃 모두 아이콘을 쓰므로 어디서도 안 켜지지만,
                                         경로는 남겨 둔다 — ShowJobDot 한 줄로 되돌릴 수 있는 선택지다. -->
                                    <Ellipse Grid.Column="2" Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center"
                                             Fill="{Binding FillBrush}"
                                             Visibility="{Binding DataContext.Layout.JobDotVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                    <Border Grid.Column="2" Background="{DynamicResource Skin.StatBg}" BorderThickness="1" SnapsToDevicePixels="True"
                                            CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Visibility="{Binding DataContext.Layout.JobIconVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            Width="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.66:18'}"
                                            Height="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.66:18'}"
                                            ToolTip="{Binding TierInfo.ToolTip}" ToolTipService.IsEnabled="{Binding TierInfo.HasToolTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{Binding Tier.IconRing}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tier.IsNone}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Skin.IconRing}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Image Source="{Binding IconSource}" Stretch="Uniform" Margin="2"/>
                                            <!-- IsHitTestVisible=False: the row is a click target (OnRowClick) and a
                                                 transparent overlay hit-tests per-pixel alpha, so a decorative ring
                                                 must never become clickable. -->
                                            <Border CornerRadius="4.5" BorderThickness="1" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                                    BorderBrush="{Binding Tier.InnerRing}" Visibility="{Binding Tier.InnerRingVisibility}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- NameFillBrush 는 효과가 없으면 NameBrush 와 같은 객체다 — 후원자·랭커
                                             연출이 꺼져 있으면 이 줄은 도입 전과 픽셀 단위로 동일하다. 요소를
                                             더하지 않고 Foreground 만 바꾸므로 DesiredSize 가 불변이고,
                                             SizeToContent="Height" 자동 높이 재계산도 일어나지 않는다. -->
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameFillBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" FontFamily="{Binding NameFontFamily}"
                                                   FontSize="{Binding DataContext.Layout.NameFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                        <!-- restored bracketed server tag; own element so masking/ellipsis can't eat it -->
                                        <TextBlock Text="{Binding ServerTag, StringFormat='[{0}]'}" Foreground="{Binding NameBrush}"
                                                   VerticalAlignment="Center" Margin="3,0,0,0"
                                                   FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.34:9'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="{Binding ServerTagVisibility}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Layout.ServerTagVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="Collapsed">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border CornerRadius="4" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.Layout.PowerBadgeVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Layout.StatChrome, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <!-- 상자를 지우면 그 패딩도 지워야 죽은 폭이 안 남는다. -->
                                                            <Setter Property="Padding" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PowerText}" Foreground="{Binding PowerBrush}"
                                                       FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.32:9'}"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- 이번 전투 상위 X.X% — per player, computed locally from the downloaded
                                         distribution (this row's dps against its own class cohort). No server
                                         call and nothing about anyone's account: it is derived from the same
                                         combat packets the row already shows. Its own Auto column so it can
                                         never be clipped by the name column, and Collapsed when the cohort had
                                         no shipped distribution row (표본 부족 — we never guess a number). -->
                                    <Border Grid.Column="4" Background="{Binding Tier.ChipBg}" BorderBrush="{Binding Tier.RankRing}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                            ToolTip="{Binding TierInfo.ToolTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="{Binding TierInfo.PercentVisibility}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Layout.TierChipVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TierInfo.PercentText}" Foreground="{Binding Tier.ChipFg}" FontWeight="SemiBold"
                                                   FontSize="{Binding RowHeight, Converter={StaticResource FontSize}, ConverterParameter='0.32:9'}"/>
                                    </Border>
                                    <Border Grid.Column="5" CornerRadius="4" Padding="5,0" Margin="6,0,4,0" VerticalAlignment="Center">
                                        <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Layout.StatChrome, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <!-- 상자를 지우면 그 패딩도 지워야 죽은 폭이 안 남는다. -->
                                                            <Setter Property="Padding" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        <TextBlock Text="{Binding DamageText}" Foreground="{Binding DamageBrush}"
                                                   FontSize="{Binding DataContext.Layout.StatFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                    </Border>
                                    <Border Grid.Column="6" CornerRadius="4" Padding="5,0" VerticalAlignment="Center">
                                        <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Skin.SoftBorder}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Layout.StatChrome, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <!-- 상자를 지우면 그 패딩도 지워야 죽은 폭이 안 남는다. -->
                                                            <Setter Property="Padding" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        <TextBlock Text="{Binding PercentText}" MinWidth="40" TextAlignment="Center"
                                                   FontSize="{Binding DataContext.Layout.StatFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding PercentBrush}"/>
                                                    <Style.Triggers>
                                                        <!-- 무대: 배지 상자가 없으니 색이 그 자리를 대신한다. -->
                                                        <DataTrigger Binding="{Binding DataContext.Layout.PercentUsesJobColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding FillBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                  </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Height="3" Margin="0,3,0,0" Visibility="{Binding BottomBarVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding BarRatio, Converter={StaticResource RatioToStar}}"/>
                                        <ColumnDefinition Width="{Binding BarRest, Converter={StaticResource RatioToStar}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding GaugeBrush}" CornerRadius="1.5"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
            </ScrollViewer>
</UserControl>
