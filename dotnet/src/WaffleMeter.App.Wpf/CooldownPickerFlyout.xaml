<local:OverlayPanelWindow x:Class="WaffleMeter.App.Wpf.CooldownPickerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
        Title="표시할 스킬 선택"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResize"
        SizeToContent="Manual" Width="470" Height="560" MinWidth="380" MinHeight="320"
        Left="40" Top="40" FontFamily="Segoe UI">
    <!-- 참가요청 배지 픽커(SkillSettingsFlyout)와 창을 공유하지 않는다. 저쪽은 배포 중인 화면이고, 이쪽은
         모수가 훨씬 크다(221개 × 9직업) — 그래서 기본이 "내 직업만"이고, 직업 카드마다 선택 수를 띄우며,
         칩도 아이콘을 알아볼 수 있는 크기로 키웠다. 행 뷰모델은 두 픽커가 그대로 공유한다. -->
    <local:OverlayPanelWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- 스킬 토글 칩. 꺼짐 = 흐리게(아이콘은 남는다 — 무엇을 켜는지 봐야 하니까), 켜짐 = 액센트 테두리
             + 옅은 액센트 배경. 체크박스 네모를 따로 두지 않는 이유는 밀도다: 30개가 한 카드에 들어간다. -->
        <Style x:Key="CdChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="6" Padding="5,3,8,3" BorderThickness="1" Opacity="0.4"
                                Background="{DynamicResource Skin.ControlBg}" BorderBrush="{DynamicResource Skin.SoftBorder}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="3" Margin="0,0,6,0" ClipToBounds="True">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,22,22" RadiusX="3" RadiusY="3"/>
                                    </Border.Clip>
                                    <Image Source="{Binding Icon}" Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Skin.Fg}" FontSize="11.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.AccentSoft}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 안의 작은 유령 버튼(전체 선택/해제). 테두리 없이 글자만, 호버에서만 배경이 뜬다. -->
        <Style x:Key="CdGhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="g" CornerRadius="4" Padding="6,2" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="g" Property="Background" Value="{DynamicResource Skin.ControlHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Skin.Fg}"/>
                            </Trigger>
                            <!-- "기본 순서로"는 직업을 모르면 누를 수 없다 — 누를 수 없다는 게 보여야 한다. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="g" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 상단 필터 토글. 켜짐이 기본이라 '켜짐'이 조용하고 '꺼짐'이 눈에 띄지 않아야 한다. -->
        <Style x:Key="CdFilterToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="f" CornerRadius="12" Padding="10,4" BorderThickness="1"
                                Background="{DynamicResource Skin.ControlBg}" BorderBrush="{DynamicResource Skin.SoftBorder}">
                            <TextBlock Text="{Binding FilterLabel}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Skin.MutedFg}" x:Name="ft"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="f" Property="Background" Value="{DynamicResource Skin.AccentSoft}"/>
                                <Setter TargetName="f" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                <Setter TargetName="ft" Property="Foreground" Value="{DynamicResource Skin.Fg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="f" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:OverlayPanelWindow.Resources>

    <Border CornerRadius="10" BorderThickness="1" Background="{DynamicResource Skin.PanelBg}"
            BorderBrush="{DynamicResource Skin.Border}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.42" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <Border Grid.Row="0" Background="{DynamicResource Skin.StatBg}" CornerRadius="10,10,0,0"
                    BorderBrush="{DynamicResource Skin.Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDragHandle">
                <Grid Margin="14,10,10,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="표시할 스킬" Foreground="{DynamicResource Skin.Fg}"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="쿨타임 오버레이에 띄울 스킬을 고릅니다" Foreground="{DynamicResource Skin.MutedFg}"
                                   FontSize="10.5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0"
                            Background="{DynamicResource Skin.AccentSoft}" BorderBrush="{DynamicResource Skin.Accent}"
                            BorderThickness="1" CornerRadius="10" Padding="9,3">
                        <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Skin.Fg}"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="&#xE8BB;" Click="OnCloseButton" ToolTip="닫기"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource HeaderCloseButton}"/>
                </Grid>
            </Border>

            <!-- 배치: 오버레이가 지금 그리는 칸을 같은 순서·같은 줄바꿈으로 보여 주고, 드래그로 순서를 바꾼다.
                 보이는 것이 곧 실제 순서라야 한다 — 목록과 실제 순서가 따로 노는 편집기는 "반응 없는 버튼"이 된다.
                 Viewbox(DownOnly)는 창이 "한 줄 최대 개수"보다 좁을 때 줄바꿈 자리를 지킨 채 통째로 줄이려는 것 —
                 폭을 창에 맞춰 버리면 미리보기가 오버레이와 다른 자리에서 줄을 바꾼다. -->
            <Border Grid.Row="1" Background="{DynamicResource Skin.SectionBg}"
                    BorderBrush="{DynamicResource Skin.Border}" BorderThickness="0,0,0,1">
                <StackPanel Margin="14,8,14,10">
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="배치" Foreground="{DynamicResource Skin.Fg}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="아이콘을 끌어서 오버레이 순서를 바꿉니다" Foreground="{DynamicResource Skin.MutedFg}"
                                       FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="기본 순서로" Click="OnResetArrangement" Style="{StaticResource CdGhostButton}"
                                HorizontalAlignment="Right" IsEnabled="{Binding CanResetArrangement}"
                                ToolTip="이 직업의 배치를 지우고 기본 순서(일반 → 스티그마)로 되돌립니다."/>
                    </Grid>
                    <TextBlock Text="{Binding ArrangeHint}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="11"
                               TextWrapping="Wrap" Margin="1,2,0,2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ArrangeHint}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <ItemsControl x:Name="ArrangeList" ItemsSource="{Binding ArrangeItems}"
                                      MaxWidth="{Binding ArrangeMaxWidth}" Background="Transparent"
                                      PreviewMouseLeftButtonDown="OnArrangeMouseDown"
                                      PreviewMouseMove="OnArrangeMouseMove"
                                      PreviewMouseLeftButtonUp="OnArrangeMouseUp"
                                      LostMouseCapture="OnArrangeLostCapture">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 칸 34 + 좌우 여백 2 = 피치 38. ⚠️ CooldownPickerViewModel.ArrangePitch 와 같아야 한다. -->
                                    <Border x:Name="cell" Width="34" Height="34" Margin="2" CornerRadius="3"
                                            BorderThickness="1" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                            Background="{DynamicResource Skin.ControlBg}" Cursor="SizeAll"
                                            ToolTip="{Binding Name}">
                                        <Border Width="30" Height="30" CornerRadius="2" ClipToBounds="True">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,30,30" RadiusX="2" RadiusY="2"/>
                                            </Border.Clip>
                                            <Image Source="{Binding Icon}" Stretch="Fill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDragged}" Value="True">
                                            <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                            <Setter TargetName="cell" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="cell" Property="Background" Value="{DynamicResource Skin.AccentSoft}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </StackPanel>
            </Border>

            <!-- 도구 줄 -->
            <Border Grid.Row="2" Background="{DynamicResource Skin.SectionBg}"
                    BorderBrush="{DynamicResource Skin.Border}" BorderThickness="0,0,0,1">
                <Grid Margin="14,8">
                    <ToggleButton Style="{StaticResource CdFilterToggle}" HorizontalAlignment="Left"
                                  IsChecked="{Binding OnlyOwnJob, Mode=TwoWay}"
                                  IsEnabled="{Binding CanFilterByJob}"
                                  ToolTip="오버레이는 내 직업 스킬만 그립니다. 끄면 9개 직업이 모두 나옵니다."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="전체 선택" Click="OnSelectAllVisible" Style="{StaticResource CdGhostButton}"/>
                        <Button Content="전체 해제" Click="OnDeselectAllVisible" Style="{StaticResource CdGhostButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 직업 카드 -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="12,10">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Skin.RowBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- 카드 머리: 직업 아이콘 · 이름 · 선택 수 · 유령 버튼 -->
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding JobIcon}" Width="20" Height="20" Margin="0,0,7,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Job}" Foreground="{DynamicResource Skin.Fg}"
                                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Skin.MutedFg}"
                                                       FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="선택" Click="OnSelectAll" Style="{StaticResource CdGhostButton}"/>
                                            <Button Content="해제" Click="OnDeselectAll" Style="{StaticResource CdGhostButton}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="일반" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10"
                                               Margin="1,0,0,4" Visibility="{Binding HasNormal, Converter={StaticResource BoolVis}}"/>
                                    <ItemsControl ItemsSource="{Binding NormalChips}"
                                                  Visibility="{Binding HasNormal, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource CdChip}"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              ToolTip="{Binding Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="스티그마" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10"
                                               Margin="1,6,0,4" Visibility="{Binding HasStigma, Converter={StaticResource BoolVis}}"/>
                                    <ItemsControl ItemsSource="{Binding StigmaChips}"
                                                  Visibility="{Binding HasStigma, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource CdChip}"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              ToolTip="{Binding Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</local:OverlayPanelWindow>
