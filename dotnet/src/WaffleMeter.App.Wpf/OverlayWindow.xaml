<Window x:Class="WaffleMeter.App.Wpf.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
        xmlns:controls="clr-namespace:WaffleMeter.App.Wpf.Controls"
        Title="waffle_meter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize"
        SizeToContent="Height"
        Width="490" Height="300" MinWidth="320" MinHeight="150"
        Left="40" Top="40"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <local:RatioToStarConverter x:Key="RatioToStar"/>
        <local:FontFamilyConverter x:Key="FontConv"/>
        <local:RowHeightToFontSizeConverter x:Key="FontSize"/>
        <local:OffsetConverter x:Key="Offset"/>
        <local:PercentToScaleConverter x:Key="PercentScale"/>

        <!-- HeaderIconButton / HeaderCloseButton live in Themes/PanelChrome.xaml (merged app-wide) so the
             meter header and every panel share one button look + tooltip timing. -->
        <!-- Compact opacity slider: thin rounded track, accent fill left of the thumb, small round thumb
             (replaces the default WPF chrome that clashed with the dark overlay). -->
        <Style x:Key="OpacitySlider" TargetType="Slider">
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Skin.ControlBg}"
                                    BorderBrush="{DynamicResource Skin.SoftBorder}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Skin.Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="12" Height="12" CornerRadius="6" Cursor="Hand"
                                                        Background="{DynamicResource Skin.Fg}" BorderBrush="{DynamicResource Skin.Accent}" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="설정" Click="OnSettings"/>
            <MenuItem Header="종료" Click="OnExit"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border CornerRadius="6" Padding="{Binding Layout.PanelPadding}"
            TextElement.FontFamily="{Binding Settings.FontFamily, Converter={StaticResource FontConv}}">
        <!-- 미터 크기(배율): 루트에 LayoutTransform을 걸어 글자·행·여백까지 균일 확대/축소. SizeToContent=Height라
             높이는 스케일된 콘텐츠에 자동으로 다시 맞춰진다. 폭(Window.Width)은 사용자가 계속 드래그로 조절. -->
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.MeterScalePercent, Converter={StaticResource PercentScale}}"
                            ScaleY="{Binding Settings.MeterScalePercent, Converter={StaticResource PercentScale}}"/>
        </Border.LayoutTransform>
        <!-- ⚠️ 배경 기본값을 <Border.Background> 속성 요소로 두면 **로컬 값**이라 아래 트리거가 절대
             못 이긴다(계기판이 투명해지지 않았던 원인). 기본값도 Setter 로 내려야 트리거가 이긴다. -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Skin.OverlayBgColor}" Opacity="{Binding Settings.MeterOpacity}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- 계기판: 불투명 판때기를 지우되 완전 투명으로는 두지 않는다. 밝은 맵에서 글자가
                         곤란해진다는 실측 피드백이 있었고, 그렇다고 판을 깔면 이 레이아웃의 정체성이
                         사라진다. 위가 진하고 아래로 옅어지는 **그라디언트 스크림**이 그 사이를 잡는다 —
                         보스 HP% 와 상단 행이 가장 진한 바탕을 받고, 아래로 갈수록 게임이 비친다. -->
                    <DataTrigger Binding="{Binding Layout.ScrimPanel}" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <!-- ⚠️ 세로 선형으로는 부족했다 — 가장자리가 여전히 판때기로 남아
                                     "기존 UI 와 다를 게 없다"는 말을 들었다. 시안은 **라디얼**이고
                                     바깥이 완전히 투명해져 창 모양 자체가 사라진다. -->
                                <RadialGradientBrush Center="0.24,0.46" GradientOrigin="0.24,0.46"
                                                     RadiusX="0.72" RadiusY="1.25"
                                                     Opacity="{Binding Settings.MeterOpacity}">
                                    <GradientStop Color="{DynamicResource Skin.ScrimCore}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource Skin.ScrimEdge}" Offset="0.6"/>
                                    <GradientStop Color="Transparent" Offset="0.86"/>
                                </RadialGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <!-- 스크림도 판때기도 없는 레이아웃이 생기면 완전 투명. -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Layout.ShowPanelBackground}" Value="False"/>
                            <Condition Binding="{Binding Layout.ScrimPanel}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="Transparent"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 대기 중에는 Star — 행 목록이 비어 노는 공간을 대기 카드가 전부 쓴다. -->
                <RowDefinition Height="{Binding BossRowHeight}"/>
                <RowDefinition Height="{Binding RowsRowHeight}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="{Binding Layout.SectionGapBelow}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <!-- 한 덩어리 레이아웃은 구역 사이 틈이 없으므로 자기 여백을 스스로 갖는다. -->
                            <DataTrigger Binding="{Binding Layout.SeamlessSections}" Value="True">
                                <Setter Property="Margin" Value="11,7,11,7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- left: drag handle + opacity control (React Header left side) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            MouseLeftButtonDown="OnDragHandle" Background="Transparent">
                    <TextBlock Text="투명도" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <!-- Minimum=0 restores the old (1.7.x React) slider's full transparency range. MeterOpacity
                         feeds ONLY the panel background brush (line ~79), never Window.Opacity, so even at 0 the
                         rows/text/header buttons keep their own opacity and the window stays clickable. -->
                    <Slider Style="{StaticResource OpacitySlider}" Width="92" VerticalAlignment="Center" Minimum="0.0" Maximum="1.0"
                            SmallChange="0.05" LargeChange="0.1" Value="{Binding Settings.MeterOpacity, Mode=TwoWay}"/>
                </StackPanel>
                <!-- right: control buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- click-through lock badge: non-interactive, shown only while input pass-through is active
                         (React Header LockKeyhole). The window is WS_EX_TRANSPARENT then, so it's a pure visual cue. -->
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFD400"
                               VerticalAlignment="Center" Margin="2,0,6,0" IsHitTestVisible="False"
                               ToolTip="클릭스루 잠금 — 입력이 게임으로 통과 중"
                               Visibility="{Binding ClickThroughVisibility}"/>
                    <!-- update-available badge: only visible once an update is downloaded; click opens the
                         restart toast on demand (no auto-popup). -->
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE777;" Foreground="{DynamicResource Skin.Accent}"
                            Click="OnUpdateButton" ToolTip="{Binding UpdateTooltip}" Visibility="{Binding UpdateReadyVisibility}"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE771;" Click="OnThemeButton" ToolTip="테마 변경"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE72C;" Click="OnResetButton" ToolTip="전투 초기화"/>
                    <!-- 허수아비 테스트 토글: accent while ON (bound to the shared MeterSettings flag). -->
                    <Button Content="&#xE916;" Click="OnDummyTestButton"
                            ToolTip="허수아비 테스트 모드 — 켜면 허수아비 타격이 전투로 집계됩니다 (설정 › 허수아비)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.DummyTestMode}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Skin.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE8A7;" Click="OnTaskbarButton" ToolTip="작업표시줄 / Alt+Tab 모드"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE8FA;" Click="OnJoinButton" ToolTip="파티 신청"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE81C;" Click="OnHistoryButton" ToolTip="전투 기록"/>
                    <Button Style="{StaticResource HeaderIconButton}" Content="&#xE713;" Click="OnSettingsButton" ToolTip="설정"/>
                    <Button Style="{StaticResource HeaderCloseButton}" Content="&#xE8BB;" Click="OnExitButton" ToolTip="종료"/>
                </StackPanel>
            </Grid>

            <!-- 보스칸(타겟 정보). 마크업은 Controls/BossBarView.xaml 로 옮겼다 — 분리모드에서 같은
                 컨트롤을 독립 창에 그대로 얹기 위해서다. -->
            <controls:BossBarView Grid.Row="1"/>
            <!-- 행 목록. 마크업은 Controls/MeterRowsView.xaml 로 옮겼다(수치 무변경). ScrollViewer 를
                 '정리' 삼아 제거하지 마라 — v2.8.1 이 그렇게 오진했다. -->
            <controls:MeterRowsView Grid.Row="2"/>

            <!-- combat-timer pill (React CombatTimer.tsx): below the rows. 마크업은
                 Controls/CombatTimerBar.xaml 로 옮겼다 — 분리모드의 행 창이 같은 띠를 그대로 쓴다. -->
            <controls:CombatTimerBar Grid.Row="3"/>

            <Grid Grid.Row="4" Margin="{Binding Layout.SectionGapAbove}">
                <!-- 두 트리거가 한 Style 안에 있어야 한다 — Grid.Style 은 한 번만 설정할 수 있다.
                     ① 한 덩어리 레이아웃은 구역 사이 틈이 없으므로 자기 여백을 스스로 갖는다.
                     ② 판때기가 옅어지는 레이아웃에서는 푸터가 스크림 끝자락에 놓여 묻히므로 칸 전체에
                        그림자 하나를 걸어 배경과 무관하게 읽히게 한다. -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Layout.SeamlessSections}" Value="True">
                                <!-- 시안의 두 번째 띠. 타이머 띠 아래에 헤어라인으로 이어 붙고, 바닥에
                                     너무 붙지 않게 아래 여백을 조금 더 준다(패널 라운드에 글자가 닿는다). -->
                                <Setter Property="Margin" Value="13,6,13,8"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Layout.EtchText}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.95" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- left: capture / recognized status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RecognizedStatus}" Foreground="{Binding CombatStatusBrush}" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding RecognizedVisibility}"/>
                </StackPanel>
                <!-- right: resource badges (오드 / 슈고 열쇠 / ping) with icons, pinned to the footer's right end -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 오드: the game's own 오드 에너지 icon + 자연회복(+추가) -->
                    <!-- Clickable: opens the per-character 오드 list. MouseLeftButtonUp on the Border (not a
                         Button) matches the row-click pattern above and keeps the footer's height unchanged —
                         a Button's default template would add chrome and risk the SizeToContent regression. -->
                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" VerticalAlignment="Center" Cursor="Hand" Visibility="{Binding AetherVisibility}"
                            MouseLeftButtonUp="OnAetherBadgeClick" ToolTip="{Binding AetherToolTip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layout.StatChrome}" Value="False">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/WaffleMeter.App.Wpf;component/Icons/ode.png"
                                   Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding AetherText}" Foreground="#7EE7FF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- 슈고 페스타 열쇠: a gold key icon + base(+bonus) -->
                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" VerticalAlignment="Center" Visibility="{Binding ShugoKeyVisibility}" ToolTip="슈고 페스타 열쇠">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layout.StatChrome}" Value="False">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 3,0 A 3,3 0 1 0 3.01,0 M 4,4 L 4,10 M 4,7 L 6.5,7" Stroke="#FFD98A" StrokeThickness="1.4"
                                  Width="10" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ShugoKeyText}" Foreground="#FFD98A" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- server latency (ping) -->
                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" VerticalAlignment="Center" Visibility="{Binding PingVisibility}" ToolTip="게임 서버 응답속도">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Skin.StatBg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layout.StatChrome}" Value="False">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding PingText}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
