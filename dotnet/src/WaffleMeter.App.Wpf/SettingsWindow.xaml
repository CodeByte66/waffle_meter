<Window x:Class="WaffleMeter.App.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
        xmlns:controls="clr-namespace:WaffleMeter.App.Wpf.Controls"
        Title="설정" Width="760" Height="560" MinWidth="640" MinHeight="440"
        Background="{DynamicResource Skin.WindowBg}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WaffleMeter.App.Wpf;component/Themes/Skin.Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:StringEqualsToVisibilityConverter x:Key="NavVis"/>
            <local:FontFamilyConverter x:Key="FontConv"/>
            <local:RatioToStarConverter x:Key="RatioToStar"/>
            <!-- day-of-week toggle chip for custom alarms: matches the meter chip aesthetic (dim when off,
                 subtle accent fill + accent border/text when on), instead of the default square CheckBox. -->
            <Style x:Key="DayChip" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="b" CornerRadius="6" BorderThickness="1" Opacity="0.5"
                                    Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}">
                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{DynamicResource Skin.Fg}"
                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="1.0"/>
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.AccentSoft}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                    <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Skin.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Buff-preset slot chip: DayChip's look, sized to hold a slot name. No GroupName — the preset
                 bar is rendered on two tabs at once and WPF groups by name across the whole window, which
                 would make the two bars fight. The view-model clears the other chips instead. -->
            <Style x:Key="PresetChip" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="MinWidth" Value="92"/>
                <Setter Property="MaxWidth" Value="150"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" CornerRadius="6" BorderThickness="1" Opacity="0.5" Padding="10,0"
                                    Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}">
                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{DynamicResource Skin.Fg}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="1.0"/>
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.AccentSoft}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                    <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Skin.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Font picker card. PresetChip's visual language ('one of many'), with one deliberate
                 difference: NO dim-when-unselected. On a chip, dim reads as "off"; here every card is a live
                 preview of its own font, so dimming them would fight the entire point of the grid. If a later
                 pass "restores consistency" by adding Opacity 0.5 back, it has re-broken the feature. -->
            <Style x:Key="FontCard" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="b" CornerRadius="6" BorderThickness="1" Padding="10,5"
                                    Background="{DynamicResource Skin.RowBg}" BorderBrush="{DynamicResource Skin.SoftBorder}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.RowHover}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Skin.Border}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.AccentSoft}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Skin.Accent}"/>
                                    <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="b" Property="Padding" Value="9,4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Two lines, both in the offered font: the name (is this face readable?) and a digits+Hangul
                 sample (do the numerals read at a glance?). Digits matter — the meter is mostly numbers.
                 The badge is pinned to Segoe UI on purpose: the window root inherits the SELECTED font, so an
                 unpinned badge would render in whatever the user picked and look inconsistent card to card. -->
            <DataTemplate x:Key="FontCardTemplate">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontFamily="{Binding Preview}" FontSize="13"
                                   Foreground="{DynamicResource Skin.Fg}" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" CornerRadius="3" Padding="4,0" Margin="4,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource Skin.StatBg}"
                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Badge}" FontFamily="Segoe UI" FontSize="9.5"
                                       Foreground="{DynamicResource Skin.MutedFg}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding SampleText}" FontFamily="{Binding Preview}" FontSize="11.5"
                               Foreground="{DynamicResource Skin.MutedFg}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
            </DataTemplate>
            <!-- The preset bar, shown on both buff tabs (a preset spans them), so it lives here once. -->
            <DataTemplate x:Key="BuffPresetBar">
                <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                        Background="{DynamicResource Skin.RowBg}" BorderThickness="1"
                        BorderBrush="{DynamicResource Skin.SoftBorder}">
                    <StackPanel>
                        <TextBlock Text="버프 오버레이 프리셋" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="버프 오버레이 설정을 슬롯 3개에 저장합니다. 슬롯을 고르면 바로 적용되고, 이후 바꾼 설정은 그 슬롯에 자동 저장됩니다. (오버레이 켬/끔은 프리셋과 무관)"
                                   Style="{StaticResource SettingDesc}" Margin="0,0,0,9"/>
                        <ItemsControl ItemsSource="{Binding PresetSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource PresetChip}" Content="{Binding Name}"
                                                 IsChecked="{Binding IsActive, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="이름" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontSize="12" Foreground="{DynamicResource Skin.MutedFg}"/>
                            <TextBox Grid.Column="1" Height="30" Padding="8,4" MaxLength="20"
                                     VerticalContentAlignment="Center" KeyDown="OnPresetNameKeyDown"
                                     Text="{Binding ActivePresetName, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <!-- 쿨타임 프리셋 바. 버프 바와 마크업은 쌍둥이지만 바인딩 이름이 다르다(CooldownPresetSlots /
                 ActiveCooldownPresetName) — 같은 이름을 쓰면 두 바가 서로의 컬렉션을 그린다. PresetChip 에
                 GroupName 이 없는 것도 그래서다: WPF 는 GroupName 을 창 전체에서 묶으므로 붙이는 순간 버프
                 칩과 쿨타임 칩이 서로를 끈다. 활성 표시는 뷰모델이 직접 한다. -->
            <DataTemplate x:Key="CooldownPresetBar">
                <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                        Background="{DynamicResource Skin.RowBg}" BorderThickness="1"
                        BorderBrush="{DynamicResource Skin.SoftBorder}">
                    <StackPanel>
                        <TextBlock Text="쿨타임 오버레이 프리셋" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="표시할 스킬과 오버레이 외형을 슬롯 3개에 저장합니다. 슬롯을 고르면 바로 적용되고, 이후 바꾼 설정은 그 슬롯에 자동 저장됩니다. (오버레이 켬/끔은 프리셋과 무관)"
                                   Style="{StaticResource SettingDesc}" Margin="0,0,0,9"/>
                        <ItemsControl ItemsSource="{Binding CooldownPresetSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource PresetChip}" Content="{Binding Name}"
                                                 IsChecked="{Binding IsActive, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="이름" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontSize="12" Foreground="{DynamicResource Skin.MutedFg}"/>
                            <TextBox Grid.Column="1" Height="30" Padding="8,4" MaxLength="20"
                                     VerticalContentAlignment="Center" KeyDown="OnPresetNameKeyDown"
                                     Text="{Binding ActiveCooldownPresetName, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <!-- HotkeyCaptureBox is a TextBox subclass, so the implicit TextBox style (Skin.Controls)
                 doesn't auto-apply; inherit it so the hotkey inputs match the other dark controls. -->
            <Style TargetType="{x:Type local:HotkeyCaptureBox}" BasedOn="{StaticResource {x:Type TextBox}}"/>
            <!-- 단축키 한 칸이 지금 실제로 안 먹는 사유를 그 줄에서 알린다. 종전에는 두 사유(옛 조합 은퇴 /
                 다른 프로그램과 충돌해 등록 실패) 모두 완전히 무음이라, 사용자에겐 "설정엔 들어가 있는데
                 안 먹는다"로만 보였다. 문구가 비면 줄 자체가 사라진다(Collapsed). -->
            <Style x:Key="HotkeyWarning" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FF7A7A"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,3,12,0"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- 단축키 미지정(지우기) 버튼. The X is drawn as a vector Path, NOT a glyph: the bound theme
                 font (e.g. NEXON Lv2 Gothic) lacks U+2715/✕, so a text "✕" renders as a tofu/fallback. -->
            <Style x:Key="HotkeyClearButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="ToolTip" Value="미지정 (단축키 사용 안 함)"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="5">
                                <Path HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10" Stretch="None"
                                      Stroke="{DynamicResource Skin.Fg}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,0 L10,10 M10,0 L0,10"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.ControlHover}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.ControlBg}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Reusable hover-help "?" dot (same visual as the 단축키 help marker). Put a Border with
                 this style next to a control and give it a Border.ToolTip for the explanation. -->
            <Style x:Key="HelpDot" TargetType="Border">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Cursor" Value="Help"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource Skin.AccentSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Skin.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
                <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            </Style>
            <Style x:Key="HelpQ" TargetType="TextBlock">
                <Setter Property="Text" Value="?"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource Skin.Accent}"/>
            </Style>

            <!-- 브랜드 색을 그대로 채우는 링크 버튼(Discord 등). 기본 버튼 크롬을 쓰면 스킨의 회색 테두리가
                 얹혀 브랜드 색이 죽는다. -->
            <Style x:Key="BrandButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.86"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.72"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 좌측 탭 줄 맨 아래에 붙는 '탭처럼 보이는' 링크 버튼. NavItem(ListBoxItem) 템플릿을 Button으로
                 옮겨 온 것 — 탭 목록의 항목이 아니라 바깥으로 나가는 링크라 ListBoxItem으로 만들면 선택
                 상태가 생겨 "지금 이 탭을 보고 있다"는 거짓 신호를 준다. -->
            <Style x:Key="NavLinkButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,9" Margin="0,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Skin.ControlHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid TextElement.Foreground="{DynamicResource Skin.Fg}"
          TextElement.FontFamily="{Binding FontFamily, Converter={StaticResource FontConv}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- body: nav rail + content -->
        <Grid Grid.Row="0" Margin="10,14,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- x:Name is for the constructor's nav-contract check (SettingsWindow.xaml.cs), not for styling.
                 Tag values here, each panel's ConverterParameter below, and SettingsViewModel.NavKeys are three
                 copies of one table; the check exists because a drift between them shows no error at all — the
                 converter just collapses everything and the right-hand side goes blank. -->
            <ListBox x:Name="NavRail" Grid.Row="0" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
                     SelectedValuePath="Tag" SelectedValue="{Binding SelectedNav}" Margin="6,0,6,0"
                     SelectionChanged="OnNavChanged">
                <ListBox.Resources>
                    <!-- 2-line nav item: title + a dim one-line summary of what the section holds -->
                    <Style x:Key="NavTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource Skin.Fg}"/>
                    </Style>
                    <Style x:Key="NavSub" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10.5"/>
                        <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
                        <Setter Property="Margin" Value="0,1,0,0"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                </ListBox.Resources>
                <ListBoxItem Tag="display">
                    <StackPanel><TextBlock Text="미터 화면" Style="{StaticResource NavTitle}"/><TextBlock Text="표시 형식 · 크기 · 글꼴" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="theme">
                    <StackPanel><TextBlock Text="색상 · 스킨" Style="{StaticResource NavTitle}"/><TextBlock Text="스킨 · 유저 이름 색상" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="window">
                    <StackPanel><TextBlock Text="창 동작" Style="{StaticResource NavTitle}"/><TextBlock Text="표시 조건 · 위치 · 패널" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="buffs">
                    <StackPanel><TextBlock Text="버프 오버레이" Style="{StaticResource NavTitle}"/><TextBlock Text="표시 · 음성 · 직업별" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="cooldown">
                    <StackPanel><TextBlock Text="스킬 쿨타임" Style="{StaticResource NavTitle}"/><TextBlock Text="오버레이 · 스킬 선택" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="alarms">
                    <StackPanel><TextBlock Text="알림" Style="{StaticResource NavTitle}"/><TextBlock Text="소리 · 슈고 · 필드보스" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="battle">
                    <StackPanel><TextBlock Text="전투 집계" Style="{StaticResource NavTitle}"/><TextBlock Text="집계 · 허수아비 · 리플레이" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="hotkeys">
                    <StackPanel><TextBlock Text="단축키" Style="{StaticResource NavTitle}"/><TextBlock Text="초기화 · 표시 · 클릭 통과" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="stats">
                    <StackPanel><TextBlock Text="내 캐릭터 · 통계" Style="{StaticResource NavTitle}"/><TextBlock Text="동의 · 공개 · 전투 기록" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <!-- 강조 탭: 제목을 액센트 색으로 칠하고 왼쪽에 얇은 액센트 레일을 둔다. 선택 스타일
                     (NavItem)은 건드리지 않으므로 선택/호버 동작은 나머지 탭과 완전히 같다. -->
                <ListBoxItem Tag="mystats">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,1,8,1"
                                Background="{DynamicResource Skin.Accent}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="내 스탯" Style="{StaticResource NavTitle}" Foreground="{DynamicResource Skin.Accent}"/>
                            <TextBlock Text="스탯 확인 · 계산기로 넘기기" Style="{StaticResource NavSub}"/>
                        </StackPanel>
                    </Grid>
                </ListBoxItem>
                <ListBoxItem Tag="gameopt">
                    <StackPanel><TextBlock Text="게임 최적화" Style="{StaticResource NavTitle}"/><TextBlock Text="Engine.ini · 렉 감소" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="advanced">
                    <StackPanel><TextBlock Text="고급 · 진단" Style="{StaticResource NavTitle}"/><TextBlock Text="캡처 · 렌더링 · 로그" Style="{StaticResource NavSub}"/></StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- 탭 줄 맨 아래의 '와터기' — 탭처럼 보이지만 눌리면 통계 웹서비스를 브라우저로 연다.
                 위 목록과 구분되도록 얇은 구분선을 두고, 바깥으로 나간다는 표시를 오른쪽에 붙였다. -->
            <Button Grid.Row="1" Style="{StaticResource NavLinkButton}" Margin="6,6,6,2" Click="OnOpenStatsWeb"
                    ToolTip="전투 기록과 통계를 볼 수 있는 웹서비스를 브라우저로 엽니다.">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="와터기" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Skin.Fg}"/>
                        <TextBlock Text="전투 기록 통계 웹" FontSize="10.5" Margin="0,1,0,0"
                                   Foreground="{DynamicResource Skin.MutedFg}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Skin.MutedFg}"/>
                </Grid>
            </Button>
            </Grid>

            <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,0,12,0">
                <Grid>
                    <!-- ===== 미터 화면 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=display}">
                        <TextBlock Text="표시 설정" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="표시 형식" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="DPS 카드의 정보 조합을 전환합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding DisplayModes}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding DisplayMode}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="딜량 기준" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="딜량을 DPS로 볼지 누적 피해량으로 볼지 선택합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding DamageValueModes}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding DamageValueMode}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="DPS 종류" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="nDPS는 남이 걸어준 버프 몫을 걷어낸 값, rDPS는 거기에 내가 파티에 얹어준 몫을 더한 값입니다. 순서와 게이지도 같이 바뀝니다. (딜량 기준이 '누적 피해량'이면 적용되지 않습니다)" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding RowDpsMetrics}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding RowDpsMetric}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="기여도 표시 방식" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="파티 기여도 또는 보스 체력 기여도로 표시합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding ContributionModes}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding ContributionMode}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="아이디 표기" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="다른 플레이어 이름의 표시 범위를 선택합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding NameDisplays}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding NameDisplay}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14" IsEnabled="{Binding ServerTagEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="서버 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="닉네임 옆에 서버 약칭을 [ ] 안에 표시합니다." Style="{StaticResource SettingDesc}"/>
                                <!-- 계기판은 이름 뒤 서버를 아예 넣지 않는다. 잠그지 않으면 켜 둔 토글이 아무 일도
                                     안 해서 "껐는데 왜 그대로냐"의 반대 오해가 생긴다. 저장값은 건드리지 않는다. -->
                                <TextBlock Text="이 레이아웃은 이름 뒤에 서버를 넣지 않습니다 — 다른 레이아웃으로 바꾸면 다시 켤 수 있습니다."
                                           Style="{StaticResource SettingDesc}"
                                           Visibility="{Binding ServerTagEnabled, Converter={StaticResource BoolToVisInverse}}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowServerTag}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="보스 표시 형식" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="타겟 바의 보스 체력 표기 방식을 선택합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding TargetInfoDisplayModes}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding TargetInfoDisplayMode}"/>
                        </Grid>

                        <!--
                            투명도. 미터 헤더에도 같은 슬라이더가 있고, UI 분리모드에선 그 헤더가 사라지므로
                            여기가 유일한 조절 수단이 된다.
                            🔑 헤더와 **완전히 같은 경로**(Settings.MeterOpacity)로 묶는다 — 뷰모델 래퍼를 쓰면
                               헤더에서 끌었을 때 이쪽이 안 따라와 두 슬라이더가 다른 값을 가리키게 된다.
                        -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Settings.MeterOpacity, StringFormat='투명도 — {0:P0}'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="미터 판의 배경 투명도입니다. 0이어도 글자와 게이지는 그대로 보이고 창도 계속 눌립니다. 미터 헤더의 슬라이더와 같은 값입니다."
                                           Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0.0" Maximum="1.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding Settings.MeterOpacity, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock x:Name="LayoutSectionHeader" Text="레이아웃" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="미터 전체의 생김새를 고릅니다. TYPE A 는 보스 체력을 독립 게이지 띠로 크게, TYPE B 는 판을 없애고 체력 퍼센트를 크게, TYPE C 는 행을 틈 없이 붙여 하나의 판으로 보여줍니다. 고르면 행 높이도 그 레이아웃 기본값으로 함께 바뀝니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding MeterLayouts}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding MeterLayoutId}"/>
                        </Grid>

                        <!-- 레이아웃 미리보기. 고른 레이아웃이 실제로 어떻게 그려지는지 + 무엇을 레이아웃이
                             정하고 무엇이 잠기는지. 콤보를 바꾸면 세 덩어리가 함께 바뀐다. -->
                        <controls:LayoutPreviewCard DataContext="{Binding LayoutPreview}" Margin="0,0,0,10"/>
                        <Grid x:Name="LayoutNotesAnchor" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="이 레이아웃이 정하는 것" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Skin.Fg}" Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding LayoutTraits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                           Foreground="{DynamicResource Skin.MutedFg}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{DynamicResource Skin.Fg}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 잠기는 설정이 없는 레이아웃(전장)에서는 제목째 접는다 — 빈 칸에 제목만 남으면
                                 "뭔가 잠겼는데 안 보이나" 로 읽힌다. -->
                            <StackPanel Grid.Column="1" Visibility="{Binding LayoutLocksVisibility}">
                                <TextBlock Text="잠기는 설정" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Skin.Accent}" Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding LayoutLocks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Skin.Fg}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Skin.MutedFg}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="저장한 값은 그대로 남습니다 — 다른 레이아웃으로 돌아가면 되살아납니다."
                                           Style="{StaticResource SettingDesc}" FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="UI 분리모드" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="보스칸과 미터 행을 각각 독립된 창으로 떼어내 화면 어디에나 둘 수 있습니다. 켜면 본체 창은 숨고 헤더·푸터가 사라집니다 — 전투 기록과 설정은 보스칸 오른쪽 위 버튼으로, 나머지 기능은 설정 창 안에서 씁니다. 전투 타이머 한 줄은 행 창 아래에 남습니다. 두 창은 빈 곳을 끌어 옮기고, 자리를 잃으면 화면 탭의 &quot;미터기 위치&quot; 되돌리기로 함께 돌아옵니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SplitUiMode}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14" IsEnabled="{Binding BarStyleEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="게이지 형태" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="피해량·보스 체력 막대의 표시 형태를 선택합니다 (칸 채우기 / 얇은 바 / 없음)." Style="{StaticResource SettingDesc}"/>
                                <!-- 계기판·무대는 직업색 게이지가 곧 행이라 '얇은 바'·'표시 안 함'이면 빈 리본이 된다.
                                     저장값은 그대로 두고 UI 만 잠그므로, 전장으로 돌아가면 고른 값이 되살아난다. -->
                                <TextBlock Text="이 레이아웃은 칸 채우기를 전제로 합니다 — TYPE A 로 바꾸면 다시 고를 수 있습니다."
                                           Style="{StaticResource SettingDesc}"
                                           Visibility="{Binding BarStyleEnabled, Converter={StaticResource BoolToVisInverse}}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding BarStyles}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding BarStyle}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding MaxVisibleRows, StringFormat='표시 인원 — {0}명'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="딜 순위 상위 인원만 표시합니다 (본인은 순위와 무관하게 항상 표시). 전체 집계는 그대로 유지됩니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="1" Maximum="10" Value="{Binding MaxVisibleRows}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </Grid>
                        <Grid Margin="0,14,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="사망 중 행 흐리게" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="파티원이 죽어 있는 동안 그 행을 흐리게 표시합니다. 부활하거나 다시 딜을 넣으면 바로 원래대로 돌아옵니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DimDeadRows}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="크기와 글꼴" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="FontSectionHeader" Text="글꼴" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="각 카드가 그 글꼴로 그려집니다. 눌러 보면 미터에 바로 적용돼요." Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                        <!-- ListBox(WrapPanel)인 이유: 좌측 nav 와 같은 '여럿 중 하나' 컨트롤이라 선택 동작을
                             그대로 물려받는다.
                             ⚠️ Template 을 ItemsPresenter 하나로 갈아끼운 건 스타일이 아니라 동작 때문이다.
                             ListBox 기본 템플릿의 ScrollViewer 는 스크롤할 내용이 없어도 MouseWheel 을
                             Handled 로 표시해서, 카드 위에 커서가 있으면 휠이 바깥 ContentScroll 까지
                             올라가지 못하고 설정창이 통째로 안 굴러간다. ScrollBarVisibility="Disabled" 로는
                             안 막힌다 — 스크롤바만 숨을 뿐 이벤트는 여전히 그 ScrollViewer 가 먹는다.
                             내부 스크롤 호스트를 아예 없애야 휠이 정상적으로 버블링된다. -->
                        <ListBox x:Name="FontCardList" ItemsSource="{Binding FontCards}" ItemContainerStyle="{StaticResource FontCard}"
                                 ItemTemplate="{StaticResource FontCardTemplate}"
                                 SelectedValuePath="Value" SelectedValue="{Binding CardFontSelection}"
                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"
                                 KeyboardNavigation.DirectionalNavigation="Contained">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter/>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <!-- 2열 × 252px. 3열(≈176px)도 폭은 맞지만 'Spoqa Han Sans Neo (Bold)' 같은
                                     이름이 잘린다 — 어느 글꼴인지 못 읽는 미리보기는 미리보기가 아니다. -->
                                <ItemsPanelTemplate><WrapPanel ItemWidth="252" ItemHeight="52"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="시스템 글꼴" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="이 PC에 설치된 글꼴을 그대로 씁니다. 고르면 아래 미리보기에 바로 반영돼요." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" MaxDropDownHeight="280"
                                      IsTextSearchEnabled="True" ItemsSource="{Binding SystemFontFamilies}"
                                      SelectedValue="{Binding SystemFontSelection}"/>
                        </Grid>

                        <!-- 현재 글꼴 미리보기: 카드로 고르든 시스템 목록으로 고르든 '지금 적용된 것'을 한 줄로
                             보여준다. 시스템 글꼴은 카드가 없으므로 이 줄이 유일한 미리보기 수단이다. -->
                        <Border Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentFontStatus}" Style="{StaticResource SettingDesc}"
                                           FontFamily="Segoe UI" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentFontSample}" FontSize="17"
                                           FontFamily="{Binding CurrentFontPreview}" Foreground="{DynamicResource Skin.Fg}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                            <Button Content="글꼴 폴더 열기" Click="OnOpenFontsFolder" Margin="0,0,8,0"
                                    ToolTip="추가한 글꼴 파일이 있는 폴더입니다. 여기서 지우면 목록에서도 빠집니다."/>
                            <Button Content="커스텀 폰트 추가…" Click="OnAddCustomFont"
                                    ToolTip="ttf/otf 파일을 선택해 목록에 추가하고 바로 적용합니다"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="미터 크기" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="미터 전체(글자·행·여백)를 균일하게 확대/축소합니다. 폭은 창 가장자리를 끌어 조절합니다." Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MeterScaleHint}" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding MeterScales}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding MeterScalePercent}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding RowHeight, StringFormat='행 높이 — {0}px'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="미터 한 줄의 높이입니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="24" Maximum="80" Value="{Binding RowHeight}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </Grid>

                        <!-- 보스칸 높이. 100% 기준 높이가 레이아웃마다 달라서(전장 104 / 계기판 52 / 무대 70)
                             눈금 단위는 px 가 아니라 배율이다 — 대신 제목이 지금 레이아웃에서의 실제 px 를
                             함께 말한다. 칸 높이와 칸 안 치수에 **같은** 배율이 걸리므로 어느 값에서도
                             여백 비율이 100% 와 같고 글자가 잘리지 않는다. -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding BossSlotHeightHint}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="보스 HP 칸의 높이입니다. 칸 안의 보스 이름·체력 숫자·게이지도 같은 비율로 커지고 작아집니다." Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="70" Maximum="150"
                                    Value="{Binding BossSlotScalePercent}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="상태 표시" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="오드 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="인식된 캐릭터 옆에 오드 잔량을 표시합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowAetherStatus}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="서버 응답속도 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="인식된 캐릭터 옆에 게임 서버까지의 응답속도(ms)를 표시합니다. VPN/부스터 사용 시 로컬 홉으로 표시될 수 있습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowLatencyIndicator}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock x:Name="TierSectionHeader" Text="던전 티어" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="티어 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="던전별 등급을 순위·직업 뱃지와 행 테두리에 표시합니다. 저사양 모드에서는 효과 없이 테두리만 그려요." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding TierEffectModes}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding TierEffects}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14" IsEnabled="{Binding TierDetailEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="파티원 티어 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="파티원 행에도 등급 테두리와 '상위 X.X%'를 표시합니다. 끄면 본인 행에만 표시돼요." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TierShowOthers}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14" IsEnabled="{Binding TierDetailEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="전투 시간 옆 요약 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="미터 아래 전투 시간 옆에 '챌린저 · 상위 0.7%' 형태로 내 등급을 함께 보여줍니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TierShowSelfChip}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="티어 갱신" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="{Binding TierStatus}" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="갱신" VerticalAlignment="Center" Padding="14,6" Click="OnRefreshTier"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="컴팩트 모드" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="컴팩트 모드" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="타겟 바와 전투 시간 바를 숨겨 미터기를 작게 표시합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsMinimal}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="컴팩트 모드 중 전투 시간 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="컴팩트 모드에서도 전투 시간 바를 유지합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowCombatTimerInMinimal}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="컴팩트 모드 중 보스 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="컴팩트 모드에서도 타겟(보스) 바를 유지합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTargetInfoInMinimal}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="성능" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding RefreshIntervalMs, StringFormat='갱신 주기 — {0}ms'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="값이 클수록 숫자 반영은 느려지지만 전투 중 CPU·화면 부담이 줄어듭니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="100" Maximum="1000" Value="{Binding RefreshIntervalMs}"
                                    TickFrequency="100" IsSnapToTickEnabled="True" IsEnabled="{Binding RefreshSliderEnabled}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="저사양 모드" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="켜면 갱신 주기를 500ms로 고정해 게임 프레임을 우선합니다. 딜 집계 방식은 그대로 유지됩니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LowSpecMode}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="업데이트" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Version, StringFormat='현재 버전 — v{0}'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="최신 버전을 확인하고 백그라운드에서 내려받습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="업데이트 확인" Click="OnCheckUpdate" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== 색상 · 스킨 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=theme}">
                        <TextBlock Text="스킨" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="스타일 (스킨)" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="앱 전체의 색 테마 프리셋입니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding Skins}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Name" SelectedValue="{Binding Skin}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="테마 색상" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock Text="유저 이름 색상" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="천족" VerticalAlignment="Center"/>
                            <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.ServerAColor, Mode=TwoWay}"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="마족" VerticalAlignment="Center"/>
                            <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.ServerBColor, Mode=TwoWay}"/></Grid>

                        <TextBlock Text="미터 바 색상" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="색상 방식" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="200" ItemsSource="{Binding BarColorModes}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding Theme.BarColorMode, Mode=TwoWay}"/></Grid>
                        <!-- 내 캐릭터(본인) 색은 두 모드 모두에서 사용 -->
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="내 캐릭터" VerticalAlignment="Center"/>
                            <controls:GradientRowControl Grid.Column="1" FromColor="{Binding Theme.UserBarFrom, Mode=TwoWay}" ToColor="{Binding Theme.UserBarTo, Mode=TwoWay}"/></Grid>

                        <!-- 본인 강조: 기여도 티어 색 -->
                        <StackPanel Visibility="{Binding Theme.BarColorMode, Converter={StaticResource NavVis}, ConverterParameter=self}">
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="일반" VerticalAlignment="Center"/>
                                <controls:GradientRowControl Grid.Column="1" FromColor="{Binding Theme.NormalBarFrom, Mode=TwoWay}" ToColor="{Binding Theme.NormalBarTo, Mode=TwoWay}"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="경고 (기여도 5% 미만)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <controls:GradientRowControl Grid.Column="1" FromColor="{Binding Theme.WarningBarFrom, Mode=TwoWay}" ToColor="{Binding Theme.WarningBarTo, Mode=TwoWay}"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="에러 (기여도 3% 미만)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <controls:GradientRowControl Grid.Column="1" FromColor="{Binding Theme.ErrorBarFrom, Mode=TwoWay}" ToColor="{Binding Theme.ErrorBarTo, Mode=TwoWay}"/></Grid>
                        </StackPanel>

                        <!-- 직업 강조: 직업별 색 (기본값 = 조인 패널과 동일 팔레트) -->
                        <StackPanel Visibility="{Binding Theme.BarColorMode, Converter={StaticResource NavVis}, ConverterParameter=job}">
                            <TextBlock Text="직업별 색상" Style="{StaticResource Label}" Margin="0,8,0,4"/>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="검성" VerticalAlignment="Center"/>
                                <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.JobBarGladiator, Mode=TwoWay}"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="수호성" VerticalAlignment="Center"/>
                                <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.JobBarTemplar, Mode=TwoWay}"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="궁성" VerticalAlignment="Center"/>
                                <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.JobBarRanger, Mode=TwoWay}"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="살성" VerticalAlignment="Center"/>
                                <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.JobBarAssassin, Mode=TwoWay}"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="마도성" VerticalAlignment="Center"/>
                                <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.JobBarSorcerer, Mode=TwoWay}"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="치유성" VerticalAlignment="Center"/>
                                <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.JobBarCleric, Mode=TwoWay}"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="정령성" VerticalAlignment="Center"/>
                                <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.JobBarElementalist, Mode=TwoWay}"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="호법성" VerticalAlignment="Center"/>
                                <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.JobBarChanter, Mode=TwoWay}"/></Grid>
                        </StackPanel>

                        <TextBlock Text="미터 텍스트 색상" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="누적 / 전투력" VerticalAlignment="Center"/>
                            <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.MeterStatAmount, Mode=TwoWay}"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DPS / 피해량" VerticalAlignment="Center"/>
                            <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.MeterStatDps, Mode=TwoWay}"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="퍼센트" VerticalAlignment="Center"/>
                            <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.MeterStatPercent, Mode=TwoWay}"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="전투 시간" VerticalAlignment="Center"/>
                            <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.CombatTimeColor, Mode=TwoWay}"/></Grid>

                        <TextBlock Text="보스 / 전투 기록" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="타겟 / 전투 기록" VerticalAlignment="Center"/>
                            <controls:GradientRowControl Grid.Column="1" FromColor="{Binding Theme.BossBarFrom, Mode=TwoWay}" ToColor="{Binding Theme.BossBarTo, Mode=TwoWay}"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="남은 체력 / 경과 시간" VerticalAlignment="Center"/>
                            <controls:ColorSwatchButton Grid.Column="1" Color="{Binding Theme.BossRightValue, Mode=TwoWay}"/></Grid>

                        <Button Content="테마 색상 초기화" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnResetTheme"/>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock x:Name="NameFxSectionHeader" Text="닉네임 스킨" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock Text="후원해 주신 분과 상위 랭커의 닉네임에 붙는 스킨입니다. 미터의 기능·정확도·통계에는 어떤 차이도 없습니다."
                                   Style="{StaticResource SettingDesc}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <!-- 받는 방법을 여기에 적는 이유: 부여는 서버가 하고 미터에는 신청 경로가 없다.
                             이 안내가 없으면 스킨을 본 사람이 "나는 왜 없지"에서 멈춘다. -->
                        <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="후원자 스킨은 후원하신 뒤 디스코드 Waffle 에게 캐릭터명과 서버를 DM 으로 보내 주시면 달아 드립니다. 랭커 스킨은 던전 하나라도 티어가 마스터 이상이면 자동으로 붙습니다."/>
                        <Button Content="디스코드 열기" HorizontalAlignment="Left" Margin="0,0,0,12" Click="OnOpenDiscord"/>

                        <!-- 내 스킨 고르기. 자격이 없어도 숨기지 않고 못 고르게만 한다 — 무엇이 있는지
                             보이지 않으면 "받으면 뭐가 생기는지" 를 알 수 없다. 자격 판정은 서버가 이미
                             명단의 k 로 내려보냈고 여기서는 그 결과만 읽는다. -->
                        <Border Margin="0,4,0,12" IsEnabled="{Binding MyFxEnabled}"
                                Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="내 스킨 고르기" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="{Binding MyFxStatus}" Style="{StaticResource SettingDesc}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <ItemsControl ItemsSource="{Binding MyEffectChoices}" Opacity="{Binding MyFxOpacity}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 이름 대신 스킨이 입혀진 샘플 그대로. 고르는 근거가 색이므로
                                                 라벨은 같은 말을 한 번 더 하는 것에 가깝다. -->
                                            <Button Tag="{Binding Id}" Click="OnPickMyNameFx" Margin="0,0,6,6"
                                                    Padding="10,5" Cursor="Hand" ToolTip="{Binding Name}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="와플장인" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{Binding Fill}"/>
                                                    <TextBlock Text=" ✓" Foreground="{DynamicResource Skin.Accent}"
                                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="DPS 게이지 스킨" Style="{StaticResource SettingDesc}"
                                           Margin="0,6,0,4" Visibility="{Binding MyGaugeVisibility}"/>
                                <ItemsControl ItemsSource="{Binding MyGaugeChoices}" Visibility="{Binding MyGaugeVisibility}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Id}" Click="OnPickMyGauge" Margin="0,0,6,6"
                                                    Padding="10,5" Cursor="Hand" ToolTip="{Binding Name}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="34" Height="13" CornerRadius="3" VerticalAlignment="Center"
                                                            Background="{Binding Fill}"/>
                                                    <TextBlock Text=" ✓" Foreground="{DynamicResource Skin.Accent}"
                                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 누른 결과와, 왜 지금은 안 바뀌는지. 픽커 바로 아래여야 한다 — 아래쪽
                                     '후원자 목록 갱신' 줄에 두었을 때는 미리보기 카드와 슬라이더에 밀려
                                     사유가 스크롤 밖이었고, 그래서 실패가 통째로 조용했다. -->
                                <TextBlock Text="{Binding MyFxNotice}" Style="{StaticResource SettingDesc}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding MyFxNoticeVisibility}"/>
                            </StackPanel>
                        </Border>


                        <!-- 미리보기: 부여는 서버가 하므로, 이게 없으면 사용자는 이 설정이 무엇을 바꾸는지 볼
                             방법이 없다. 애니메이션 샘플은 미터 행과 '같은 브러시 인스턴스'를 쓰므로 별도
                             근사가 아니라 실물과 정확히 같이 움직인다. -->
                        <ItemsControl ItemsSource="{Binding NameFxSamples}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Skin.RowBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8" Width="164">
                                        <StackPanel>
                                            <TextBlock Text="와플장인" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Fill}"/>
                                            <!-- 효과 이름은 뺐다. 스킨은 보고 고르는 것이고, 이름표는 같은 정보를
                                                 두 번 말하면서 카드를 좁게 만든다. 계열(후원자/랭커)만 남긴다 —
                                                 그건 색만 봐서는 알 수 없는 정보다. -->
                                            <TextBlock Text="{Binding Kind}" FontFamily="Segoe UI" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Skin.Accent}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="DPS 게이지 스킨" Style="{StaticResource Label}" Margin="0,4,0,6"/>
                        <ItemsControl ItemsSource="{Binding GaugeSkinSamples}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <!-- 이름표는 뺐다 — 닉네임 연출 카드와 같은 규칙이다. 스킨은 보고
                                             고르는 것이고, 아래 행 모형이 이미 그 스킨 자체를 보여 준다.
                                             계열만 남긴다: 그건 색과 모양만 봐서는 알 수 없는 정보다. -->
                                        <TextBlock Text="{Binding Kind}" FontFamily="Segoe UI" FontSize="10.5"
                                                   Margin="0,0,0,3" Foreground="{DynamicResource Skin.Accent}"/>
                                        <!-- 미터 행의 모형. 색 견본이 아니라 행인 이유는, 게이지가 딜 숫자를 읽는
                                             바탕이라 숫자가 실제로 올라가 있어야 과한지 아닌지가 드러나기 때문이다.
                                             미터의 진짜 행 템플릿은 OverlayWindow.xaml 안에 있어 그대로 쓰려면 미터
                                             렌더링을 건드려야 하므로(행 기하 때문에 두 번 회귀한 파일이다) 모형으로
                                             둔다. 대신 판단을 좌우하는 셋은 실물과 동일하다 — 브러시 인스턴스,
                                             채움 불투명도 0.3, 그리고 자기 색을 지키는 3px 레일. -->
                                        <Border Background="{DynamicResource Skin.RowBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                                BorderThickness="1" CornerRadius="6" Height="38" Padding="4,0">
                                            <Grid>
                                                <Grid Margin="4,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding BarRatio, Converter={StaticResource RatioToStar}}"/>
                                                        <ColumnDefinition Width="{Binding BarRest, Converter={StaticResource RatioToStar}}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 실제 미터와 **같은 렌더러**를 쓴다. 시안과 실물이 서로 다른
                                                         구현이면 다시 어긋난다. -->
                                                    <Grid Grid.Column="0" ClipToBounds="True">
                                                        <Border Background="{Binding Fill}" Opacity="{Binding GaugeOpacity}" CornerRadius="4"/>
                                                        <local:GaugeFxLayer SkinId="{Binding Id}" IsFxEnabled="True"
                                                                            ContentExclusionLeft="72" CornerRadius="4"/>
                                                    </Grid>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,8,2" VerticalAlignment="Stretch"
                                                            Background="{Binding RailBrush}" Opacity="0.95"/>
                                                    <Border Grid.Column="1" Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                                            BorderThickness="1" CornerRadius="4" MinWidth="22" Height="20" Padding="4,0"
                                                            Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Rank}" FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource Skin.MutedFg}"/>
                                                    </Border>
                                                    <Border Grid.Column="2" Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.IconRing}"
                                                            BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Image Source="{Binding IconSource}" Stretch="Uniform" Margin="2"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nickname}" FontSize="14" Foreground="{DynamicResource Skin.Fg}"/>
                                                        <TextBlock Text="{Binding ServerTag}" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Skin.MutedFg}"/>
                                                        <Border Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PowerText}" FontSize="10.5" Foreground="{DynamicResource Skin.MutedFg}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="4" Text="{Binding DpsText}" FontSize="14" Margin="0,0,8,0"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource Skin.Fg}"/>
                                                    <Border Grid.Column="5" Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                                            BorderThickness="1" CornerRadius="4" Padding="5,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PercentText}" FontSize="11.5" MinWidth="40" TextAlignment="Center"
                                                                   Foreground="{DynamicResource Skin.Fg}"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="닉네임 스킨 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="'색상만'은 움직임 없이 색만 남깁니다. 저사양 모드에서는 설정과 무관하게 꺼집니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding NameFxModes}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding NameFxMode}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14" IsEnabled="{Binding NameFxDetailEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="적용 대상" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="같은 전투에 있는 다른 사람의 스킨도 그 사람이 고른 대로 보입니다. 내 행만 보고 싶으면 '내 캐릭터만'을 고르세요." Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding NameFxScopes}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding NameFxScope}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14" IsEnabled="{Binding NameFxDetailEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="게이지 스킨 사용" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="받은 게이지 스킨을 DPS 막대에 씁니다. 끄면 기존 기여도·직업 색으로 돌아갑니다. 닉네임 옆 직업·본인 표시선은 그대로 유지돼요." Style="{StaticResource SettingDesc}"/>
                                <TextBlock Text="'미터 화면'의 게이지 형태가 '없음'이면 칠할 막대가 없어 적용되지 않습니다."
                                           Style="{StaticResource SettingDesc}" TextWrapping="Wrap"
                                           Visibility="{Binding GaugeSkinApplicable, Converter={StaticResource BoolToVisInverse}}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NameFxGauge}"
                                      IsEnabled="{Binding GaugeSkinApplicable}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14" IsEnabled="{Binding NameFxAnimated}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding NameFxSpeedPercent, StringFormat='애니메이션 속도 — {0}%'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="값이 클수록 색이 빠르게 흐릅니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="50" Maximum="200" Value="{Binding NameFxSpeedPercent}"
                                    TickFrequency="50" IsSnapToTickEnabled="True"/>
                        </Grid>

                        <Grid Margin="0,0,0,4" IsEnabled="{Binding NameFxDetailEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding NameFxBrightnessPercent, StringFormat='색상 밝기 — {0}%'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="어두운 테마에서 스킨이 튀면 낮춰 주세요. 게이지 스킨의 밝기도 함께 바뀝니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <!-- 커밋은 드래그가 끝날 때 한 번. 틱마다 하면 브러시 스톱을 전부 다시 계산하면서
                                 settings.properties 를 통째로 재기록한다. -->
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="70" Maximum="130" Value="{Binding NameFxBrightnessPercent}"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Thumb.DragCompleted="OnNameFxBrightnessCommitted"/>
                        </Grid>

                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="후원자 목록 갱신" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="{Binding NameFxStatus}" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="갱신" VerticalAlignment="Center" Padding="14,6" Click="OnRefreshNameFx"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== 창 동작 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=window}">
                        <TextBlock Text="표시 조건" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="아이온 활성화 시 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="AION2 창이 활성화된 동안에만 미터기를 표시합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsAutoHide}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14" IsEnabled="{Binding TaskbarModeEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="작업표시줄 / Alt+Tab 모드" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="오버레이를 일반 창으로 바꿔 작업표시줄·Alt+Tab에 표시합니다. (자동 숨김 해제)" Style="{StaticResource SettingDesc}"/>
                                <!-- 분리모드에선 이 설정이 가리키는 본체 창이 화면에 없다 — 켜면 눌러도 아무것도
                                     안 뜨는 항목만 생긴다. 게이지 형태·서버 표시와 같은 종류의 잠금이다. -->
                                <TextBlock Text="UI 분리모드에서는 쓸 수 없습니다 — 이 설정이 가리키는 본체 창이 화면에 없습니다."
                                           Style="{StaticResource SettingDesc}"
                                           Visibility="{Binding TaskbarModeEnabled, Converter={StaticResource BoolToVisInverse}}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TaskbarMode}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="미터를 숨겨도 오버레이 유지" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="미터기 본체를 숨겨도(Ctrl+H·트레이) 버프 오버레이와 스킬 쿨타임 오버레이는 계속 표시합니다. 게임이 활성일 때만 뜹니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KeepOverlayWhenMeterHidden}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="위치와 모니터" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="다중 모니터 이동" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="모니터 경계를 넘어 창 위치를 보정합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MultiMonitorMode}"/>
                        </Grid>
                        <TextBlock Text="드래그로 옮긴 창들을 기본 위치로 되돌립니다. &quot;미터기 위치&quot;는 UI 분리모드의 보스칸·미터 행 창까지 함께 데려옵니다." Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="미터기 위치" Click="OnResetMeterPosition" Margin="0,0,8,0"/>
                            <Button Content="파티 신청 위치" Click="OnResetJoinPosition" Margin="0,0,8,0"/>
                            <Button Content="전투 기록 위치" Click="OnResetHistoryPosition" Margin="0,0,8,0"/>
                            <Button Content="컨텐츠 관리 위치·크기" Click="OnResetAetherPosition"/>
                        </StackPanel>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="보조 패널" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="파티 신청 패널 자동 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="파티 신청이 오면 패널을 자동으로 띄웁니다. 끄면 헤더의 파티 신청 버튼으로 직접 열 수 있습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowJoinPanel}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="창 닫기" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="닫기 버튼 동작" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="X 버튼을 눌렀을 때 트레이로 보낼지 종료할지 선택합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding CloseActions}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding CloseAction}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== 버프 오버레이 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=buffs}">
                        <TextBlock Text="버프 오버레이" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="내 캐릭터에게 적용된 버프와 남은 시간을 별도 창에 표시합니다." Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BuffPresetBar}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="버프 오버레이 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="전투 보조 창을 켭니다. 창은 드래그로 옮길 수 있습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBuffUi}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="투명 배경" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="켜면 아이콘만 떠서 배경이 투명합니다. 끄면 배경/테두리가 보여 버프가 없을 때도 창 위치를 찾아 옮길 수 있습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BuffUiTransparent}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding BuffIconScalePercent, StringFormat='아이콘 크기 — {0}%'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="100%가 기본 크기입니다. 아이콘·테두리·남은시간 글씨가 함께 커집니다. 크게 키우면 창도 그만큼 넓어져 화면을 더 가립니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <!-- 눈금 5% = 정확히 2px 라 퍼센트↔px 왕복이 무손실이다. 최솟값을 80% 위로 올리지 말 것 —
                                 Slider 는 Value 를 [Minimum,Maximum] 으로 coerce 한 뒤 소스에 되쓰므로, 최솟값이 기존
                                 저장값을 넘으면 설정창을 여는 것만으로 사용자 값이 재기록된다. 드래그 종료 커밋
                                 (NameFxBrightnessPercent 처럼)은 쓰지 않는다 — 오버레이가 500ms 마다 이 값을 다시
                                 읽으므로 틱마다 커밋해야 드래그 중 실시간으로 크기가 보인다. -->
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="80" Maximum="200"
                                    Value="{Binding BuffIconScalePercent}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="지속시간 글씨 색상" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="남은 시간 글씨 색상을 바꿉니다. (투명 배경에서 흰색이 잘 안 보일 때 유용)" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <controls:ColorSwatchButton Grid.Column="1" Color="{Binding BuffTextColor, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="표시 순서" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="오버레이에 버프를 늘어놓는 기준입니다. '적용 순서'는 버프가 유지되는 동안 자리가 바뀌지 않아 가장 안정적이고, '남은 시간 순'은 타이머가 흐를 때마다 아이콘이 움직입니다. 아래 목록에서 '위치 고정'을 켠 버프는 이 기준과 무관하게 항상 버프 오버레이의 가장 앞쪽에 표시됩니다."
                                           Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center" SelectedIndex="{Binding BuffUiSortModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="적용 순서"/>
                                <ComboBoxItem Content="남은 시간 순"/>
                                <ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="쿨타임 중 아이콘 회색" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="버프를 거는 스킬이 쿨타임이면 오버레이 아이콘을 회색으로 흐리게 표시합니다. (재사용 가능 시점 확인용)" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BuffUiGrayOnCooldown}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="아이콘에 버프 레벨 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="버프 아이콘 오른쪽 아래에 그 버프의 스킬 레벨을 작게 표시합니다. 레벨 정보가 없는 버프(물약·주문서 등)에는 표시되지 않습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BuffUiShowLevel}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="다른 캐릭터가 준 버프 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="끄면 본인이 직접 받은 버프만 표시합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowOtherPlayerBuffs}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="음성" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock Text="아래 음성은 '알림' 탭의 '음성 알림 (한국어)'가 켜져 있을 때만 나옵니다."
                                   Style="{StaticResource SettingDesc}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="버프 시작 음성" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="'오버레이+음성' 버프가 켜지면 '스킬명 온'을 읽어줍니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BuffTtsOnStart}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="버프 종료 음성" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="'오버레이+음성' 버프가 끝나기 직전 '스킬명 오프'를 읽어줍니다. (음성 지연 고려해 살짝 먼저)" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BuffTtsOnEnd}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="버프 종료 3초 전 알림" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="끝나기 3초 전부터 오버레이 아이콘이 점멸합니다. '버프 종료 음성'도 켜져 있으면 '오프' 대신 '스킬명 오프 예정'을 3초 전에 읽어줍니다." Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BuffEndWarning3s}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="직업별 버프" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock Text="직업별로 각 버프를 오버레이/음성 중 어떻게 알릴지 고릅니다. (소비 아이템·물약은 제외)" Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                        <TextBlock Text="아직 표시된 버프가 없습니다. 전투를 진행하면 여기에 버프가 나타납니다."
                                   Foreground="{DynamicResource Skin.MutedFg}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding BuffPicker.IsEmpty, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding BuffPicker.Groups}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Skin.SoftBorder}" Padding="0,8,0,10" Margin="0,0,0,4">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Job}" FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource Skin.Accent}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="전체 끔" Padding="8,2" FontSize="11" Margin="0,0,4,0"
                                                            DataContext="{Binding}" Tag="g|0" Click="OnBuffGroupMode"/>
                                                    <Button Content="전체 오버레이" Padding="8,2" FontSize="11" Margin="0,0,4,0"
                                                            DataContext="{Binding}" Tag="g|1" Click="OnBuffGroupMode"/>
                                                    <Button Content="전체 음성" Padding="8,2" FontSize="11" Margin="0,0,4,0"
                                                            DataContext="{Binding}" Tag="g|2" Click="OnBuffGroupMode"/>
                                                    <Button Content="전체 음성만" Padding="8,2" FontSize="11"
                                                            DataContext="{Binding}" Tag="g|3" Click="OnBuffGroupMode"/>
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="5" Margin="0,0,9,0"
                                                                    Background="{DynamicResource Skin.RowBg}">
                                                                <Image Source="{Binding IconSource}" Width="24" Height="24"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Skin.Fg}" FontSize="12"/>
                                                            <!-- 맨 앞 고정 토글. 글리프만으로는 켜짐/꺼짐이 구분되지 않아(사용자 제보)
                                                                 라벨 + 켜짐 상태 강조(액센트 배경/테두리)를 함께 준다. 고정된 것끼리의
                                                                 순서 조정(▲▼)은 제거했다 — 이 목록이 고정 순서로 재정렬되지 않아 눌러도
                                                                 아무 변화가 보이지 않았고(순서는 오버레이에만 반영), '반응 없는 버튼'으로
                                                                 읽혔다. 고정된 버프가 맨 앞에 오는 동작 자체는 그대로다. -->
                                                            <CheckBox Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                      IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                                      ToolTip="켜면 표시 순서와 무관하게 버프 오버레이의 가장 앞쪽에 표시됩니다."
                                                                      DataContext="{Binding}" Click="OnBuffPinToggle">
                                                                <TextBlock Text="위치 고정" FontSize="11" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <!-- 기본 Foreground는 로컬 속성이 아니라 Setter로 준다 — 로컬 값은
                                                                             트리거보다 우선순위가 높아 강조가 먹지 않는다. -->
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Skin.MutedFg}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Skin.Accent}"/>
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </CheckBox>
                                                            <ComboBox Grid.Column="3" Width="128" SelectedIndex="{Binding Mode, Mode=TwoWay}" VerticalAlignment="Center">
                                                                <ComboBoxItem Content="알림끔"/>
                                                                <ComboBoxItem Content="오버레이만"/>
                                                                <ComboBoxItem Content="오버레이+음성"/>
                                                                <ComboBoxItem Content="음성만"/>
                                                            </ComboBox>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    <!-- ===== 스킬 쿨타임 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=cooldown}">
                        <TextBlock Text="스킬 쿨타임 오버레이" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="내 스킬의 재사용 대기시간을 별도 창에 표시합니다. 인식된 캐릭터의 직업 스킬이 미리 깔리고, 아직 정보가 없는 칸은 쓸 수 있음으로 표시됩니다." Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CooldownPresetBar}"
                                        Visibility="{Binding HasCooldownPresets, Converter={StaticResource BoolToVis}}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="쿨타임 오버레이 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="스킬 쿨타임 창을 켭니다. 버프 오버레이와 별개의 창이라 따로 옮겨 둘 수 있습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowCooldownUi}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="투명 배경" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="켜면 아이콘만 떠서 배경이 투명합니다. 끄면 배경/테두리가 보여 목록이 비어 있을 때도 창을 찾아 옮길 수 있습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CooldownUiTransparent}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding CooldownIconScalePercent, StringFormat='아이콘 크기 — {0}%'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="100%가 기본 크기입니다. 아이콘·남은시간 글씨가 함께 커집니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <!-- 버프 오버레이 슬라이더와 같은 규약: 눈금 5% = 정확히 2px 이고, 최솟값을 80% 위로
                                 올리면 Slider 가 coerce 한 값을 소스에 되써 설정창을 여는 것만으로 사용자 값이
                                 재기록된다. -->
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="80" Maximum="200"
                                    Value="{Binding CooldownIconScalePercent}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding CooldownUiPerRow, StringFormat='한 줄 최대 개수 — {0}개'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="이 개수를 넘으면 다음 줄로 넘어갑니다. 스킬이 많으면 줄여서 정사각형에 가깝게 두는 편이 읽기 좋습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="4" Maximum="16"
                                    Value="{Binding CooldownUiPerRow}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="남은시간 글씨 색상" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="아이콘 위에 겹쳐 나오는 남은 초의 색상입니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <controls:ColorSwatchButton Grid.Column="1" Color="{Binding CooldownTextColor, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="표시할 스킬" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="직업별 액티브 · 스티그마 스킬 중에서 고릅니다. 끈 스킬은 써도 창에 뜨지 않습니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <!-- BrandButton 은 배경을 TemplateBinding 으로 받는다 — 색을 안 주면 투명한 글자만
                                 남는다(다른 사용처도 전부 색을 명시한다). -->
                            <Button Grid.Column="1" Content="스킬 고르기" Click="OnOpenCooldownPicker" VerticalAlignment="Center"
                                    Height="30" MinWidth="96" FontSize="12" FontWeight="SemiBold"
                                    Background="{DynamicResource Skin.Accent}" Foreground="White"
                                    Style="{StaticResource BrandButton}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== 알림 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=alarms}">
                        <TextBlock Text="소리" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="알림 소리" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="알림이 뜰 때 짧은 효과음을 재생합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlarmSoundEnabled}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <!-- 이 바는 효과음뿐 아니라 음성 알림에도 걸린다(TtsSpeech 가 같은 값을 MediaPlayer.Volume 로
                                     쓴다). 설명이 "효과음의 크기" 였을 때는 음성이 크다고 느낀 사람이 여기를 볼 이유가 없었다. -->
                                <TextBlock Text="{Binding AlarmVolume, StringFormat='알림 음량 — {0:P0}'}" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="알림 효과음과 음성 알림(버프·스킬 알림 포함) 모두에 적용됩니다. 음성이 크게 들리면 여기서 줄여 주세요."
                                           Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="{Binding AlarmVolume}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="음성 알림 (한국어)" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="알림 내용을 한국어 음성으로 읽어줍니다. 인터넷이 필요하며, 실패하면 효과음으로 대체됩니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TtsEnabled}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="알림 음성" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="알림을 읽어줄 목소리입니다. 기본 제공 알림은 인터넷 없이 바로 재생됩니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding TtsVoices}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding TtsVoice}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <Button Content="소리 테스트" Click="OnTestAlarmSound" HorizontalAlignment="Left"
                                    Height="30" Padding="14,0" Cursor="Hand" Margin="0,0,8,0"/>
                            <Button Content="음성 테스트" Click="OnTestTts" HorizontalAlignment="Left"
                                    Height="30" Padding="14,0" Cursor="Hand"/>
                        </StackPanel>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="슈고 페스타 알림" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="슈고 페스타 알림" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="매시 정각 이벤트 전에 알림 토스트를 띄웁니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShugoAlarmEnabled}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="10분 전 알림" Style="{StaticResource SettingTitle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShugoLead10}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="5분 전 알림" Style="{StaticResource SettingTitle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShugoLead5}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="1분 전 알림" Style="{StaticResource SettingTitle}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShugoLead1}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="시작 알림" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="이벤트가 시작되는 정각에 알립니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShugoLeadStart}"/>
                        </Grid>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="필드보스 리젠 알림" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="필드보스 알림" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="필드보스 리젠 시각이 감지되면 리젠 전에 알려줍니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FieldBossAlarmEnabled}"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="알림 받을 보스 선택" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="원하는 필드보스만 알림을 받도록 선택합니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="보스 선택" MinWidth="92" Click="OnOpenFieldBossPicker" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="미리 알림" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox Content="5분 전" IsChecked="{Binding FieldBossLead5}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Content="10분 전" IsChecked="{Binding FieldBossLead10}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Content="30분 전" IsChecked="{Binding FieldBossLead30}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="전투 중 알림 숨김" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="미터에 전투가 기록되는 동안에는 필드보스 알림을 띄우지 않습니다. (전투 종료 후 시간이 남아있으면 표시)" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FieldBossAlarmMuteInCombat}"/>
                        </Grid>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="보스 그로기 알림" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="그로기 임박 알림" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="싸우고 있는 보스의 무력화 게이지가 20% 남으면 &quot;그로기 임박&quot;을 읽어줍니다. 게이지가 다시 차면 다음 번에 또 알려줍니다. (보스에 따라 게이지를 보내지 않는 전투가 있어 항상 울리지는 않습니다)" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding GroggyAlarmEnabled}"/>
                        </Grid>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="감시자 카이라 알림" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="출현 알림" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="어비스 하층의 감시자 카이라는 서버가 리젠 시각을 보내지 않습니다. 대신 한국 시각 0·4·8·12·16·20시 정각마다 반드시 출현하므로, 미리 가서 대기할 수 있도록 출현 전에 알려줍니다. (어디에 있든 울립니다)" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KairaAlarmEnabled}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="미리 알림" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox Content="10분 전" IsChecked="{Binding KairaLead10}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Content="5분 전" IsChecked="{Binding KairaLead5}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Content="1분 전" IsChecked="{Binding KairaLead1}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="커스텀 알람" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>

                        <!-- add form -->
                        <Border Background="{DynamicResource Skin.ControlBg}" BorderBrush="{DynamicResource Skin.ControlBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewAlarmTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32" Padding="8,4" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" Width="60" Height="32" ItemsSource="{Binding Hours}" SelectedItem="{Binding NewAlarmHour}" Margin="0,0,4,0"/>
                                    <ComboBox Grid.Column="2" Width="60" Height="32" ItemsSource="{Binding Minutes}" SelectedItem="{Binding NewAlarmMinute}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ToggleButton Content="일" Style="{StaticResource DayChip}" IsChecked="{Binding DaySun}"/>
                                    <ToggleButton Content="월" Style="{StaticResource DayChip}" IsChecked="{Binding DayMon}"/>
                                    <ToggleButton Content="화" Style="{StaticResource DayChip}" IsChecked="{Binding DayTue}"/>
                                    <ToggleButton Content="수" Style="{StaticResource DayChip}" IsChecked="{Binding DayWed}"/>
                                    <ToggleButton Content="목" Style="{StaticResource DayChip}" IsChecked="{Binding DayThu}"/>
                                    <ToggleButton Content="금" Style="{StaticResource DayChip}" IsChecked="{Binding DayFri}"/>
                                    <ToggleButton Content="토" Style="{StaticResource DayChip}" IsChecked="{Binding DaySat}"/>
                                </StackPanel>
                                <Grid>
                                    <TextBlock Text="요일 미선택 시 매일 알림" Style="{StaticResource SettingDesc}" VerticalAlignment="Center"/>
                                    <Button Content="추가" Click="OnAddCustomAlarm" HorizontalAlignment="Right" Height="28" Padding="16,0" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- list -->
                        <TextBlock Text="등록된 알람이 없습니다." Style="{StaticResource SettingDesc}" Margin="2,0,0,4"
                                   Visibility="{Binding HasCustomAlarms, Converter={StaticResource BoolToVisInverse}}"/>
                        <ItemsControl ItemsSource="{Binding CustomAlarmRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Skin.ControlBg}" BorderBrush="{DynamicResource Skin.ControlBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{DynamicResource Skin.Fg}"
                                                       FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Skin.Fg}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DaysText}" Foreground="{DynamicResource Skin.MutedFg}" FontSize="10"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Click="OnToggleCustomAlarm" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Grid.Column="3" Content="삭제" Click="OnDeleteCustomAlarm" Height="26" Padding="10,0" Cursor="Hand" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===== 전투 집계 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=battle}">
                        <TextBlock Text="집계 범위" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="전투 전 파티원 표시" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="던전 입장 시 전투가 시작되기 전에도 파티원을 미리 표시합니다. 첫 피해가 들어오면 자동으로 전투 화면으로 전환됩니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowPreCombatRoster}"/>
                        </Grid>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="허수아비 테스트" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,0,12"
                                   Text="훈련용 허수아비를 때려 DPS를 측정하는 별도 모드입니다. 헤더의 허수아비 버튼(스톱워치)으로도 켜고 끌 수 있고, 단축키는 '단축키' 탭에서 지정합니다."/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="허수 테스트" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="끄면 허수아비 타격이 전투로 잡히지 않습니다. 켜면 허수아비 타격을 전투로 집계합니다 (즉시 적용). 측정 결과는 전투 기록의 &apos;허수아비&apos; 탭에 남습니다."/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DummyTestMode}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="측정 시간" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="첫 타격부터 설정한 시간만큼만 집계하고 결과를 고정합니다. 5초 정도 손을 멈췄다가 다시 때리면 새 측정이 시작됩니다."/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="130" VerticalAlignment="Center" ItemsSource="{Binding DummyDurations}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding DummyDurationValue}"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="허수아비 DPS 초기화" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="빠른 재측정을 위해 허수아비 DPS만 즉시 비웁니다. 저장된 전투 기록·인식 캐릭터는 그대로 보존됩니다."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="초기화" MinWidth="90" VerticalAlignment="Center" Click="OnResetDummyDps"
                                    ToolTip="허수아비 DPS만 즉시 초기화 (전투 기록은 보존)"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="전투 리플레이 (베타)" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,0,10"
                                   Text="전투 중 파티원과 보스의 이동을 기록해, 던전 지도 위에서 되감아 볼 수 있습니다. 보스 기믹의 장판도 함께 표시됩니다."/>
                        <Border Background="{DynamicResource Skin.AccentSoft}" BorderBrush="{DynamicResource Skin.Accent}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Skin.Fg}"
                                       Text="⚠ 베타 기능입니다. 일부 던전이나 상황에서 위치가 비거나, 지도·장판이 어긋나게 표시될 수 있습니다. 특히 본인 위치는 패킷 제약상 스킬 시전 시점에만 정확하며, 그 사이 구간은 속 빈 링(마지막 위치)으로 표시됩니다. DPS 집계에는 영향을 주지 않습니다."/>
                        </Border>

                        <TextBlock Visibility="{Binding ReplayUnavailableVisibility}" Style="{StaticResource SettingDesc}"
                                   Margin="0,0,0,12" Foreground="{DynamicResource Skin.MutedFg}"
                                   Text="이 빌드에는 리플레이 모듈이 포함되어 있지 않아 사용할 수 없습니다."/>
                        <Grid Margin="0,0,0,14" IsEnabled="{Binding ReplayAvailable}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="리플레이 자동 저장" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="전투가 끝날 때마다 이동 기록을 저장합니다. 끄면 아무것도 기록하지 않습니다 (즉시 적용)."/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RecordReplay}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,0,8"
                                   Text="기록은 전투당 파일 하나(json)로 저장되며, 최근 것부터 일정 개수만 유지됩니다."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Click="OnPlayReplay" Margin="0,0,8,0" IsEnabled="{Binding ReplayAvailable}"
                                    ToolTip="리플레이 파일(.json)을 선택해 재생합니다">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 0,0 L 8,5 L 0,10 Z" Fill="{DynamicResource Skin.Accent}" Width="8" Height="10"
                                          Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                    <TextBlock Text="리플레이 재생" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="리플레이 폴더 열기" Click="OnOpenReplayFolder"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== 단축키 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=hotkeys}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="단축키" Style="{StaticResource SectionHeader}"/>
                            <!-- Hover help: modifier-less single-key hotkeys are allowed (kept by request) but are
                                 registered SYSTEM-WIDE, so a bare key like F11 fires in-game too and can silently
                                 hide the overlay. Warn instead of restricting. See
                                 overlay-autohide-unpark-on-return-rootcause. -->
                            <Border Width="18" Height="18" CornerRadius="9" Margin="8,0,0,10" VerticalAlignment="Center"
                                    Cursor="Help" Background="{DynamicResource Skin.AccentSoft}"
                                    BorderBrush="{DynamicResource Skin.Border}" BorderThickness="1"
                                    ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                <TextBlock Text="?" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Skin.Accent}"/>
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="340" Background="{DynamicResource Skin.PanelBg}"
                                             BorderBrush="{DynamicResource Skin.Border}">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Skin.Fg}">
                                            단축키에는 <Run FontWeight="Bold">Ctrl / Alt / Shift 중 하나 이상</Run>을 함께 지정하길 권장합니다.<LineBreak/><LineBreak/>
                                            수식키 없는 단일 키(예: F11)도 지정할 수 있지만, 이 경우 <Run FontWeight="Bold">시스템 전역</Run>으로 등록되어 게임·다른 프로그램에서 그 키를 눌러도 동작합니다. 예를 들어 '표시 / 숨김'을 F11로 두면 게임 중 F11을 누르는 순간 오버레이가 숨겨지고, 같은 키를 다시 누르거나 트레이 아이콘으로만 되돌릴 수 있습니다.<LineBreak/><LineBreak/>
                                            수식키를 함께 쓰면 이런 의도치 않은 동작을 막을 수 있습니다.
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="단일 키 또는 Ctrl/Alt 조합으로 지정할 수 있습니다. (수식키 없는 단일 키는 권장하지 않습니다 — ⓘ 참고)  각 항목 오른쪽의 지우기 버튼을 누르면 미지정(사용 안 함)으로 둘 수 있습니다." Style="{StaticResource SettingDesc}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="전투 초기화" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource HotkeyWarning}" Text="{Binding ResetHotkeyWarning}"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <local:HotkeyCaptureBox x:Name="ResetHotkeyBox" Grid.Column="0" Combo="{Binding PendingReset, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Style="{StaticResource HotkeyClearButton}"
                                        Click="OnClearHotkey" Tag="{Binding ElementName=ResetHotkeyBox}"/>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="표시 / 숨김" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource HotkeyWarning}" Text="{Binding VisibilityHotkeyWarning}"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <local:HotkeyCaptureBox x:Name="VisibilityHotkeyBox" Grid.Column="0" Combo="{Binding PendingVisibility, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Style="{StaticResource HotkeyClearButton}"
                                        Click="OnClearHotkey" Tag="{Binding ElementName=VisibilityHotkeyBox}"/>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="클릭 통과 / 잠금" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource HotkeyWarning}" Text="{Binding ClickThroughHotkeyWarning}"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <local:HotkeyCaptureBox x:Name="ClickThroughHotkeyBox" Grid.Column="0" Combo="{Binding PendingClickThrough, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Style="{StaticResource HotkeyClearButton}"
                                        Click="OnClearHotkey" Tag="{Binding ElementName=ClickThroughHotkeyBox}"/>
                            </Grid>
                        </Grid>
                        <!-- UI 분리모드. 기본 미지정 — 인게임 키와 겹칠 조합을 우리가 고르지 않는다
                             (RegisterHotKey 실패는 조용해서, 충돌하면 "눌러도 아무 일이 없다"만 남는다). -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="UI 분리모드 켜기/끄기" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource HotkeyWarning}" Text="{Binding SplitUiHotkeyWarning}"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <local:HotkeyCaptureBox x:Name="SplitUiHotkeyBox" Grid.Column="0" Combo="{Binding PendingSplitUi, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Style="{StaticResource HotkeyClearButton}"
                                        Click="OnClearHotkey" Tag="{Binding ElementName=SplitUiHotkeyBox}"/>
                            </Grid>
                        </Grid>
                        <!-- 컨텐츠 관리. 같은 이유로 기본 미지정 — 트레이 메뉴·오드 배지와 같은 창을 연다. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="컨텐츠 관리 열기/닫기" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource HotkeyWarning}" Text="{Binding AetherListHotkeyWarning}"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <local:HotkeyCaptureBox x:Name="AetherListHotkeyBox" Grid.Column="0" Combo="{Binding PendingAetherList, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Style="{StaticResource HotkeyClearButton}"
                                        Click="OnClearHotkey" Tag="{Binding ElementName=AetherListHotkeyBox}"/>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="허수아비 모드 켜기/끄기" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource HotkeyWarning}" Text="{Binding DummyToggleHotkeyWarning}"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <local:HotkeyCaptureBox x:Name="DummyToggleHotkeyBox" Grid.Column="0" Combo="{Binding PendingDummyToggle, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Style="{StaticResource HotkeyClearButton}"
                                        Click="OnClearHotkey" Tag="{Binding ElementName=DummyToggleHotkeyBox}"/>
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="허수아비 DPS 초기화" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource HotkeyWarning}" Text="{Binding DummyResetHotkeyWarning}"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <local:HotkeyCaptureBox x:Name="DummyResetHotkeyBox" Grid.Column="0" Combo="{Binding PendingDummyReset, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Style="{StaticResource HotkeyClearButton}"
                                        Click="OnClearHotkey" Tag="{Binding ElementName=DummyResetHotkeyBox}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- ===== 내 캐릭터 · 통계 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=stats}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="익명 통계 공개 설정" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource HelpDot}" Margin="8,0,0,10">
                                <TextBlock Style="{StaticResource HelpQ}"/>
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="420" Background="{DynamicResource Skin.PanelBg}" BorderBrush="{DynamicResource Skin.Border}">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Skin.Fg}">
                                            게임에서 측정한 보스 전투 기록을 <Run FontWeight="Bold">익명</Run>으로 통계 서버에 보낼지 설정합니다. 닉네임·서버는 식별 불가능한 해시로 처리됩니다.<LineBreak/><LineBreak/>
                                            <Run FontWeight="Bold">■ 스위치 3종</Run> (바꾼 뒤 <Run FontWeight="Bold">적용</Run>을 눌러야 반영)<LineBreak/>
                                            · 동의 — 통계 수집 기본 동의. 끄면 업로드·공개가 모두 중지됩니다.<LineBreak/>
                                            · 업로드 활성화 — 동의 상태에서 실제 전송을 켜고 끕니다 (내 PC에만 저장, 서버 전송 안 함).<LineBreak/>
                                            · 캐릭터 공개 — 통계 사이트에 내 캐릭터 공개 표시 여부 (끄면 익명 집계).<LineBreak/><LineBreak/>
                                            <Run FontWeight="Bold">■ 적용</Run> — 현재 스위치를 저장·전송(보내기). 동의 ON이면 동의 정보를 서버로 보내고, OFF면 내 PC에만 '거부'로 기록합니다. 전송 실패 시 상태가 sync_failed가 되고 업로드는 자동으로 꺼집니다.<LineBreak/><LineBreak/>
                                            <Run FontWeight="Bold">■ 서버 동기화</Run> — 서버에 저장된 내 동의 상태를 가져와 스위치를 맞춥니다(가져오기). 스위치를 바꾼 뒤 적용 없이 누르면 바뀐 내용이 서버 값으로 덮어써집니다.<LineBreak/><LineBreak/>
                                            <Run FontWeight="Bold">■ 상태 표시</Run> — &lt;상태&gt; · &lt;동기화&gt; 형식. accepted/declined=동의/거부, synced=서버 반영, local=내 PC에만, sync_failed=전송 실패, identity_missing=캐릭터 미접속.<LineBreak/><LineBreak/>
                                            <Run FontWeight="Bold">■ 업로드·대기·건너뜀·실패</Run> — 이번 실행의 집계. '건너뜀'은 보스 킬이 아니거나 중복이라 제외된 것으로 정상입니다.<LineBreak/><LineBreak/>
                                            <Run FontWeight="Bold">■ 내 캐릭터 통계 보기</Run> — 익명 식별값으로 내가 올린 전투 기록만 웹에서 봅니다(닉네임·서버 비공개). 미터기 재설치·다른 PC·예전 전투도 포함.<LineBreak/><LineBreak/>
                                            동의는 캐릭터별로 기억되며, 캐릭터가 접속해 있어야 설정할 수 있습니다.
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="익명 통계 업로드에 동의" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="캐릭터별로 동의가 기억됩니다." Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ConsentAccepted}" IsEnabled="{Binding CharacterDetected}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="업로드 활성화" Style="{StaticResource SettingTitle}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UploadEnabled}" IsEnabled="{Binding CharacterDetected}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="캐릭터 공개" Style="{StaticResource SettingTitle}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PublicCharacter}" IsEnabled="{Binding CharacterDetected}"/>
                        </Grid>
                        <TextBlock Text="캐릭터 접속 후 동의할 수 있어요" Foreground="#FFCC8800" FontSize="11"
                                   Visibility="{Binding CharacterDetected, Converter={StaticResource BoolToVisInverse}, FallbackValue=Collapsed}"/>
                        <TextBlock Text="{Binding ConsentStatus}" Style="{StaticResource SettingDesc}" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="적용" Click="OnApplyConsent" Margin="0,0,8,0"/>
                            <Button Content="서버 동기화" Click="OnRefreshConsent"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UploadStatus}" Style="{StaticResource SettingDesc}" Margin="0,8,0,0"/>

                        <!-- 지금 캐릭터의 전투가 왜 안 올라가는지. 업로드 여부는 캐릭터별인데 그 사실이 화면 어디에도
                             없어서, 한 캐릭터만 막혀 있으면 통계에서 조용히 빠지고 공개 전환·스킨 선택까지 같이 잠겼다. -->
                        <TextBlock Text="{Binding UploadBlockNotice}" TextWrapping="Wrap" Foreground="#FFCC8800" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding HasUploadBlockNotice, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="내 캐릭터 관리" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <TextBlock Text="익명 통계에 동의한 내 캐릭터들의 공개 여부를 바꾸거나 동의를 철회할 수 있습니다. (철회하면 이후 업로드가 중단되고, 이 목록에서도 제거됩니다. 다시 동의하면 다시 나타납니다.)"
                                   Style="{StaticResource SettingDesc}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding ConsentCharacters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Skin.PanelBg}" BorderBrush="{DynamicResource Skin.Border}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold"/>
                                                    <Border Background="{DynamicResource Skin.AccentSoft}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center" Visibility="{Binding CurrentBadgeVisibility}">
                                                        <TextBlock Text="현재 접속" FontSize="10" Foreground="{DynamicResource Skin.Accent}"/>
                                                    </Border>
                                                    <!-- 오드 chip — matches the meter footer badge; last-seen per character. -->
                                                    <Border Background="{DynamicResource Skin.StatBg}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center" Visibility="{Binding AetherVisibility}" ToolTip="오드 (마지막으로 확인된 값)">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="pack://application:,,,/WaffleMeter.App.Wpf;component/Icons/ode.png"
                                                                   Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="{Binding AetherText}" Foreground="#7EE7FF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubLabel}" Style="{StaticResource SettingDesc}"/>
                                                <!-- 공개 자동 적용 실패: 서버는 비공개인데 사용자는 켠 적이 있는 상태.
                                                     재시도 버튼은 없다 — 옆의 공개 토글이 그대로 재시도 경로다. -->
                                                <TextBlock Text="⚠ 공개 자동 적용에 실패했어요. 공개를 다시 켜 주세요."
                                                           Foreground="#FFB454" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding PublicApplyFailedVisibility}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="공개" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource Skin.MutedFg}"/>
                                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center"
                                                          IsChecked="{Binding IsPublic, Mode=OneWay}" IsEnabled="{Binding CanSetPublic}"
                                                          ToolTip="{Binding PublicToggleTooltip}" ToolTipService.ShowOnDisabled="True"
                                                          Click="OnToggleCharacterPublic"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="동의 철회" Click="OnRevokeCharacter" IsEnabled="{Binding CanRevoke}" VerticalAlignment="Center"
                                                    ToolTip="철회하면 이후 이 캐릭터의 통계 업로드가 중단되고, 이 목록에서 제거됩니다 (다시 동의하면 다시 나타납니다)."/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="아직 동의한 캐릭터가 없습니다." Style="{StaticResource SettingDesc}"
                                   Visibility="{Binding HasConsentCharacters, Converter={StaticResource BoolToVisInverse}, FallbackValue=Visible}"/>
                        <TextBlock Text="{Binding ConsentNotice}" TextWrapping="Wrap" Foreground="#FFCC8800" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding HasConsentNotice, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="내 전투 기록" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <Button Content="내 캐릭터 통계 보기" Click="OnOpenMyStats" IsEnabled="{Binding CharacterDetected}" HorizontalAlignment="Left"/>
                        <TextBlock Text="캐릭터가 접속해 있어야 열 수 있어요" Style="{StaticResource SettingDesc}" Margin="0,4,0,0"
                                   Visibility="{Binding CharacterDetected, Converter={StaticResource BoolToVisInverse}, FallbackValue=Collapsed}"/>

                    </StackPanel>

                    <!-- ===== 내 스탯 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=mystats}">
                        <TextBlock Text="내 스탯" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="게임이 보내 주는 캐릭터 스탯을 그대로 읽습니다. 스탯 계산기에 하나씩 옮겨 적을 필요 없이 값을 그대로 넘길 수 있어요."/>

                        <!-- 상태 + 두 동작을 한 카드에 모은다. 종전에는 안내문·상태·버튼·주의문이 전부 같은
                             굵기로 세로로 늘어서 어디부터 읽어야 할지가 없었다. -->
                        <Border Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding StatSheetStatus}" Style="{StaticResource SettingTitle}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="계산기 열기" Click="OnOpenCalculator" IsEnabled="{Binding HasStatSheet}"
                                            MinWidth="120" Margin="0,0,8,0"/>
                                    <Button Content="내 스탯 복사" Click="OnCopyStatSheet" IsEnabled="{Binding HasStatSheet}"
                                            MinWidth="120"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 자동으로 못 채우는 칸. 사용자가 "왜 비어 있지"를 묻기 전에 답해 둔다. -->
                        <Border Background="#22FF9800" BorderBrush="#55FF9800" BorderThickness="1" CornerRadius="6"
                                Padding="12,10" Margin="0,0,0,14"
                                Visibility="{Binding HasStatSheet, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="계산기에서 직접 채우셔야 하는 칸" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="{Binding StatSheetUnfilled}" Style="{StaticResource SettingDesc}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="이 두 칸은 게임이 보내 주지 않습니다. 장비 해제 공격력은 장비를 벗어야 나오고, 장비 돌파 레벨은 아예 전송되지 않습니다."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="읽어 온 스탯" Style="{StaticResource SectionHeader}" Margin="0,4,0,4"
                                   Visibility="{Binding HasStatSheet, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Visibility="{Binding HasStatSheet, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                   Text="맨 위 네 값은 인게임 스탯창에 뜨는 숫자입니다. 게임은 이 합계를 보내지 않고 항목만 보내 주기 때문에 미터가 합쳐서 보여 드립니다. 스탯창과 다른 값이 있으면 디스코드로 알려 주세요. 그 아래 '명중(컷 기준)'은 스탯창에 없는 항목으로, 명중 + PvE 명중 + 막기 관통을 더한 값입니다 — 통계 사이트의 명중컷과 같은 기준이라 그 숫자와 바로 비교하시면 됩니다. 버프를 받은 값이라 마을과 전투 중이 다릅니다."/>

                        <ItemsControl ItemsSource="{Binding StatGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource Skin.MutedFg}" Margin="2,0,0,6"/>
                                        <!-- 2열 격자. 인게임 스탯창이 2열이라 눈으로 대조하기 쉽다. -->
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Skin.RowBg}" CornerRadius="4"
                                                            Padding="10,5" Margin="0,0,6,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                                       Foreground="{DynamicResource Skin.MutedFg}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                                       FontWeight="SemiBold" Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource Skin.Fg}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===== 게임 최적화 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=gameopt}">
                        <TextBlock Text="게임 최적화" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="아이온2 Engine.ini에 렉 감소 최적화(텍스처 스트리밍 풀 · 스레드 lag · 오클루전 · GC 튜닝)를 자동으로 추가합니다. 그래픽카드 VRAM을 자동 감지해 프로필을 정하며, 인게임 그래픽 옵션과 화질에는 영향이 없습니다."/>

                        <Border Background="#33FF9800" BorderBrush="#66FF9800" BorderThickness="1" CornerRadius="4"
                                Padding="10,8" Margin="0,0,0,14"
                                Visibility="{Binding GameRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Skin.Fg}"
                                       Text="주의: 아이온2가 실행 중입니다. Engine.ini는 게임을 완전히 종료한 상태에서 적용/되돌리기 하세요. 실행 중 변경은 게임 종료 시 덮어써질 수 있습니다."/>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="그래픽카드 (자동 감지)" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="{Binding GpuText}" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="적용 프로필" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="{Binding GameOptTierText}" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SectionDivider}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                            <Button Content="적용" MinWidth="96" Click="OnApplyGameOpt" Margin="0,0,8,0"
                                    ToolTip="감지된 프로필로 Engine.ini에 최적화 블록을 추가/갱신합니다"/>
                            <Button Content="되돌리기" MinWidth="96" Click="OnRevertGameOpt"
                                    ToolTip="우리가 추가한 최적화 블록만 제거합니다 (다른 설정은 그대로)"/>
                            <TextBlock Text="{Binding GameOptStatus}" Style="{StaticResource SettingDesc}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="안내: 변경 사항은 게임을 재실행한 뒤부터 적용됩니다. 되돌리기는 우리가 추가한 구간만 지우므로 사용자가 직접 넣은 다른 Engine.ini 설정은 그대로 유지됩니다."/>
                    </StackPanel>

                    <!-- ===== 고급 · 진단 ===== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource NavVis}, ConverterParameter=advanced}">
                        <TextBlock Text="설정 백업 · 공유" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="설정을 짧은 코드로 뽑아 다른 PC 로 옮기거나 남에게 넘길 수 있습니다. 코드를 만들면 클립보드에 자동으로 복사됩니다."/>
                        <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="⚠ 계정·캐릭터 정보(동의 상태, 설치 키), 창 위치·크기, 캡처 설정은 코드에 담기지 않습니다. 남에게 코드를 줘도 내 캐릭터 정보는 넘어가지 않아요."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="전체 설정 복사" Click="OnExportFull" Margin="0,0,8,0"
                                    ToolTip="새 PC 나 PC방에서 지금 세팅을 그대로 복구할 때"/>
                            <Button Content="디자인만 복사" Click="OnExportDesign" Margin="0,0,8,0"
                                    ToolTip="외형만 — 색·글꼴·크기·게이지. 남에게 보여줄 때"/>
                            <Button Content="알림만 복사" Click="OnExportAlarms" Margin="0,0,8,0"
                                    ToolTip="슈고·필드보스·카이라·커스텀 알람과 소리"/>
                            <Button Content="파일로 저장" Click="OnSaveCodeToFile" Margin="0,0,8,0"
                                    ToolTip="코드가 채팅 글자수 제한보다 길 때 — 파일로 넘기면 잘리지 않습니다"/>
                            <Button Content="백업 폴더 열기" Click="OnOpenBackupFolder"/>
                        </StackPanel>

                        <!-- 클립보드 쓰기는 다른 앱이 잡고 있으면 실패한다. 코드를 항상 눈에 보이게 둬서
                             그 경우에도 직접 복사할 수 있게 한다. -->
                        <TextBox Text="{Binding LastExportedCode, Mode=OneWay}" IsReadOnly="True" Height="52"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="코드 가져오기" Style="{StaticResource SettingTitle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" Height="52"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                 VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="클립보드에서 붙여넣기" Click="OnPasteImport" Margin="0,0,8,0"/>
                            <Button Content="무엇이 바뀌는지 보기" Click="OnPreviewImport" Margin="0,0,8,0"/>
                            <Button Content="파일에서 불러오기" Click="OnLoadCodeFromFile" Margin="0,0,8,0"/>
                            <Button Content="되돌리기" Click="OnUndoImport"
                                    Visibility="{Binding UndoVisibility}"
                                    ToolTip="가장 최근 가져오기 직전 설정으로 되돌립니다"/>
                        </StackPanel>

                        <!-- 적용 전에 무엇이 바뀌는지를 항목으로 보여준다. 되돌리기가 있어도, 무엇을 되돌려야
                             하는지 모르는 상태로 누르게 하면 안 된다. -->
                        <Border Visibility="{Binding ImportPreviewVisibility}" Margin="0,0,0,8"
                                Background="{DynamicResource Skin.StatBg}" BorderBrush="{DynamicResource Skin.SoftBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{Binding ImportSummary}" Style="{StaticResource SettingDesc}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding ImportChanges}" MaxHeight="150">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="11.5" Foreground="{DynamicResource Skin.Fg}"
                                                           Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource Skin.MutedFg}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding From, Mode=OneWay}"/><Run Text="  →  "/><Run Text="{Binding To, Mode=OneWay}" Foreground="{DynamicResource Skin.Accent}"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding CombatBlockNotice}" Visibility="{Binding CombatBlockVisibility}"
                                           Style="{StaticResource SettingDesc}" Margin="0,6,0,0"/>
                                <Button Content="적용" Click="OnApplyImport" HorizontalAlignment="Right" MinWidth="90"
                                        Margin="0,8,0,0" IsEnabled="{Binding CanApplyImport}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding BundleStatus}" Style="{StaticResource SettingDesc}"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>

                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="캡처 방식" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="패킷 캡처 백엔드" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="WinDivert가 막히면 Npcap으로 전환할 수 있습니다. (재시작 후 적용)" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding CaptureBackends}"
                                      ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValuePath="Value" SelectedValue="{Binding CaptureBackend}"/>
                        </Grid>
                        <!-- 서버 IP/포트는 자동 감지되며 사용자가 직접 설정할 일이 없어 UI에서 숨김
                             (값/저장 경로는 SettingsViewModel.ServerIp/Port/SaveServer에 그대로 보존). -->
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="렌더링 / 호환성" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="FreeSync / G-Sync 호환 모드" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="가변 주사율 디스플레이에서 오버레이가 화면 끊김을 일으키지 않도록 소프트웨어 렌더링을 사용합니다 (권장). 끄면 GPU 렌더링을 시도합니다. (재시작 후 적용)" Style="{StaticResource SettingDesc}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VrrCompatMode}"/>
                        </Grid>
                        <Border Style="{StaticResource SectionDivider}"/>
                        <TextBlock Text="진단 — 패킷 로깅" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock Text="전투를 기록해 재생 가능한 코퍼스(packet-debug-logs)를 남깁니다. 진단/검증용이며, 켜두면 디스크에 계속 기록됩니다."
                                   Style="{StaticResource SettingDesc}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Button Content="{Binding LoggingButtonLabel}" Width="110" Click="OnToggleLogging" Margin="0,0,8,0"/>
                            <Button Content="로그 폴더 열기" Click="OnOpenLogFolder"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LoggingStatus}" Style="{StaticResource SettingDesc}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- footer -->
        <Grid Grid.Row="1" Margin="20,10,16,14">
            <!-- 왼쪽: 버전 + Discord(브랜드 색 그대로 채운 버튼). 통계 웹은 좌측 탭 줄로, 후원은 아래 배너 줄로
                 옮겼다 — 저장/취소와 같은 줄에 링크가 셋이나 있으면 무엇이 '설정을 바꾸는 버튼'인지 흐려진다. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding Version, StringFormat='waffle_meter v{0}'}" Foreground="{DynamicResource Skin.MutedFg}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Height="32" Cursor="Hand" Click="OnOpenDiscord" Style="{StaticResource BrandButton}"
                        ToolTip="버그 제보와 문의를 받는 공식 디스코드입니다."
                        Background="#FF5865F2" Foreground="White" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Margin="14,0">
                        <!-- 디스코드 마크(공식 SVG에서 그대로 가져온 경로). 버튼 바탕이 이미 브랜드 색이라
                             원본의 파란 원은 빼고 흰 마크만 얹는다. WPF Geometry.Parse로 파싱 검증 완료. -->
                        <Path Data="M689.43 349a422.21 422.21 0 0 0-104.22-32.32 1.58 1.58 0 0 0-1.68.79 294.11 294.11 0 0 0-13 26.66 389.78 389.78 0 0 0-117.05 0 269.75 269.75 0 0 0-13.18-26.66 1.64 1.64 0 0 0-1.68-.79A421 421 0 0 0 334.44 349a1.49 1.49 0 0 0-.69.59c-66.37 99.17-84.55 195.9-75.63 291.41a1.76 1.76 0 0 0 .67 1.2 424.58 424.58 0 0 0 127.85 64.63 1.66 1.66 0 0 0 1.8-.59 303.45 303.45 0 0 0 26.15-42.54 1.62 1.62 0 0 0-.89-2.25 279.6 279.6 0 0 1-39.94-19 1.64 1.64 0 0 1-.16-2.72c2.68-2 5.37-4.1 7.93-6.22a1.58 1.58 0 0 1 1.65-.22c83.79 38.26 174.51 38.26 257.31 0a1.58 1.58 0 0 1 1.68.2c2.56 2.11 5.25 4.23 8 6.24a1.64 1.64 0 0 1-.14 2.72 262.37 262.37 0 0 1-40 19 1.63 1.63 0 0 0-.87 2.28 340.72 340.72 0 0 0 26.13 42.52 1.62 1.62 0 0 0 1.8.61 423.17 423.17 0 0 0 128-64.63 1.64 1.64 0 0 0 .67-1.18c10.68-110.44-17.88-206.38-75.7-291.42a1.3 1.3 0 0 0-.63-.63zM427.09 582.85c-25.23 0-46-23.16-46-51.6s20.38-51.6 46-51.6c25.83 0 46.42 23.36 46 51.6.02 28.44-20.37 51.6-46 51.6zm170.13 0c-25.23 0-46-23.16-46-51.6s20.38-51.6 46-51.6c25.83 0 46.42 23.36 46 51.6.01 28.44-20.17 51.6-46 51.6z"
                              Fill="White" Stretch="Uniform" Width="18" Height="14"
                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Discord" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="기본값 복원" Click="OnResetDefaults" Margin="0,0,8,0"
                        ToolTip="'미터 화면'의 표시 설정과 '색상 · 스킨'을 기본값으로 되돌립니다. 알림·버프·단축키는 그대로 둡니다."/>
                <Button Content="취소" Width="80" Click="OnCancel" Margin="0,0,8,0"/>
                <Button Content="저장" Width="80" Click="OnSave"/>
            </StackPanel>
        </Grid>

        <!-- 후원 배너. 저장/취소와 같은 줄에 두면 '설정을 바꾸는 버튼'과 섞여 보이므로 창 맨 아래에 가로로
             한 줄을 따로 뒀다. 배너를 눌러도 바로 후원 페이지로 가지 않는다 — 안내창을 먼저 띄워 무엇에
             쓰이는지와 "후원 없이도 전 기능을 쓸 수 있다"를 읽고 나서 결정하게 한다. -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Skin.SoftBorder}"
                Background="#0FF59E0B" Padding="20,12,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Center"
                        Background="#1FF59E0B" BorderBrush="#38F59E0B" BorderThickness="1">
                    <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FFFCD34D"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="개발자 와플 사주기" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Skin.Fg}"/>
                    <TextBlock Text="와플 미터 유지와 더 안정적인 배포를 응원할 수 있습니다. 후원은 선택이며, 하지 않아도 모든 기능을 그대로 쓸 수 있습니다."
                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Skin.MutedFg}"/>
                </StackPanel>
                <Button Grid.Column="2" Height="32" MinWidth="112" VerticalAlignment="Center" Click="OnOpenDonate"
                        Style="{StaticResource BrandButton}" Background="#FFF59E0B" Foreground="#FF3B2600">
                    <TextBlock Text="와플 사주기" FontSize="12.5" FontWeight="SemiBold" Margin="12,0"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
