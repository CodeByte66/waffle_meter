<local:OverlayPanelWindow x:Class="WaffleMeter.App.Wpf.BuffOverlayPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaffleMeter.App.Wpf"
        Title="전투 보조"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Width="Auto" Left="60" Top="200" FontFamily="Segoe UI">
    <local:OverlayPanelWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </local:OverlayPanelWindow.Resources>
    <!-- Background is transparent by default (just floating icons); the "투명 배경" setting turns on a panel
         background + border + placeholder so the window can be found and dragged when empty. The Border is
         hit-testable (Transparent, not null) so a drag can start anywhere on the overlay. -->
    <Border Background="{Binding PanelBackground}" BorderBrush="{Binding PanelBorderBrush}"
            BorderThickness="{Binding PanelBorderThickness}" CornerRadius="8" MouseLeftButtonDown="OnDragHandle" Padding="2">
      <Grid Background="Transparent" MinWidth="60" MinHeight="20">
        <TextBlock Text="버프 오버레이 (드래그해서 이동)" Foreground="#CCFFFFFF" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Margin="8,4" Visibility="{Binding EmptyVisibility}">
            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
                <!-- WrapPanel 은 창의 MaxWidth 가 있어야만 줄을 바꾼다(BuffOverlayPanel.FitMaxWidthToScreen 이
                     매긴다). 상한이 없으면 SizeToContent 가 무한 폭으로 측정해 절대 줄바꿈하지 않고, 그러면
                     WPF 가 작업영역 폭에서 측정을 잘라 넘친 슬롯을 줄바꿈도 스크롤도 없이 버린다 — 로그에
                     흔적이 안 남는 무음 소실이다. MaxWidth 와 WrapPanel 은 반드시 짝으로 간다. -->
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel ToolTip="{Binding Name}">
                        <StackPanel.LayoutTransform>
                            <!-- Uniform icon-size scale (from the 버프 알림 size setting), applied to the whole slot. -->
                            <ScaleTransform ScaleX="{Binding DataContext.IconScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            ScaleY="{Binding DataContext.IconScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </StackPanel.LayoutTransform>
                        <!-- 슬롯 간격은 여기(LayoutTransform 안쪽)에 둔다. StackPanel 의 Margin 은 변환 바깥이라
                             배율을 따라가지 않아, 200%에서 아이콘만 커지고 간격은 그대로라 붙어 보였다. -->
                        <Grid Width="46" Height="46" Margin="3,0" HorizontalAlignment="Center">
                            <!-- Circular skill icon, clipped so the cooldown ring frames it cleanly (no overlap).
                                 Dimmed (IconOpacity) while the granting skill is on cooldown.
                                 원본 에셋이 48x48 이라 200%(80 DIP, 150% DPI면 120px)에서는 확대가 된다 —
                                 보간을 HighQuality(Fant)로 지정한다. 다른 오버레이 아이콘들도 모두 이 설정이다. -->
                            <Image Source="{Binding IconSource}" Width="40" Height="40" Opacity="{Binding IconOpacity}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.Clip><EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/></Image.Clip>
                            </Image>
                            <!-- Cooldown gray veil: a translucent gray disc over the icon while the skill is on
                                 cooldown (the "쿨타임 회색" option), so it reads as not-yet-recastable. -->
                            <Ellipse Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="#99424242" Visibility="{Binding CooldownVeil}"/>
                            <!-- 종료 임박 점멸 마스크: 아이콘을 그대로 두고 그 위에서 어두운 원이 켜졌다 꺼진다.
                                 칠하는 브러시는 BuffExpiryFlash 가 공유로 들고 220ms 마다 알파를 뒤집는다 —
                                 슬롯마다 애니메이션을 두지 않으므로 위상이 전부 일치하고, 임박한 게 없으면
                                 타이머 자체가 멈춘다. 쿨타임 회색 베일보다 위에 둬서 둘이 겹쳐도 점멸이 읽힌다. -->
                            <Ellipse Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{x:Static local:BuffExpiryFlash.Mask}" Visibility="{Binding ExpiryVisibility}"/>
                            <!-- Faint full-circle track so the icon always reads as framed. -->
                            <Ellipse Width="43" Height="43" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Stroke="#40000000" StrokeThickness="2.5"/>
                            <!-- Cooldown/duration ring: a bright arc that frames the icon and sweeps toward nothing as
                                 the buff runs out, so the border "disappears" as the timer drops. Fixed 46x46 canvas
                                 with absolute coords keeps the shrinking arc centered. -->
                            <Path Data="{Binding Ring}" Stroke="#FFE9B54A" StrokeThickness="2.5" Width="46" Height="46"
                                  Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <!-- 스킬 레벨 배지(우하단). 원형 아이콘의 오른쪽 아래 여백에 얹히므로 아이콘 그림을
                                 거의 가리지 않는다. 어두운 알약 배경 + 흰 글씨라 밝은 아이콘 위에서도 읽힌다.
                                 레벨을 모르면(0) VM 이 통째로 Collapsed 로 접는다 — "0"을 그리지 않는다.
                                 ⚠️ 링보다 z-order 가 <b>위</b>다. 반대로 두면 남은시간 호가 숫자를 가로질러
                                 레벨을 읽을 수 없다(실사용 확인). 링과 배지는 4~5시 방향에서 반드시 겹치는데
                                 — 배지 모서리가 반지름 21.5 원을 지난다 — 둘 중 하나는 잘린다. 배지가 이기는
                                 이유는 남은 시간이 아이콘 아래 <b>숫자로도</b> 나오기 때문이다. 호가 잠깐
                                 끊기면 중복 정보가 하나 줄 뿐이지만, 레벨은 여기 말고 볼 곳이 없다.
                                 배지는 슬롯 Grid 안에 있으므로 아이콘 크기 배율(LayoutTransform)을 함께 탄다. -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                    Background="#D9000000" CornerRadius="6" Padding="3,0" MinWidth="14"
                                    Visibility="{Binding LevelVisibility}">
                                <TextBlock Text="{Binding LevelText}" Foreground="White" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </Border>
                            <!-- accent dot when a party member applied the buff -->
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                     Fill="{DynamicResource Skin.Accent}" Visibility="{Binding ByOther, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <!-- 아래쪽 2px = WrapPanel 이 줄을 바꿨을 때 윗줄 글씨와 아랫줄 아이콘 사이의 간격.
                             슬롯의 마지막 자식이라 배율을 따라간다 — 바깥 StackPanel 에 주면 LayoutTransform
                             밖이라 200%에서도 2px 그대로다. -->
                        <TextBlock Text="{Binding RemainingText}"
                                   Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,1,0,2">
                            <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.95"/></TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
</local:OverlayPanelWindow>
